---
import Layout from '../../../layouts/Layout.astro';
import hashtagData from '../../../data/trending-hashtags.json';

const categories = hashtagData.categories || [];
const topics = categories.flatMap((category) =>
  (category.topics || []).map((topic) => ({
    ...topic,
    categoryId: category.id,
    categoryName: category.name,
    categoryIcon: category.icon || '',
    searchText: [
      category.name,
      topic.title,
      topic.description,
      ...(topic.hashtags || []).map((item) => item.tag)
    ].join(' ').toLowerCase()
  }))
);

const totalTopics = topics.length;
const totalHashtags = topics.reduce(
  (total, topic) => total + ((topic.hashtags || []).length),
  0
);

function formatPostCount(count) {
  if (typeof count !== 'number' || !Number.isFinite(count)) return '';
  if (count >= 1_000_000_000) return (count / 1_000_000_000).toFixed(1).replace('.0', '') + 'B';
  if (count >= 1_000_000) return (count / 1_000_000).toFixed(1).replace('.0', '') + 'M';
  if (count >= 1_000) return (count / 1_000).toFixed(1).replace('.0', '') + 'K';
  return count.toLocaleString('en-IN');
}
---

<Layout
  title="Trending Instagram Hashtags — Hashtag Sets for Reels & Creators | Create With Soumay"
  description="Find curated Instagram hashtag sets for Reels, fashion, beauty, AI, travel, food, festivals, relationships, memes and more. Search by topic and copy relevant hashtags with Create With Soumay."
  active="Creator Hub"
>

<section class="hero hashtag-hero">
  <div class="container">
    <div class="eyebrow">Creator tool · Instagram hashtags</div>

    <h1>
      Trending
      <span class="gradient-text">Hashtags</span>
    </h1>

    <p class="hero-copy">
      Find relevant hashtag sets by topic, search the library, and copy
      a complete set in one click.
    </p>

    <div class="hashtag-search">
      <label class="sr-only" for="hashtag-search-input">Search hashtags and topics</label>
      <input
        id="hashtag-search-input"
        type="search"
        placeholder="Search love, fashion, AI, travel, Diwali..."
        autocomplete="off"
      />
      <button class="primary" id="hashtag-search-button" type="button">Search</button>
    </div>

    <div class="hashtag-stats" aria-label="Hashtag library statistics">
      <div><strong>{categories.length}</strong><span>Categories</span></div>
      <div><strong>{totalTopics}</strong><span>Topic sets</span></div>
      <div><strong>{totalHashtags}+</strong><span>Hashtags</span></div>
      <div><strong>Free</strong><span>To use</span></div>
    </div>
  </div>
</section>

<section class="section hashtag-library" id="hashtag-library">
  <div class="container">
    <div class="section-heading hashtag-heading">
      <div>
        <div class="eyebrow">Hashtag library</div>
        <h2>Find the right set for your post.</h2>
      </div>
      <p id="hashtag-results" class="results-note" aria-live="polite"></p>
    </div>

    <div class="hashtag-toolbar">
      <div class="hashtag-filters" role="group" aria-label="Filter hashtag topics">
        <button class="small-btn active-filter" type="button" data-filter="all">All</button>
        <button class="small-btn" type="button" data-filter="trending">Trending</button>
        <button class="small-btn" type="button" data-filter="seasonal">Seasonal</button>
      </div>

      <label class="sort-control">
        <span>Sort</span>
        <select id="hashtag-sort" aria-label="Sort hashtag topics">
          <option value="featured">Featured</option>
          <option value="az">A–Z</option>
        </select>
      </label>
    </div>

    <div class="hashtag-categories" role="group" aria-label="Hashtag categories">
      <button class="category-chip active" type="button" data-category="all">All topics</button>
      {categories.map((category) => (
        <button
          class="category-chip"
          type="button"
          data-category={category.id}
        >
          <span aria-hidden="true">{category.icon}</span>
          {category.name}
        </button>
      ))}
    </div>

    <div class="hashtag-grid" id="hashtag-grid">
      {topics.map((topic, index) => (
        <article
          class="hashtag-topic"
          data-category={topic.categoryId}
          data-category-name={topic.categoryName}
          data-title={topic.title}
          data-description={topic.description}
          data-trending={String(topic.trending === true)}
          data-seasonal={String(topic.seasonal === true)}
          data-index={index}
          data-search={topic.searchText}
        >
          <div class="hashtag-topic-top">
            <div>
              <span class="hashtag-category-label">
                <span aria-hidden="true">{topic.categoryIcon}</span>
                {topic.categoryName}
              </span>
              <h3>{topic.title}</h3>
            </div>

            <div class="hashtag-badges">
              {topic.trending === true && <span class="hashtag-badge">Trending</span>}
              {topic.seasonal === true && <span class="hashtag-badge">Seasonal</span>}
            </div>
          </div>

          <p class="hashtag-description">{topic.description}</p>

          <div class="hashtag-list">
            {(topic.hashtags || []).map((item) => (
              <button
                type="button"
                class="hashtag"
                data-hashtag={item.tag}
                title={"Copy " + item.tag}
              >
                <span>{item.tag}</span>
                {item.postCount !== null && item.postCount !== undefined && (
                  <small>{formatPostCount(item.postCount)}</small>
                )}
              </button>
            ))}
          </div>

          <div class="hashtag-actions">
            <span>{(topic.hashtags || []).length} hashtags</span>
            <button
              class="small-btn copy-set"
              type="button"
              data-copy={(topic.hashtags || []).map((item) => item.tag).join(' ')}
            >
              Copy All
            </button>
          </div>
        </article>
      ))}
    </div>

    <div class="hashtag-empty" id="hashtag-empty" hidden>
      <h3>No hashtag sets found</h3>
      <p>Try another keyword or choose a different category.</p>
      <button class="secondary" type="button" id="clear-hashtag-search">Clear search</button>
    </div>
  </div>
</section>

<section class="section hashtag-info">
  <div class="container narrow">
    <div class="eyebrow">How to use them</div>
    <h2>Choose hashtags around the content, not just popularity.</h2>
    <p class="lead">
      Start with a topic-specific set that matches what your post is actually
      about. A relevant combination is more useful than filling a caption
      with unrelated high-volume tags.
    </p>

    <div class="hashtag-guidelines">
      <div>
        <span>01</span>
        <h3>Match the topic</h3>
        <p>Pick a set that accurately describes the Reel, photo or niche.</p>
      </div>
      <div>
        <span>02</span>
        <h3>Mix intent</h3>
        <p>Combine broad discovery tags with more specific niche terms when appropriate.</p>
      </div>
      <div>
        <span>03</span>
        <h3>Keep it relevant</h3>
        <p>Skip a popular hashtag when it has nothing to do with the content.</p>
      </div>
    </div>
  </div>
</section>


<section class="section hashtag-seo">
  <div class="container narrow">
    <div class="eyebrow">Instagram hashtag guide</div>
    <h2>Trending Instagram hashtags for Reels, posts and creators</h2>
    <p class="lead">
      Use this curated Instagram hashtag library to discover relevant hashtag sets
      for Reels, photos and creator content. Search by niche, topic or seasonal idea,
      then copy a ready-to-use set instead of building hashtags from scratch.
    </p>
    <div class="seo-links">
      <a href="/prompts/">Explore AI image prompts</a>
      <a href="/creator-hub/">Visit Creator Hub</a>
      <a href="/blog/">Read creator guides</a>
    </div>
    <h3>How to choose Instagram hashtags</h3>
    <p>
      The strongest hashtag set is closely related to the content you publish.
      Combine broad discovery terms with specific niche hashtags, and update your
      selection when the topic, season or audience changes. Avoid adding unrelated
      hashtags simply because they are popular.
    </p>
  </div>
</section>

<script type="application/ld+json">
{JSON.stringify({
  "@context": "https://schema.org",
