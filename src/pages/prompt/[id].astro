---
import Layout from '../../layouts/Layout.astro';
import PromptCard from '../../components/PromptCard.astro';
import prompts from '../../data/prompts.json';
import blogs from '../../data/blogs.json';
import trends from '../../data/trends.json';
import guides from '../../data/ai-photo-guides.json';
import { isPublished } from '../../lib/publication.js';

export function getStaticPaths() {
  return prompts.map((p) => ({
    params: { id: p.id },
    props: { p }
  }));
}

const { p } = Astro.props;

const related = prompts
  .filter(
    (x) =>
      x.id !== p.id &&
      (x.category === p.category ||
        x.tags.some((t) => p.tags.includes(t)))
  )
  .slice(0, 4);

const relatedBlogs = blogs
  .filter(
    (b) =>
      isPublished(b.date) &&
      (
        b.category === p.category ||
        b.tags.some((t) => p.tags.includes(t))
      )
  )
  .slice(0, 3);

const tags = Array.isArray(p.tags) ? p.tags : [];
const searchTerms = Array.isArray(p.searchTerms) ? p.searchTerms : [];

const promptSearchText = [
  p.title,
  p.description,
  p.category,
  ...tags,
  ...searchTerms
]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();

const relatedTrends = trends
  .filter((t) => {
    const trendSearchText = [
      t.title,
      t.eyebrow,
      ...(Array.isArray(t.searchTerms) ? t.searchTerms : [])
    ]
      .filter(Boolean)
      .join(' ')
      .toLowerCase();

    return (
      trendSearchText.includes(p.category.toLowerCase()) ||
      p.tags.some((tag) => trendSearchText.includes(String(tag).toLowerCase())) ||
      searchTerms.some((term) => trendSearchText.includes(String(term).toLowerCase())) ||
      trendSearchText.includes(promptSearchText.split(' ')[0] || '')
    );
  })
  .slice(0, 2);

const relatedGuides = guides
  .filter((g) => {
    const guideSearchText = [
      g.title,
      g.eyebrow,
      ...(Array.isArray(g.searchTerms) ? g.searchTerms : [])
    ]
      .filter(Boolean)
      .join(' ')
      .toLowerCase();

    return (
      p.referenceImageRequired === true &&
      (
        guideSearchText.includes('face') ||
        guideSearchText.includes('identity') ||
        guideSearchText.includes('reference')
      )
    ) || p.tags.some((tag) => guideSearchText.includes(String(tag).toLowerCase()));
  })
  .slice(0, 2);

const bestFor =
  p.bestFor ||
  p.best_for ||
  `AI image creation, ${p.category.toLowerCase()} photography and creative social media content`;

const promptTips = Array.isArray(p.promptTips)
  ? p.promptTips
  : Array.isArray(p.prompt_tips)
    ? p.prompt_tips
    : [];

const tools = Array.isArray(p.tools) ? p.tools : [];

const promptGuideIntro = p.referenceImageRequired === true
  ? `This ${p.category.toLowerCase()} prompt is designed to work from your reference photo, so keep the source image clear and well framed before generating.`
  : `This ${p.category.toLowerCase()} prompt can be used on its own, with a reference image added when you want tighter control over the subject or composition.`;

const promptGuideTip = p.referenceImageRequired === true
  ? 'For more consistent identity, use a clear, well-lit reference photo and avoid changing several identity-related details in one edit.'
  : 'For cleaner iterations, keep the main subject and style consistent while changing one visual detail at a time.';


const description =
  p.description ||
  `A ready-to-use ${p.category.toLowerCase()} AI image prompt for creative image generation.`;

const trendStatus = p.trendStatus || '';
const showTrending = p.trending === true;

const trendLabel =
  trendStatus === 'hot'
    ? '🔥 Hot'
    : trendStatus === 'rising'
      ? '📈 Rising'
      : trendStatus === 'seasonal'
        ? 'Seasonal'
        : trendStatus === 'evergreen'
          ? 'Evergreen'
          : 'Trending';

const siteUrl = (Astro.site || 'https://www.createwithsoumay.store').toString().replace(/\/$/, '');

const canonicalUrl = new URL(
  `/prompt/${p.id}/`,
  siteUrl
);

const primarySearchTerm = searchTerms[0] || `${p.category} AI image prompt`;
const secondarySearchTerm = searchTerms[1] || '';
const toolNames = tools.slice(0, 3).join(', ');

const seoTitleBase =
  p.title.toLowerCase().includes('prompt')
    ? p.title
    : `${p.title} AI Image Prompt`;

const seoSearchTitle =
  primarySearchTerm &&
  !seoTitleBase.toLowerCase().includes(primarySearchTerm.toLowerCase()) &&
  seoTitleBase.length <= 44
    ? `${seoTitleBase} — ${primarySearchTerm}`
    : seoTitleBase;

const seoTitle =
  seoSearchTitle.length <= 58
    ? `${seoSearchTitle} | Create With Soumay`
    : `${seoSearchTitle.slice(0, 54).trim()}… | Create With Soumay`;

const naturalSeoDescription = [
  description,
  primarySearchTerm ? `Create a ${primarySearchTerm.toLowerCase()}.` : '',
  secondarySearchTerm ? `Also useful for ${secondarySearchTerm.toLowerCase()}.` : '',
  toolNames ? `Works with ${toolNames}.` : ''
]
  .filter(Boolean)
  .join(' ');

const pageDescription =
  naturalSeoDescription.length <= 155
    ? naturalSeoDescription
    : `${naturalSeoDescription.slice(0, 152).trim()}…`;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: p.title,
  description: pageDescription,
  url: canonicalUrl.href,
  isPartOf: {
    '@type': 'WebSite',
    name: 'Create With Soumay',
    url: `${siteUrl}/`
  },
  about: {
    '@type': 'Thing',
    name: `${p.category} AI image prompt`
  },
  keywords: [...tags, ...searchTerms].join(', '),
  datePublished: p.createdAt || undefined,
  dateModified: p.updatedAt || p.createdAt || undefined,
  mainEntity: {
    '@type': 'CreativeWork',
    name: `${p.title} AI image prompt`,
    description,
    keywords: searchTerms.join(', '),
    ...(p.image
      ? {
          image: new URL(
            p.image,
            siteUrl
          ).href
        }
      : {})
  }
};

const imageObjectSchema = p.image
  ? {
      '@context': 'https://schema.org',
      '@type': 'ImageObject',
      contentUrl: new URL(p.image, siteUrl).href,
      name: `Example result for ${p.title} AI image prompt`,
      description: `Example visual result for the ${p.title} AI image prompt on Create With Soumay.`
    }
  : null;

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to use the ${p.title} AI image prompt`,
  description: `A practical guide to using the ${p.title} AI image prompt for ${p.category.toLowerCase()} image creation.`,
  url: canonicalUrl.href,
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Copy the prompt',
      text: 'Use the Copy Prompt button to copy the complete AI image prompt.'
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: p.referenceImageRequired === true
        ? 'Upload your reference photo'
        : 'Add a reference image if useful',
      text: p.referenceImageRequired === true
        ? 'Use a clear reference photo so the image generator has a strong identity reference.'
        : 'A reference image is optional; add one when it helps guide the subject or composition.'
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Paste and generate',
      text: `Paste the prompt into your image generator and create a first ${p.category.toLowerCase()} result.`
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Refine one detail at a time',
      text: promptGuideTip
    }
  ]
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'AI Prompts',
      item: `${siteUrl}/prompts/`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: p.category,
      item: `${siteUrl}/prompts/${p.category.toLowerCase()}/`
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: p.title,
      item: canonicalUrl.href
    }
  ]
};
---

<Layout
  title={seoTitle}
  description={pageDescription}
  active="Prompts"
  ogImage={p.image ? new URL(p.image, siteUrl).href : undefined}
  ogImageAlt={`Example result for ${p.title} AI image prompt`}
>
  <!-- Structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify(webPageSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(howToSchema)}
  />

  {imageObjectSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(imageObjectSchema)}
    />
  )}

  <article class="prompt-page container">

    <!-- Breadcrumb -->
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/prompts/">Prompts</a>
      <span>/</span>
      <a href={`/prompts/${p.category.toLowerCase()}/`}>
        {p.category}
      </a>
      <span>/</span>
      <span>{p.title}</span>
    </nav>

    <!-- Header -->
    <header class="prompt-header">

      <div class="prompt-header-meta">
        <a
          class="header-category"
          href={`/prompts/${p.category.toLowerCase()}/`}
          aria-label={`Browse ${p.category} AI prompts`}
        >
          {p.category}
        </a>

        {p.type && <span class="header-type">{p.type}</span>}

        {showTrending && (
          <span class:list={[
            'header-trending',
            trendStatus === 'hot' && 'is-hot',
            trendStatus === 'rising' && 'is-rising'
          ]}>
            {trendLabel}
          </span>
        )}
      </div>

      <h1>{p.title}</h1>

      <div class="usage-meta">
        {tools.length > 0 && (
          <div class="compatibility">
            <span class="usage-label">Works with</span>
            <div class="compatibility-list">
              {tools.map((tool) => (
                <span class="compatibility-badge">{tool}</span>
              ))}
            </div>
          </div>
        )}

        {p.referenceImageRequired === true && (
          <div class="photo-required">
            <span aria-hidden="true">◉</span>
            Needs your photo
          </div>
        )}
      </div>

      {tags.length > 0 && (
        <div class="tags">
          {tags.slice(0, 6).map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>
      )}

      {(p.createdAt || p.updatedAt) && (
        <p class="prompt-date">
          {p.updatedAt
            ? `Last updated ${new Date(`${p.updatedAt}T00:00:00`).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
              })}`
            : `Published ${new Date(`${p.createdAt}T00:00:00`).toLocaleDateString('en-US', {
                month: 'short',
                day: 'numeric',
                year: 'numeric'
              })}`}
        </p>
      )}

    </header>

    <!-- Result Preview -->
    <section class="prompt-result-section" aria-labelledby="result-preview-title">
      <div class="section-label" id="result-preview-title">
        <span>✦</span>
        Result Preview
      </div>

      <figure class="prompt-result-figure">
        <img
          class="prompt-result-image"
          src={p.image || '/images/prompts/createloom.png'}
          alt={`Example result for ${p.title} AI image prompt`}
          width="1080"
          height="1920"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>Example visual result this prompt is designed to create.</figcaption>
      </figure>
    </section>

    <!-- Prompt -->
    <section class="prompt-section" aria-labelledby="exact-prompt-title">

      <div class="section-label" id="exact-prompt-title">
        <span>✦</span>
        Exact Prompt
      </div>

      <div
        class="prompt-box"
        aria-label="Full AI image prompt"
      >
        {p.prompt}
      </div>

      <div class="wide-actions">

        <button
          class="primary copy-btn"
          data-copy={p.prompt}
        >
          📋 Copy Prompt
        </button>

        <button
          class="secondary share-btn"
          data-url={`/prompt/${p.id}/`}
        >
          🔗 Share
        </button>

        <button
          class="secondary fav-btn"
          data-fav={p.id}
          aria-pressed="false"
          title="Add to favorites"
        >
          <span aria-hidden="true">♡</span>
          Favorite
        </button>

      </div>

    </section>

    <!-- Advertisement -->
    <div class="ad">
      Advertisement
    </div>

    <!-- Best For -->
    <section class="info-section">

      <div class="eyebrow">Best for</div>

      <h2>What this prompt is useful for</h2>

      <p class="best-for">
        {bestFor}
      </p>

    </section>

    <!-- Prompt Tips -->
    {promptTips.length > 0 && (
      <section class="info-section">

        <div class="eyebrow">Prompt tips</div>

        <h2>Get better results from this prompt</h2>

        <ul class="tips-list">
          {promptTips.map((tip) => (
            <li class="tip">
              <span aria-hidden="true">•</span>
              <p>{tip}</p>
            </li>
          ))}
        </ul>

      </section>
    )}

    <!-- How to Use -->
    <section class="info-section">

      <div class="eyebrow">Quick guide</div>

      <h2>How to use this {p.category} AI image prompt</h2>

      <p class="guide-intro">{promptGuideIntro}</p>

      <ol class="how-to-list">
        <li>
          <strong>Copy the prompt.</strong>
          Use the Copy Prompt button above to copy the complete prompt.
        </li>

        <li>
          <strong>{p.referenceImageRequired === true ? 'Upload your reference photo.' : 'Add a reference image if useful.'}</strong>
          {p.referenceImageRequired === true
            ? 'Use a clear reference photo with good lighting and a visible subject.'
            : 'Add one when you want more control over the subject, identity or composition.'}
        </li>

        <li>
          <strong>Paste and generate.</strong>
          Open your preferred image generator, paste the prompt and create a first result.
        </li>

        <li>
          <strong>Refine one detail at a time.</strong>
          {promptGuideTip}
        </li>
      </ol>

    </section>

    <!-- Mid-page Advertisement -->
    <div class="ad">
      Advertisement
    </div>

    <!-- Related Prompts -->
    {related.length > 0 && (
      <section class="related-section">

        <div class="eyebrow">More like this</div>

        <h2>Related AI Prompts</h2>

        <p class="section-description">
          Explore more Create With Soumay prompts with similar styles,
          categories and visual concepts.
        </p>

        <div class="grid">

          {related.map((x) => (
            <PromptCard p={x} />
          ))}

        </div>

        <div class="center-link">
          <a href="/prompts/">
            Explore all prompts →
          </a>
        </div>

      </section>
    )}

    <!-- Related Blogs -->
    {relatedBlogs.length > 0 && (
      <section class="related-section">

        <div class="eyebrow">Learn more</div>

        <h2>Creator Guides</h2>

        <p class="section-description">
          Learn how to write better prompts, create AI content
          and grow your creator workflow.
        </p>

        <div class="blog-grid">

          {relatedBlogs.map((blog) => (
            <a
              class="blog-card"
              href={`/blog/${blog.id}/`}
            >

              <span class="card-category">
                {blog.category}
              </span>

              <h3>{blog.title}</h3>

              <p>{blog.excerpt}</p>

              <span class="card-link">
                Read guide →
              </span>

            </a>
          ))}

        </div>

      </section>
    )}

    <!-- Related AI Photo Resources -->
    {(relatedTrends.length > 0 || relatedGuides.length > 0) && (
      <section class="related-section resource-links-section">
        <div class="eyebrow">Explore more</div>
        <h2>AI Photo Trends & Guides</h2>
        <p class="section-description">
          Discover related AI photo trends and practical guides that can help
          you create better results with this prompt.
        </p>

        <div class="resource-link-grid">
          {relatedTrends.map((trend) => (
            <a class="resource-link-card" href={`/trends/${trend.slug}/`}>
              <span class="resource-link-type">AI Photo Trend</span>
              <h3>{trend.title}</h3>
              <span class="card-link">Explore trend →</span>
            </a>
          ))}

          {relatedGuides.map((guide) => (
            <a class="resource-link-card" href={`/ai-photo-guides/${guide.slug}/`}>
              <span class="resource-link-type">AI Photo Guide</span>
              <h3>{guide.title}</h3>
              <span class="card-link">Read guide →</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Bottom CTA -->
    <section class="prompt-cta">

      <div class="eyebrow">Create With Soumay</div>

      <h2>Looking for more AI image prompts?</h2>

      <p>
        Explore the full Create With Soumay library of ready-to-use
        prompts for couples, selfies, portraits, fashion,
        vintage photography, anime and more.
      </p>

      <div class="prompt-cta-links">
        <a href={`/prompts/${p.category.toLowerCase()}/`}>
          More {p.category} AI Prompts →
        </a>

        <a href="/creator-hub/">
          Instagram Creator Hub →
        </a>

        <a href="/creator-tools/trending-hashtags/">
          Trending Instagram Hashtags →
        </a>
      </div>

      <a
        class="primary cta-button"
        href="/prompts/"
      >
        Browse All Prompts →
      </a>

    </section>

  </article>

  <!-- Copy / Share / Favorite functionality -->
  <script is:inline>
    const syncDetailFavorite = () => {
      const button = document.querySelector('.fav-btn[data-fav]');
      if (!button) return;

      const currentFavorites = JSON.parse(
        localStorage.getItem('createwithsoumay-favorites') || '[]'
      );

      const legacyFavorites = JSON.parse(
        localStorage.getItem('createloom-favorites') || '[]'
      );

      const favorites = [
        ...new Set([
          ...(Array.isArray(currentFavorites) ? currentFavorites : []),
          ...(Array.isArray(legacyFavorites) ? legacyFavorites : [])
        ])
      ];

      const saved = favorites.includes(button.dataset.fav);
      const icon = button.querySelector('[aria-hidden="true"]');

      if (icon) {
        icon.textContent = saved ? '♥' : '♡';
      }

      button.setAttribute(
        'aria-pressed',
        String(saved)
      );

      button.title = saved
        ? 'Remove from favorites'
        : 'Add to favorites';
    };

    syncDetailFavorite();

    window.addEventListener(
      'createloom:favorites-changed',
      syncDetailFavorite
    );

    window.addEventListener(
      'createwithsoumay:favorites-changed',
      syncDetailFavorite
    );

    window.addEventListener(
      'storage',
      (event) => {
        if (
          event.key === 'createwithsoumay-favorites' ||
          event.key === 'createloom-favorites'
        ) {
          syncDetailFavorite();
        }
      }
    );

    document.addEventListener('click', async (event) => {

      const copyButton = event.target.closest('.copy-btn');

      if (copyButton) {
        try {
          await navigator.clipboard.writeText(
            copyButton.dataset.copy || ''
          );

          const oldText = copyButton.textContent;

          copyButton.textContent = '✓ Copied';

          setTimeout(() => {
            copyButton.textContent = oldText;
          }, 1400);

        } catch {
          copyButton.textContent = 'Copy failed';

          setTimeout(() => {
            copyButton.textContent = '📋 Copy Prompt';
          }, 1400);
        }
      }

      const shareButton = event.target.closest('.share-btn');

      if (shareButton) {

        const url = new URL(
          shareButton.dataset.url,
          location.origin
        ).href;

        if (navigator.share) {

          try {
            await navigator.share({
              title: document.title,
              url
            });
          } catch {
            // User cancelled sharing.
          }

        } else {

          try {
            await navigator.clipboard.writeText(url);

            const oldText = shareButton.textContent;

            shareButton.textContent = '✓ Link Copied';

            setTimeout(() => {
              shareButton.textContent = oldText;
            }, 1400);

          } catch {
            // Clipboard unavailable.
          }
        }
      }

    });
  </script>
</Layout>

<style>
  .prompt-page {
    max-width: 1080px;
    margin: 0 auto;
    padding: 38px 20px 90px;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    color: var(--muted, #9ca3af);
    font-size: 0.86rem;
  }

  .breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: #c4b5fd;
  }

  .prompt-header {
    text-align: center;
    max-width: 850px;
    margin: 42px auto 35px;
  }

  .prompt-header-meta {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 7px;
  }

  .header-category,
  .header-type,
  .header-trending {
    display: inline-flex;
    align-items: center;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: .68rem;
    font-weight: 800;
  }

  .header-category {
    color: #c4b5fd;
    background: rgba(139,92,246,.08);
    border: 1px solid rgba(139,92,246,.22);
    text-decoration: none;
  }

  .header-type {
    color: #bdbdc6;
    background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.08);
  }

  .header-trending {
    color: #c4b5fd;
    background: rgba(139,92,246,.08);
    border: 1px solid rgba(139,92,246,.22);
  }

  .header-trending.is-hot {
    color: #fdba74;
    background: rgba(251,146,60,.08);
    border-color: rgba(251,146,60,.24);
  }

  .usage-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }

  .compatibility {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .usage-label {
    color: #85858f;
    font-size: .68rem;
    font-weight: 800;
  }

  .compatibility-list {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .compatibility-badge {
    padding: 5px 8px;
    border: 1px solid rgba(139,92,246,.18);
    border-radius: 999px;
    background: rgba(139,92,246,.055);
    color: #c4b5fd;
    font-size: .68rem;
    font-weight: 700;
  }

  .photo-required {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    border: 1px solid rgba(139,92,246,.16);
    border-radius: 999px;
    background: rgba(139,92,246,.045);
    color: #aaa1c5;
    font-size: .68rem;
    font-weight: 750;
  }

  .photo-required span {
    color: #a78bfa;
    font-size: .58rem;
  }

  .prompt-date {
    margin: 14px 0 0;
    color: #777782;
    font-size: .76rem;
  }

  .prompt-header h1 {
    margin: 12px 0 18px;
