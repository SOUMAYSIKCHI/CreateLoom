    border-color: rgba(139,92,246,0.4);
  }

  .card-category {
    color: #a78bfa;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .blog-card h3 {
