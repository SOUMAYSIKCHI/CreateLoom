    }

    .prompt-header {
      margin-top: 32px;
    }

    .prompt-header h1 {
      font-size: 2.25rem;
    }

    .prompt-box {
      padding: 20px;
      font-size: 0.95rem;
      line-height: 1.75;
    }

    .wide-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .wide-actions button {
