    line-height: 1.35;
  }

  .blog-card p {
    color: var(--muted, #a1a1aa);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .card-link {
    display: inline-block;
    margin-top: 7px;
    color: #c4b5fd;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .prompt-cta {
    max-width: 920px;
    margin: 70px auto 0;
    padding: 38px;
    text-align: center;
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.12),
        rgba(255,255,255,0.025)
