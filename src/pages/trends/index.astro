---
import Layout from '../../layouts/Layout.astro';
import trends from '../../data/trends.json';

const siteUrl = 'https://www.createwithsoumay.store';
const pageUrl = `${siteUrl}/trends/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'AI Photo Trends', url: '/trends/' },
];

const trending = trends.filter((trend) => trend.isTrending);
const otherTrends = trends.filter((trend) => !trend.isTrending);

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#webpage`,
  name: 'AI Photo Trends',
  url: pageUrl,
  description: 'Discover AI photo trends, viral image ideas, ready-to-use prompts and practical guides for creating trending AI images.',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Create With Soumay',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Create With Soumay',
    url: siteUrl,
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: trends.length,
    itemListElement: trends.map((trend, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: trend.title,
      url: `${siteUrl}/trends/${trend.slug}/`,
    })),
  },
};
---

<Layout
  title="AI Photo Trends | Trending AI Image Ideas & Prompts | Create With Soumay"
  description="Discover trending AI photo ideas, viral image styles and ready-to-use prompts. Explore current AI photo trends and learn how to create them with ChatGPT, Gemini and Nano Banana."
  canonical={pageUrl}
>
  <main class="trends-page">
    <div class="trends-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {breadcrumbItems.map((item, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            {index === breadcrumbItems.length - 1 ? (
              <span>{item.name}</span>
            ) : (
              <a href={item.url}>{item.name}</a>
            )}
          </>
        ))}
      </nav>

      <header class="trends-header">
        <div class="eyebrow">AI Photo Trends</div>
        <h1>AI Photo Trends</h1>
        <p>
          Explore trending AI photo ideas, viral image styles and practical
          guides for creating them with today's popular AI image tools.
        </p>
      </header>

      {trending.length > 0 && (
        <section class="trend-section">
          <div class="section-heading">
            <div>
              <div class="eyebrow">What's trending</div>
              <h2>Trending AI photo ideas</h2>
            </div>
            <span>{trending.length} trending {trending.length === 1 ? 'trend' : 'trends'}</span>
          </div>

          <div class="trend-grid">
            {trending.map((trend) => (
              <a class="trend-card featured" href={`/trends/${trend.slug}/`}>
                <div class="card-topline">
                  <span class="trend-badge">Trending</span>
                  <span>#{trend.noId}</span>
                </div>
                <h3>{trend.title}</h3>
                <p>{trend.intro}</p>
                <span class="read-link">Explore trend →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      {otherTrends.length > 0 && (
        <section class="trend-section">
          <div class="section-heading">
            <div>
              <div class="eyebrow">Explore more</div>
              <h2>More AI photo trends</h2>
            </div>
          </div>

          <div class="trend-grid">
            {otherTrends.map((trend) => (
              <a class="trend-card" href={`/trends/${trend.slug}/`}>
                <div class="card-topline">
                  <span>{trend.eyebrow}</span>
                  <span>#{trend.noId}</span>
                </div>
                <h3>{trend.title}</h3>
                <p>{trend.intro}</p>
                <span class="read-link">Explore trend →</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="resource-section">
        <div class="section-heading">
          <div>
            <div class="eyebrow">Create better AI images</div>
            <h2>Explore AI Photo Guides & Prompts</h2>
          </div>
        </div>

        <div class="resource-grid">
          <a class="resource-card" href="/ai-photo-guides/">
            <span class="resource-type">AI Photo Guides</span>
            <h3>Learn how to create better AI photos</h3>
            <p>Get practical guidance for face consistency, realistic results, AI hands, prompts and other common image-generation problems.</p>
            <span class="read-link">Read AI photo guides →</span>
          </a>

          <a class="resource-card" href="/prompts/">
            <span class="resource-type">AI Image Prompts</span>
            <h3>Try ready-to-use AI image prompts</h3>
            <p>Browse prompts for couples, selfies, portraits, fashion, vintage photography, anime and more.</p>
            <span class="read-link">Explore AI prompts →</span>
          </a>
        </div>
      </section>

      <section class="bottom-cta">
        <div>
          <div class="eyebrow">Create something</div>
          <h2>Want to try a trending AI prompt?</h2>
          <p>Browse ready-to-use prompts and turn a trend into your next image.</p>
        </div>
        <a href="/prompts/">Explore AI prompts →</a>
      </section>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
</Layout>

<style>
  .trends-page {
    padding: 28px 0 80px;
  }

  .trends-container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 42px;
    color: #9f98aa;
    font-size: 0.88rem;
  }

  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .trends-header {
    max-width: 820px;
    margin-bottom: 58px;
  }

  .eyebrow {
    color: #9f98aa;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 12px 0 18px;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .trends-header p {
    max-width: 760px;
    margin: 0;
    color: #b9b4c3;
    font-size: 1.12rem;
    line-height: 1.75;
  }

  .trend-section {
    margin-bottom: 64px;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }

  .section-heading h2 {
    margin: 8px 0 0;
    font-size: clamp(1.65rem, 3vw, 2.3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .section-heading > span {
    color: #8f8999;
    font-size: 0.9rem;
  }

  .trend-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .trend-card {
    display: flex;
    min-height: 300px;
    flex-direction: column;
    padding: 25px;
    border: 1px solid #292631;
    border-radius: 18px;
    background: #111016;
    color: #f4f2f8;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .trend-card:hover {
    transform: translateY(-3px);
    border-color: #51495f;
    background: #141219;
  }

  .trend-card.featured {
    border-color: #3b3547;
  }

  .card-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 30px;
    color: #8f8999;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .trend-badge {
    padding: 6px 9px;
    border: 1px solid #4b4357;
    border-radius: 999px;
    color: #c9b9ff;
    font-size: 0.7rem;
  }

  .trend-card h3 {
    margin: 0 0 13px;
    color: #fff;
    font-size: 1.28rem;
    line-height: 1.28;
    letter-spacing: -0.02em;
  }

  .trend-card p {
    margin: 0;
    color: #b9b4c3;
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .read-link {
    margin-top: auto;
    padding-top: 24px;
    color: #eeeaf5;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .resource-section {
    margin-bottom: 64px;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .resource-card {
    display: flex;
    min-height: 210px;
    flex-direction: column;
    padding: 25px;
    border: 1px solid #292631;
    border-radius: 18px;
    background: #111016;
    color: #f4f2f8;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .resource-card:hover {
    transform: translateY(-3px);
    border-color: #51495f;
    background: #141219;
  }

  .resource-type {
    color: #9f98aa;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .resource-card h3 {
    margin: 10px 0;
    color: #fff;
    font-size: 1.2rem;
    line-height: 1.3;
  }

  .resource-card p {
    margin: 0;
    color: #b9b4c3;
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .resource-card .read-link {
    margin-top: auto;
    padding-top: 22px;
  }

  .bottom-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 30px;
    border: 1px solid #292631;
    border-radius: 18px;
    background: #111016;
  }

  .bottom-cta h2 {
    margin: 8px 0;
    color: #fff;
    font-size: 1.7rem;
  }

  .bottom-cta p {
    margin: 0;
    color: #aaa4b3;
  }

  .bottom-cta > a {
    flex: 0 0 auto;
    padding: 12px 18px;
    border: 1px solid #3a3545;
    border-radius: 10px;
    background: #17151c;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .trend-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .trends-page {
      padding-top: 18px;
    }

    .breadcrumbs {
      margin-bottom: 30px;
    }

    .trend-grid {
      grid-template-columns: 1fr;
    }

    .resource-grid {
      grid-template-columns: 1fr;
    }

    .trend-card {
      min-height: 260px;
    }

    .section-heading {
      display: block;
    }

    .section-heading > span {
      display: block;
      margin-top: 10px;
    }

    .bottom-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
