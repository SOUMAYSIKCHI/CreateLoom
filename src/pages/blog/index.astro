---
import Layout from '../../layouts/Layout.astro'; import blogs from '../../data/blogs.json';
const cats=[...new Set(blogs.map(b=>b.category))].sort();
---
<Layout title="CreateLoom Blog — AI & Instagram Creator Guides" description="AI, Instagram, creator growth and brand collaboration guides from CreateLoom." active="Blog">
<section class="hero hero-compact"><div class="container"><div class="eyebrow">Guides & ideas</div><h1>CreateLoom <span class="gradient-text">Blog</span></h1><p>AI, Instagram and creator resources to help you create better content and grow.</p><form class="search" id="blogSearchForm"><input id="blogSearch" name="q" placeholder="Search articles..." autocomplete="off"/><button>Search</button></form></div></section>
<section class="section"><div class="container"><div class="toolbar"><div class="filters" id="blogFilters"><button type="button" class="small-btn active-filter" data-cat="All">All</button>{cats.map(c=><button type="button" class="small-btn" data-cat={c}>{c}</button>)}</div><span class="results-note" id="blogCount"></span></div><div class="grid" id="blogGrid">{blogs.map(b=><a class="card blog-card" data-title={b.title} data-cat={b.category} data-tags={b.tags.join(' ')} data-content={b.content.join(' ')} href={`/blog/${b.id}/`}><span class="eyebrow">{b.category}</span><h3>{b.title}</h3><p>{b.excerpt}</p><div class="muted" style="margin-top:14px;font-size:13px">{b.readTime} · {b.date}</div></a>)}</div><div class="empty-state" id="blogEmpty">No articles found. Try another search or category.</div></div></section>
</Layout>
<script is:inline>
const input=document.querySelector('#blogSearch'),form=document.querySelector('#blogSearchForm'),cards=[...document.querySelectorAll('.blog-card')],buttons=[...document.querySelectorAll('[data-cat]')],count=document.querySelector('#blogCount');const params=new URLSearchParams(location.search);let cat=params.get('category')||'All';input.value=params.get('q')||'';
function filter(){const q=input.value.trim().toLowerCase();let n=0;cards.forEach(c=>{const text=(c.dataset.title+' '+c.dataset.cat+' '+c.dataset.tags+' '+c.dataset.content).toLowerCase();const ok=(cat==='All'||c.dataset.cat===cat)&&(!q||text.includes(q));c.hidden=!ok;if(ok)n++});buttons.forEach(b=>b.classList.toggle('active-filter',b.dataset.cat===cat));count.textContent=`${n} article${n===1?'':'s'}`;document.querySelector('#blogEmpty').style.display=n?'none':'block'}
form.addEventListener('submit',e=>{e.preventDefault();history.replaceState({},'',`/blog/${input.value.trim()?`?q=${encodeURIComponent(input.value.trim())}`:''}${cat!=='All'?(input.value.trim()?'&':'?')+`category=${encodeURIComponent(cat)}`:''}`);filter()});input.addEventListener('input',filter);buttons.forEach(b=>b.addEventListener('click',()=>{cat=b.dataset.cat;const q=input.value.trim();const qs=[];if(q)qs.push(`q=${encodeURIComponent(q)}`);if(cat!=='All')qs.push(`category=${encodeURIComponent(cat)}`);history.replaceState({},'',`/blog/${qs.length?'?'+qs.join('&'):''}`);filter()}));filter();
</script>
