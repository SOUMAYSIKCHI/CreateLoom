---
import Layout from '../../layouts/Layout.astro';
import blogs from '../../data/blogs.json';
import prompts from '../../data/prompts.json';

export function getStaticPaths() {
  return blogs.map((b) => ({
    params: { id: b.id },
    props: { b }
  }));
}

const { b } = Astro.props;

const content = b.content;

const headings = content
  .filter((item) => item.startsWith('### '))
  .map((item) => item.replace(/^###\s*/, ''));

const relatedBlogs = blogs
  .filter(
    (x) =>
      x.id !== b.id &&
      (
        x.category === b.category ||
        x.tags.some((tag) => b.tags.includes(tag))
      )
  )
  .slice(0, 3);

const relatedPrompts = prompts
  .filter(
    (x) =>
      x.category === b.category ||
      x.tags.some((tag) => b.tags.includes(tag))
  )
  .slice(0, 4);

const siteUrl = Astro.site || 'https://createwithsoumay.store';

const canonicalUrl = new URL(
  `/blog/${b.id}/`,
  siteUrl
);

const authorName = b.author || b.authorName || 'Create With Soumay Editorial Team';
const authorSchema = b.author
  ? { '@type': 'Person', name: authorName }
  : { '@type': 'Organization', name: authorName, url: new URL('/', siteUrl).href };
const articleImage = b.image
  ? new URL(b.image, siteUrl).href
  : undefined;

const getAnchor = (heading) =>
  heading
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: b.title,
  description: b.excerpt,
  datePublished: b.date,
  dateModified: b.updatedAt || b.date,
  mainEntityOfPage: canonicalUrl.href,
  author: authorSchema,
  publisher: {
    '@type': 'Organization',
    name: 'Create With Soumay',
    url: new URL('/', siteUrl).href
  },
  articleSection: b.category,
  keywords: b.tags.join(', ')
};

const articleImageSchema = b.image
  ? {
      '@context': 'https://schema.org',
      '@type': 'ImageObject',
      contentUrl: articleImage,
      name: b.title,
      description: `Featured image for ${b.title}.`
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', siteUrl).href
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: new URL('/blog/', siteUrl).href
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: b.title,
      item: canonicalUrl.href
    }
  ]
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CreateLoom',
  url: new URL('/', siteUrl).href
};
---

<Layout
  title={`${b.title} | Create With Soumay Blog`}
  description={b.excerpt}
  active="Blog"
  ogImage={articleImage}
  ogImageAlt={`Featured image for ${b.title}`}
>

  <!-- Structured data -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(websiteSchema)}
  />

  {articleImageSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(articleImageSchema)}
    />
  )}


  <article class="article-page container">

    <!-- Breadcrumb -->

    <nav
      class="breadcrumbs"
      aria-label="Breadcrumb"
    >
      <a href="/">Home</a>
      <span>›</span>
      <a href="/blog/">Blog</a>
      <span>›</span>
      <span aria-current="page">{b.title}</span>
    </nav>


    <!-- Article header -->

    <header class="article-header">

      <div class="eyebrow">
        {b.category}
      </div>

      <h1>
        {b.title}
      </h1>

      <p class="article-lede">
        {b.excerpt}
      </p>

      <div class="article-meta">

        <span>
          📅 {b.date}
        </span>

        <span>•</span>

        <span>
          ⏱ {b.readTime}
        </span>

        <span>•</span>

        <span>
          ✦ Written by {authorName}
        </span>

      </div>


      <div class="article-tags">

        {b.tags.map((tag) => (
          <span class="article-tag">
            #{tag}
          </span>
        ))}

      </div>

    </header>


    <!-- Top advertisement -->

    <div class="ad article-ad">
      Advertisement
    </div>


    <!-- Main article layout -->

    <div class="article-layout">


      <!-- Article content -->

      <main class="article-content">

        {content.map((item, index) => {

          if (item.startsWith('### ')) {

            const heading = item.replace(/^###\s*/, '');
            const anchor = getAnchor(heading);

            return (
              <section
                class="article-section"
                id={anchor}
              >
                <h2>
                  {heading}
                </h2>
              </section>
            );

          }

          if (index === 0) {

            return (
              <p class="article-intro">
                {item}
              </p>
            );

          }

          return (
            <p class="article-paragraph">
              {item}
            </p>
          );

        })}


        <!-- Mid article advertisement -->

        <div class="ad article-ad">
          Advertisement
        </div>


        <!-- Related prompts -->

        {relatedPrompts.length > 0 && (

          <section class="related-section">

            <div class="eyebrow">
              Put it into practice
            </div>

            <h2>
              Explore Related AI Prompts
            </h2>

            <p class="section-description">
              Turn the ideas from this guide into actual images with
              detailed, ready-to-copy Create With Soumay prompts.
            </p>


            <div class="related-grid">

              {relatedPrompts.map((p) => (

                <a
                  class="related-card"
                  href={`/prompt/${p.id}/`}
                >

                  <span class="card-category">
                    {p.category}
                  </span>

                  <h3>
                    {p.title}
                  </h3>

                  <p>
                    {p.prompt.slice(0, 130)}
                    {p.prompt.length > 130 ? '…' : ''}
                  </p>

                  <span class="card-link">
                    View prompt →
                  </span>

                </a>

              ))}

            </div>

          </section>

        )}


        <!-- Related blogs -->

        {relatedBlogs.length > 0 && (

          <section class="related-section">

            <div class="eyebrow">
              Keep learning
            </div>

            <h2>
              Related Creator Guides
            </h2>

            <p class="section-description">
              Continue exploring practical guides related to this topic.
            </p>


            <div class="related-grid">

              {relatedBlogs.map((blog) => (

                <a
                  class="related-card"
                  href={`/blog/${blog.id}/`}
                >

                  <span class="card-category">
                    {blog.category}
                  </span>

                  <h3>
                    {blog.title}
                  </h3>

                  <p>
                    {blog.excerpt}
                  </p>

                  <span class="card-link">
                    Read article →
                  </span>

                </a>

              ))}

            </div>

          </section>

        )}


        <!-- Related Creator Resources -->

        <section class="related-section creator-resources-section">
          <div class="eyebrow">
            Explore Create With Soumay
          </div>

          <h2>
            More Creator Resources
          </h2>

          <p class="section-description">
            Continue from this guide with practical AI prompts, Instagram
            creator resources and curated hashtag sets.
          </p>

          <div class="resource-links">
            <a href="/prompts/" class="related-card">
              <span class="card-category">AI IMAGE CREATION</span>
              <h3>AI Image Prompt Library</h3>
              <p>Browse detailed, ready-to-use prompts for your next image.</p>
              <span class="card-link">Explore prompts →</span>
            </a>

            <a href="/creator-hub/" class="related-card">
              <span class="card-category">INSTAGRAM</span>
              <h3>Instagram Creator Hub</h3>
              <p>Find Reel ideas, growth tips, hooks and creator resources.</p>
              <span class="card-link">Open Creator Hub →</span>
            </a>

            <a href="/creator-tools/trending-hashtags/" class="related-card">
              <span class="card-category">HASHTAGS</span>
              <h3>Trending Instagram Hashtags</h3>
              <p>Find curated hashtag sets by topic, niche and creator goal.</p>
              <span class="card-link">Explore hashtags →</span>
            </a>
          </div>
        </section>


        <!-- Bottom CTA -->

        <section class="article-cta">

          <div class="eyebrow">
            Create With Soumay Prompt Library
          </div>

          <h2>
            Ready to create something?
          </h2>

          <p>
            Browse detailed AI image prompts and find a starting point
            for your next creative idea.
          </p>

          <a
            href="/prompts/"
            class="primary"
          >
            Explore AI Prompts →
          </a>

        </section>

      </main>


      <!-- Sidebar -->

      <aside class="article-sidebar">


        <!-- Table of contents -->

        {headings.length > 0 && (

          <div class="toc">

            <div class="toc-title">
              On this page
            </div>

            <nav aria-label="Article sections">

              {headings.map((heading) => {

                const anchor = getAnchor(heading);

                return (
                  <a href={`#${anchor}`}>
                    {heading}
                  </a>
                );

              })}

            </nav>

          </div>

        )}


        <!-- Prompt CTA -->

        <div class="sidebar-card">

          <div class="eyebrow">
            Create With Soumay
          </div>

          <h3>
            Find your next AI prompt
          </h3>

          <p>
            Explore detailed prompts for couples, selfies, portraits,
            fashion, vintage photography, anime and more.
          </p>

          <a
            class="sidebar-button"
            href="/prompts/"
          >
            Browse Prompts →
          </a>

        </div>


        <!-- Blog CTA -->

        <div class="sidebar-card secondary-card">

          <div class="eyebrow">
            More guides
          </div>

          <h3>
            Keep learning
          </h3>

          <p>
            Explore more Create With Soumay articles covering AI,
            Instagram and creator growth.
          </p>

          <a
            class="sidebar-button secondary-button"
            href="/blog/"
          >
            Browse Blog →
          </a>

        </div>

      </aside>

    </div>

  </article>

</Layout>


<style>

  .article-page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 42px 20px 90px;
  }


  /* Breadcrumb */

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 42px;
    color: var(--muted, #9ca3af);
    font-size: 0.88rem;
  }


  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }


  .breadcrumbs a:hover {
    color: #c4b5fd;
  }


  /* Header */

  .article-header {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }


  .article-header h1 {
    margin: 14px 0 20px;
    color: #fff;
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
  }


  .article-lede {
    max-width: 760px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    font-size: 1.12rem;
    line-height: 1.8;
  }


  .article-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 22px;
    color: var(--muted, #9ca3af);
    font-size: 0.88rem;
  }


  .article-tags {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }


  .article-tag {
    padding: 6px 10px;
    border: 1px solid rgba(139, 92, 246, 0.25);
    border-radius: 999px;
    background: rgba(139, 92, 246, 0.08);
    color: #c4b5fd;
    font-size: 0.78rem;
  }


  /* Ads */

  .article-ad {
    max-width: 900px;
    margin: 38px auto;
  }


  /* Layout */

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 270px;
    gap: 55px;
    align-items: start;
    max-width: 1080px;
    margin: 0 auto;
  }


  .article-content {
    min-width: 0;
  }


  /* Typography */

  .article-intro {
    margin: 0 0 30px;
    color: #e4e4e7;
    font-size: 1.18rem;
    line-height: 1.9;
  }


  .article-paragraph {
    margin: 0 0 25px;
    color: #c9c9d1;
    font-size: 1.03rem;
    line-height: 1.9;
  }


  .article-section {
    scroll-margin-top: 100px;
  }


  .article-section h2 {
    margin: 46px 0 20px;
    color: #fff;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
  }


  /* Sidebar */

  .article-sidebar {
    position: sticky;
    top: 90px;
  }


  .toc {
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    background: rgba(255,255,255,0.025);
  }


  .toc-title {
    margin-bottom: 14px;
    color: #fff;
    font-weight: 700;
  }


  .toc nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }


  .toc a {
    color: var(--muted, #a1a1aa);
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.45;
  }


  .toc a:hover {
    color: #c4b5fd;
  }


  .sidebar-card {
    margin-top: 18px;
    padding: 22px;
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 18px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.12),
        rgba(255,255,255,0.025)
      );
  }


  .sidebar-card h3 {
    margin: 8px 0 10px;
    color: #fff;
  }


  .sidebar-card p {
    color: var(--muted, #a1a1aa);
    font-size: 0.9rem;
    line-height: 1.65;
  }


  .sidebar-button {
    display: inline-flex;
    margin-top: 10px;
    padding: 10px 14px;
    border-radius: 10px;
    background: #7c3aed;
    color: #fff;
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 700;
  }


  .secondary-card {
    border-color: rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.025);
  }


  .secondary-button {
    background: rgba(255,255,255,0.07);
  }


  /* Related */

  .related-section {
    margin-top: 65px;
    padding-top: 42px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }


  .related-section h2 {
    margin: 8px 0 10px;
    font-size: 1.8rem;
  }


  .section-description {
    max-width: 720px;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
  }


  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 22px;
  }


  .related-card {
    display: block;
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    background: rgba(255,255,255,0.025);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }


  .related-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,0.4);
    background: rgba(139,92,246,0.06);
  }


  .card-category {
    color: #a78bfa;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }


  .related-card h3 {
    margin: 9px 0;
    color: #fff;
    line-height: 1.35;
  }


  .related-card p {
    color: var(--muted, #a1a1aa);
    font-size: 0.9rem;
    line-height: 1.65;
  }


  .card-link {
    display: inline-block;
    margin-top: 7px;
    color: #c4b5fd;
    font-size: 0.85rem;
    font-weight: 700;
  }


  .creator-resources-section {
    margin-top: 65px;
  }

  .resource-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 22px;
  }

  .resource-links .related-card {
    height: 100%;
  }

  /* Bottom CTA */

  .article-cta {
    margin-top: 65px;
    padding: 42px 25px;
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.12),
        rgba(255,255,255,0.025)
      );
    text-align: center;
  }


  .article-cta h2 {
    margin: 8px 0 10px;
    color: #fff;
  }


  .article-cta p {
    max-width: 620px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
  }


  .article-cta .primary {
    display: inline-flex;
    margin-top: 20px;
    text-decoration: none;
  }


  /* Responsive */

  @media (max-width: 850px) {

    .article-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }


    .article-sidebar {
      position: static;
      order: -1;
    }


    .toc {
      max-width: none;
    }


    .toc nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 9px 16px;
    }

  }


  @media (max-width: 600px) {

    .resource-links {
      grid-template-columns: 1fr;
    }

    .article-page {
      padding-top: 28px;
    }


    .article-header h1 {
      font-size: 2.25rem;
    }


    .article-lede {
      font-size: 1rem;
    }


    .article-paragraph {
      font-size: 0.98rem;
      line-height: 1.8;
    }


    .related-grid {
      grid-template-columns: 1fr;
    }


    .toc nav {
      grid-template-columns: 1fr;
    }

  }

</style>
