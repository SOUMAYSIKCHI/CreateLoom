import Layout from '../../layouts/Layout.astro';
import blogs from '../../data/blogs.json';
import prompts from '../../data/prompts.json';

export function getStaticPaths() {
  return blogs.map((b) => ({
    params: { id: b.id },
    props: { b }
  }));
}

const { b } = Astro.props;

const sections = b.content.filter((item) => !item.startsWith('### '));
const headings = b.content
  .filter((item) => item.startsWith('### '))
  .map((item) => item.replace(/^###\s*/, ''));

const relatedBlogs = blogs
  .filter(
    (x) =>
      x.id !== b.id &&
      (x.category === b.category || x.tags.some((tag) => b.tags.includes(tag)))
  )
  .slice(0, 3);

const relatedPrompts = prompts
  .filter(
    (x) =>
      x.category === b.category ||
      x.tags.some((tag) => b.tags.includes(tag))
  )
  .slice(0, 4);

const canonicalUrl = new URL(`/blog/${b.id}/`, Astro.site ?? 'https://createloom.vercel.app');

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: b.title,
  description: b.excerpt,
  datePublished: b.date,
  dateModified: b.date,
  mainEntityOfPage: canonicalUrl.href,
  author: {
    '@type': 'Organization',
    name: 'CreateLoom',
    url: 'https://createloom.vercel.app/'
  },
  publisher: {
    '@type': 'Organization',
    name: 'CreateLoom',
    url: 'https://createloom.vercel.app/'
  }
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://createloom.vercel.app/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: 'https://createloom.vercel.app/blog/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: b.title,
      item: canonicalUrl.href
    }
  ]
};
---

<Layout
  title={`${b.title} | CreateLoom Blog`}
  description={b.excerpt}
  active="Blog"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <article class="article-page container">

    <!-- Breadcrumb -->
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/blog/">Blog</a>
      <span>›</span>
      <span>{b.title}</span>
    </nav>

    <!-- Article Header -->
    <header class="article-header">

      <div class="eyebrow">{b.category}</div>

      <h1>{b.title}</h1>

      <p class="article-lede">{b.excerpt}</p>

      <div class="article-meta">
        <span>📅 {b.date}</span>
        <span>•</span>
        <span>⏱ {b.readTime}</span>
        <span>•</span>
        <span>✦ CreateLoom</span>
      </div>

      <div class="article-tags">
        {b.tags.map((tag) => (
          <span class="article-tag">#{tag}</span>
        ))}
      </div>

    </header>

    <!-- Advertisement -->
    <div class="ad article-ad">
      Advertisement
    </div>

    <div class="article-layout">

      <!-- Main Content -->
      <main class="article-content">

        <p class="article-intro">
          {b.content[0]}
        </p>

        {b.content.slice(1).map((paragraph) => {
          if (paragraph.startsWith('### ')) {
            const heading = paragraph.replace(/^###\s*/, '');
            const anchor = heading
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, '-')
              .replace(/^-|-$/g, '');

            return (
              <section class="article-section" id={anchor}>
                <h2>{heading}</h2>
              </section>
            );
          }

          return (
            <p class="article-paragraph">
              {paragraph}
            </p>
          );
        })}

        <!-- Mid Article Advertisement -->
        <div class="ad article-ad">
          Advertisement
        </div>

        <!-- Related Prompts -->
        {relatedPrompts.length > 0 && (
          <section class="related-section">
            <div class="eyebrow">Try these prompts</div>

            <h2>Explore Related AI Prompts</h2>

            <p class="section-description">
              Want to put these ideas into practice? Explore related
              CreateLoom prompts and copy the full prompt directly.
            </p>

            <div class="related-grid">
              {relatedPrompts.map((p) => (
                <a
                  class="related-card"
                  href={`/prompt/${p.id}/`}
                >
                  <span class="card-category">{p.category}</span>

                  <h3>{p.title}</h3>

                  <p>
                    {p.prompt.slice(0, 130)}…
                  </p>

                  <span class="card-link">
                    View prompt →
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

        <!-- Related Blogs -->
        {relatedBlogs.length > 0 && (
          <section class="related-section">
            <div class="eyebrow">Keep reading</div>

            <h2>Related Creator Guides</h2>

            <div class="related-grid">
              {relatedBlogs.map((blog) => (
                <a
                  class="related-card"
                  href={`/blog/${blog.id}/`}
                >
                  <span class="card-category">
                    {blog.category}
                  </span>

                  <h3>{blog.title}</h3>

                  <p>{blog.excerpt}</p>

                  <span class="card-link">
                    Read article →
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}

      </main>

      <!-- Article Sidebar -->
      <aside class="article-sidebar">

        {headings.length > 0 && (
          <div class="toc">
            <div class="toc-title">
              On this page
            </div>

            <nav>
              {headings.map((heading) => {
                const anchor = heading
                  .toLowerCase()
                  .replace(/[^a-z0-9]+/g, '-')
                  .replace(/^-|-$/g, '');

                return (
                  <a href={`#${anchor}`}>
                    {heading}
                  </a>
                );
              })}
            </nav>
          </div>
        )}

        <div class="sidebar-card">
          <div class="eyebrow">CreateLoom</div>

          <h3>Find your next AI prompt</h3>

          <p>
            Explore detailed prompts for couples, selfies, portraits,
            fashion, vintage photography, anime and more.
          </p>

          <a
            class="sidebar-button"
            href="/prompts/"
          >
            Browse Prompts →
          </a>
        </div>

      </aside>

    </div>

  </article>
</Layout>

<style>
