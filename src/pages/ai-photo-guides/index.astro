---
import Layout from '../../layouts/Layout.astro';
import guides from '../../data/ai-photo-guides.json';

const siteUrl = 'https://createwithsoumay.store';
const pageUrl = `${siteUrl}/ai-photo-guides/`;

const breadcrumbItems = [
  { name: 'Home', url: '/' },
  { name: 'AI Photo Guides', url: '/ai-photo-guides/' },
];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI Photo Guides',
  url: pageUrl,
  description: 'Practical guides for creating better AI images, fixing common AI photo problems and writing stronger image prompts.',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Create With Soumay',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Create With Soumay',
    url: siteUrl,
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: guides.length,
    itemListElement: guides.map((guide, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: guide.title,
      url: `${siteUrl}/ai-photo-guides/${guide.slug}/`,
    })),
  },
};
---

<Layout
  title="AI Photo Guides | Create Better AI Images | Create With Soumay"
  description="Practical AI photo guides for better prompts, realistic images, face consistency, hands, clothing, backgrounds and more."
  canonical={pageUrl}
>
  <main class="guides-page">
    <div class="guides-container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {breadcrumbItems.map((item, index) => (
          <>
            {index > 0 && <span aria-hidden="true">/</span>}
            {index === breadcrumbItems.length - 1 ? (
              <span>{item.name}</span>
            ) : (
              <a href={item.url}>{item.name}</a>
            )}
          </>
        ))}
      </nav>

      <header class="guides-header">
        <div class="eyebrow">AI Photo Guides</div>
        <h1>AI Photo Guides</h1>
        <p>
          Practical guides to help you create better AI images, write stronger
          prompts and fix the most common AI photo problems.
        </p>
      </header>

      <section class="guides-grid" aria-label="AI photo guides">
        {guides.map((guide) => (
          <a class="guide-card" href={`/ai-photo-guides/${guide.slug}/`}>
            <div class="card-number">Guide {guide.noId}</div>
            <h2>{guide.title}</h2>
            <p>{guide.intro}</p>
            <span class="read-link">Read guide →</span>
          </a>
        ))}
      </section>

      <section class="hub-cta">
        <div>
          <div class="eyebrow">Create something</div>
          <h2>Ready to try an AI image prompt?</h2>
          <p>Explore ready-to-use prompts and turn these techniques into your next image.</p>
        </div>
        <a href="/prompts/">Explore AI prompts →</a>
      </section>
    </div>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
</Layout>

<style>
  .guides-page {
    padding: 28px 0 80px;
  }

  .guides-container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 42px;
    color: #777;
    font-size: 0.88rem;
  }

  .breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    text-decoration: underline;
  }

  .guides-header {
    max-width: 820px;
    margin-bottom: 48px;
  }

  .eyebrow {
    color: #777;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 12px 0 18px;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .guides-header p {
    max-width: 760px;
    margin: 0;
    color: #666;
    font-size: 1.12rem;
    line-height: 1.75;
  }

  .guides-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .guide-card {
    display: flex;
    min-height: 300px;
    flex-direction: column;
    padding: 25px;
    border: 1px solid #e5e5e5;
    border-radius: 18px;
    background: #fff;
    color: #252525;
    text-decoration: none;
    transition: transform 0.18s ease, border-color 0.18s ease;
  }

  .guide-card:hover {
    transform: translateY(-3px);
    border-color: #cfcfcf;
  }

  .card-number {
    margin-bottom: 30px;
    color: #777;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .guide-card h2 {
    margin: 0 0 13px;
    color: #171717;
    font-size: 1.28rem;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .guide-card p {
    margin: 0;
    color: #666;
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .read-link {
    margin-top: auto;
    padding-top: 24px;
    color: #222;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .hub-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-top: 60px;
    padding: 30px;
    border-radius: 18px;
    background: #f7f7f7;
    color: #222;
  }

  .hub-cta h2 {
    margin: 8px 0;
    font-size: 1.7rem;
  }

  .hub-cta p {
    margin: 0;
    color: #666;
  }

  .hub-cta > a {
    flex: 0 0 auto;
    padding: 12px 18px;
    border-radius: 10px;
    background: #111;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 900px) {
    .guides-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .guides-page {
      padding-top: 18px;
    }

    .breadcrumbs {
      margin-bottom: 30px;
    }

    .guides-grid {
      grid-template-columns: 1fr;
    }

    .guide-card {
      min-height: 250px;
    }

    .hub-cta {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
