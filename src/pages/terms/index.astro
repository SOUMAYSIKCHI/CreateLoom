<style>
  .legal {
    max-width: 850px;
    padding-top: 70px;
    padding-bottom: 100px;
  }

  .legal h1 {
    margin: 10px 0 8px;
    font-size: clamp(2.4rem, 6vw, 4rem);
    line-height: 1.05;
    letter-spacing: -.045em;
  }

  .legal h2 {
    margin: 42px 0 13px;
    font-size: 1.3rem;
    letter-spacing: -.02em;
  }

  .legal p {
    max-width: 760px;
    margin: 0 0 17px;
    color: var(--muted, #a1a1aa);
    line-height: 1.8;
  }

  .legal strong {
    color: #e4e4e7;
  }

  .legal a {
    color: #c4b5fd;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legal a:hover {
    color: #ddd6fe;
  }

  .updated {
    margin-bottom: 32px !important;
    color: #71717a !important;
    font-size: .82rem;
  }

  .notice {
    margin-top: 48px !important;
    padding: 18px 20px;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 14px;
    background: rgba(255,255,255,.025);
    font-size: .88rem;
  }

  @media (max-width: 640px) {
    .legal {
      padding-top: 45px;
      padding-bottom: 70px;
    }

    .legal h2 {
      margin-top: 34px;
    }
  }
</style>
