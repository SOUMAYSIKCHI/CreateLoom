---
import Layout from '../layouts/Layout.astro';
import prompts from '../data/prompts.json';
---

<Layout
  title="Saved AI Prompts — CreateLoom"
  description="View your saved AI image prompts on CreateLoom. Keep your favorite prompts in one place and quickly reopen, copy or share them."
  active="Favorites"
>
  <main class="favorites-page">
    <meta name="robots" content="noindex, nofollow" />
    <section class="section favorites-hero">
      <div class="container">
        <div class="eyebrow">Your collection</div>

        <h1>⭐ Saved AI Prompts</h1>

        <p class="favorites-lede">
          Keep your favorite AI image prompts in one place.
          Your saved prompts stay in this browser.
        </p>
      </div>
    </section>

    <section class="section favorites-content">
      <div class="container">
        <div id="favorites-grid" class="grid" aria-live="polite"></div>

        <div id="favorites-empty" class="empty-state" hidden>
          <div class="empty-icon" aria-hidden="true">☆</div>

          <h2>No saved prompts yet</h2>

          <p>
            Save prompts you love with the heart button and they will appear
            here automatically.
          </p>

          <a class="primary" href="/prompts/">
            Explore AI Prompts →
          </a>
        </div>

        <noscript>
          <div class="empty-state">
            <div class="empty-icon" aria-hidden="true">⚠</div>
            <h2>JavaScript is required</h2>
            <p>
              Favorites are stored locally in your browser, so JavaScript
              must be enabled to view this collection.
            </p>
          </div>
        </noscript>
      </div>
    </section>
  </main>

  <script define:vars={{ prompts }}>
    const STORAGE_KEY = 'createloom-favorites';
    const promptData = prompts;

    function getFavorites() {
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        const parsed = saved ? JSON.parse(saved) : [];
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function promptCardMarkup(p) {
      const preview =
        p.prompt.length > 190
          ? `${p.prompt.slice(0, 190).trim()}…`
          : p.prompt;

      const bestFor =
        p.best_for ||
        `AI ${p.category.toLowerCase()} image creation`;

      const tags = Array.isArray(p.tags) ? p.tags.slice(0, 3) : [];

      return `
        <article class="card prompt-card">
          <a
            class="prompt-card-image-link"
            href="/prompt/${encodeURIComponent(p.id)}/"
            aria-label="View ${escapeHtml(p.title)} result preview"
          >
            <div class="prompt-card-image-wrap">
              <img
                class="prompt-card-image"
                src="${escapeHtml(p.image || '/images/prompts/createloom.png')}"
                alt="Example result for ${escapeHtml(p.title)} AI image prompt"
                width="1080"
                height="1920"
                loading="lazy"
                decoding="async"
              />
            </div>
          </a>

          <div class="prompt-top">
            <a
              class="category-link"
              href="/prompts/${encodeURIComponent(p.category.toLowerCase())}/"
              aria-label="Browse ${escapeHtml(p.category)} AI prompts"
            >
              ${escapeHtml(p.category)}
            </a>

            <button
              class="icon-btn fav-btn"
              data-fav="${escapeHtml(p.id)}"
              type="button"
              aria-label="Remove ${escapeHtml(p.title)} from favorites"
              aria-pressed="true"
              title="Remove from favorites"
            >
              <span aria-hidden="true">♥</span>
            </button>
          </div>

          <a
            class="prompt-card-main"
            href="/prompt/${encodeURIComponent(p.id)}/"
            aria-label="Open ${escapeHtml(p.title)}"
          >
            <div class="title-row">
              <h3>${escapeHtml(p.title)}</h3>
              <span class="open-arrow" aria-hidden="true">↗</span>
            </div>

            <p class="prompt-preview">${escapeHtml(preview)}</p>

            <div class="best-for">
              <span>Best for</span>
              <strong>${escapeHtml(bestFor)}</strong>
            </div>

            ${
              tags.length
                ? `<div class="tags" aria-label="Prompt tags">
                    ${tags.map((tag) => `<span class="tag">#${escapeHtml(tag)}</span>`).join('')}
                  </div>`
                : ''
            }
          </a>

          <div class="card-actions">
            <button
              class="small-btn copy-btn"
              data-copy="${escapeHtml(p.prompt)}"
              type="button"
              aria-label="Copy ${escapeHtml(p.title)} prompt"
            >
              <span aria-hidden="true">📋</span>
              Copy
            </button>

            <button
              class="small-btn share-btn"
              data-url="/prompt/${encodeURIComponent(p.id)}/"
              type="button"
              aria-label="Share ${escapeHtml(p.title)}"
            >
              <span aria-hidden="true">🔗</span>
              Share
            </button>

            <a
              class="small-btn open-btn"
              href="/prompt/${encodeURIComponent(p.id)}/"
              aria-label="Open ${escapeHtml(p.title)}"
            >
              Open
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      `;
    }

    function renderFavorites() {
      const grid = document.querySelector('#favorites-grid');
      const empty = document.querySelector('#favorites-empty');

      if (!grid || !empty) return;

      const favoriteIds = getFavorites();
      const favoriteSet = new Set(favoriteIds);

      const savedPrompts = promptData.filter((p) => favoriteSet.has(p.id));

      grid.innerHTML = savedPrompts.map(promptCardMarkup).join('');
      empty.hidden = savedPrompts.length > 0;
    }

    document.addEventListener('click', async (event) => {
      const copyButton = event.target.closest('.copy-btn[data-copy]');

      if (copyButton) {
        try {
          await navigator.clipboard.writeText(copyButton.dataset.copy);
          const original = copyButton.innerHTML;
          copyButton.innerHTML = '<span aria-hidden="true">✓</span> Copied';
          setTimeout(() => {
            copyButton.innerHTML = original;
          }, 1400);
        } catch {}
        return;
      }

      const shareButton = event.target.closest('.share-btn[data-url]');

      if (shareButton) {
        const url = new URL(shareButton.dataset.url, window.location.origin);

        try {
          if (navigator.share) {
            await navigator.share({
              title: 'CreateLoom AI Prompt',
              url: url.href
            });
          } else {
            await navigator.clipboard.writeText(url.href);
            const original = shareButton.innerHTML;
            shareButton.innerHTML =
              '<span aria-hidden="true">✓</span> Link copied';
            setTimeout(() => {
              shareButton.innerHTML = original;
            }, 1400);
          }
        } catch {}
      }
    });

    document.addEventListener(
      'createloom:favorites-changed',
      renderFavorites
    );

    window.addEventListener('storage', (event) => {
      if (event.key === STORAGE_KEY) renderFavorites();
    });

    renderFavorites();
  </script>
</Layout>

<style>
  .favorites-hero {
    padding-bottom: 45px;
    text-align: center;
  }

  .favorites-hero h1 {
    margin: 8px 0 12px;
  }

  .favorites-lede {
    max-width: 650px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.75;
  }

  .favorites-content {
    padding-top: 25px;
  }

  /* Keep saved prompt cards identical to the main prompt grid. */
  #favorites-grid {
    width: 100%;
    min-width: 0;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #favorites-grid .prompt-card {
    min-width: 0;
    width: 100%;
  }

  .empty-state {
    max-width: 620px;
    margin: 20px auto 0;
    padding: 55px 25px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 20px;
    background: rgba(255,255,255,.02);
    text-align: center;
  }

  .empty-icon {
    margin-bottom: 15px;
    color: #c4b5fd;
    font-size: 2.5rem;
  }

  .empty-state h2 {
    margin: 0 0 10px;
  }

  .empty-state p {
    max-width: 480px;
    margin: 0 auto 24px;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
  }

  .empty-state .primary {
    display: inline-flex;
    text-decoration: none;
  }

  .prompt-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    height: 100%;
    padding: 20px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 18px;
    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.035),
        rgba(255,255,255,.018)
      );
  }

  .prompt-card-image-link {
    display: block;
    margin: -20px -20px 18px;
    color: inherit;
    text-decoration: none;
  }

  .prompt-card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 12;
    overflow: hidden;
    background: #0d0c13;
    border-bottom: 1px solid rgba(255,255,255,.075);
  }

  .prompt-card-image-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(0,0,0,0) 68%, rgba(0,0,0,.2));
  }

  .prompt-card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .prompt-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 34px;
  }

  .category-link {
    display: inline-flex;
    color: #a78bfa;
    text-decoration: none;
    font-size: .69rem;
    font-weight: 850;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .icon-btn {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(139,92,246,.38);
    border-radius: 10px;
    background: rgba(139,92,246,.11);
    color: #c4b5fd;
    cursor: pointer;
    font: inherit;
  }

  .prompt-card-main {
    display: block;
    flex: 1;
    min-width: 0;
    color: inherit;
    text-decoration: none;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .prompt-card h3 {
    flex: 1;
    margin: 15px 0 9px;
    color: #fff;
    font-size: 1.08rem;
    line-height: 1.38;
  }

  .open-arrow {
    margin-top: 17px;
    color: #a78bfa;
  }

  .prompt-preview {
    margin: 0;
    color: var(--muted, #a1a1aa);
    font-size: .87rem;
    line-height: 1.68;
  }

  .best-for {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 16px;
    padding: 11px 12px;
    border: 1px solid rgba(139,92,246,.11);
    border-radius: 10px;
    background: rgba(139,92,246,.045);
  }

  .best-for span {
    color: #85858f;
    font-size: .65rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .best-for strong {
    color: #d2d2d8;
    font-size: .77rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .tag {
    padding: 5px 8px;
    border: 1px solid rgba(255,255,255,.065);
    border-radius: 999px;
    background: rgba(255,255,255,.022);
    color: #9999a3;
    font-size: .68rem;
  }

  .card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 7px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,.055);
  }

  .small-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 34px;
    padding: 7px 10px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 9px;
    background: rgba(255,255,255,.022);
    color: #bdbdc6;
    font: inherit;
    font-size: .72rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }

  .open-btn {
    border-color: rgba(139,92,246,.22);
    color: #c4b5fd;
  }

  @media (max-width: 900px) {
    #favorites-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
  }

  @media (max-width: 650px) {
    #favorites-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    #favorites-grid .prompt-card {
      width: 100%;
    }
  }

  @media (max-width: 650px) {
    .prompt-card {
      padding: 18px;
    }

    .prompt-card-image-link {
      margin: -18px -18px 18px;
    }

    .card-actions {
      grid-template-columns: 1fr 1fr;
    }

    .open-btn {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 380px) {
    #favorites-grid {
      gap: 12px;
    }

    .prompt-card {
      padding: 16px;
    }

    .prompt-card-image-link {
      margin: -16px -16px 16px;
    }

    .card-actions {
      grid-template-columns: 1fr;
    }

    .open-btn {
      grid-column: auto;
    }
  }
</style>
