---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Contact CreateLoom"
  description="Contact CreateLoom for brand collaborations, sponsored content, partnerships and business inquiries."
>
  <section class="hero hero-compact">
    <div class="container">
      <div class="eyebrow">Get in touch</div>
      <h1>Let's work with <span class="gradient-text">CreateLoom.</span></h1>
      <p>
        For brand collaborations, sponsored content, partnerships, feedback,
        or general business inquiries.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="max-width:760px;margin:auto">
        <div class="eyebrow">Business inquiries</div>

        <h2>Let's create something together.</h2>

        <p class="muted">
          Interested in collaborating with CreateLoom? We're open to brand
          campaigns, sponsored Reels, website sponsorships, affiliate
          partnerships, and custom campaigns.
        </p>

        <div
          style="margin:28px 0;padding:24px;border:1px solid var(--border);border-radius:16px"
        >
          <p class="muted" style="margin:0 0 8px">
            For business & partnership inquiries
          </p>

          <a
            href="mailto:soumaysikchi@gmail.com"
            style="font-size:20px;font-weight:700"
          >
            soumaysikchi@gmail.com
          </a>

          <p class="muted" style="margin:10px 0 0">
            Click the email address to send us an inquiry.
          </p>
        </div>

        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a
            class="primary"
            href="mailto:soumaysikchi@gmail.com?subject=CreateLoom%20Business%20Inquiry"
          >
            Email CreateLoom →
          </a>

          <a class="secondary" href="/brands/">
            View brand opportunities →
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
