---
import Layout from '../../layouts/Layout.astro';

const contactEmail = 'soumaysikchi@gmail.com';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Create With Soumay',
  description:
    'Contact Create With Soumay for questions, feedback, partnerships, collaborations, advertising and business inquiries.',
  url: 'https://www.createwithsoumay.store/contact/',
  mainEntity: {
    '@type': 'Organization',
    name: 'Create With Soumay',
    url: 'https://www.createwithsoumay.store/',
    email: `mailto:${contactEmail}`,
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: `mailto:${contactEmail}`
    }
  }
};
---

<Layout
  title="Contact Create With Soumay | Questions, Feedback & Business Inquiries"
  description="Contact Create With Soumay for questions, feedback, AI prompt suggestions, creator resources, partnerships, advertising and business inquiries."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(contactSchema)}
  />

  <section class="hero hero-compact contact-hero">
    <div class="container">
      <div class="eyebrow">Contact</div>

      <h1>
        We'd love to
        <span class="gradient-text"> hear from you.</span>
      </h1>

      <p>
        Have a question, suggestion, correction, collaboration idea,
        partnership opportunity, or business inquiry? Get in touch with
        Create With Soumay.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-layout">

        <div class="contact-main">
          <div class="eyebrow">Get in touch</div>

          <h2>Contact Create With Soumay</h2>

          <p class="intro">
            Create With Soumay is an independent creator-focused platform
            providing AI image prompts, creative resources, Instagram
            resources, and practical guides. We welcome questions,
            suggestions, feedback, and relevant business inquiries.
          </p>

          <div class="email-box">
            <div class="email-label">
              Contact email
            </div>

            <a
              class="email"
              href={`mailto:${contactEmail}?subject=Create%20With%20Soumay%20Inquiry`}
            >
              {contactEmail}
            </a>

            <p>
              Click the email address or use the button below to start a
              conversation.
            </p>
          </div>

          <div class="actions">
            <a
              class="primary"
              href={`mailto:${contactEmail}?subject=Create%20With%20Soumay%20Inquiry`}
            >
              Email Us →
            </a>

            <a class="secondary" href="/about/">
              About Create With Soumay →
            </a>
          </div>
        </div>

        <aside class="contact-side">
          <div class="eyebrow">What can you contact us about?</div>

          <div class="inquiry-list">

            <div>
              <strong>General Questions: </strong>
              <span>
                Questions about the website, prompts, resources or published
                content.
              </span>
            </div>

            <div>
              <strong>Feedback & Suggestions: </strong>
              <span>
                Suggestions for improving the website or ideas for future
                resources.
              </span>
            </div>

            <div>
              <strong>Content Corrections: </strong>
              <span>
                Let us know if you find an error, outdated information or
                something that needs clarification.
              </span>
            </div>

            <div>
              <strong>Brand Collaborations: </strong>
              <span>
                Relevant partnerships, campaigns and creator-focused
                collaborations.
              </span>
            </div>

            <div>
              <strong>Advertising & Sponsorships: </strong>
              <span>
                Advertising opportunities and sponsored content inquiries
                relevant to our audience.
              </span>
            </div>

            <div>
              <strong>Other Business Inquiries: </strong>
              <span>
                Partnerships, affiliate opportunities and other legitimate
                business proposals.
              </span>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card">
        <h2>For business inquiries</h2>

        <p>
          If you are contacting us about a collaboration, advertising
          opportunity, sponsorship or partnership, please include enough
          information for us to understand your proposal.
        </p>

        <ul>
          <li>Your name and organization or brand</li>
          <li>The type of collaboration or inquiry</li>
          <li>A brief description of the opportunity</li>
          <li>Relevant website or social media links, if applicable</li>
          <li>Any important campaign details or requirements</li>
        </ul>

        <p>
          Providing clear information helps us understand the request and
          respond appropriately.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card">
        <h2>Before contacting us</h2>

        <p>
          If you are looking for information about Create With Soumay,
          you may also find the following pages useful:
        </p>

        <div class="actions">
          <a class="secondary" href="/about/">About Us →</a>
          <a class="secondary" href="/privacy/">Privacy Policy →</a>
          <a class="secondary" href="/terms/">Terms & Conditions →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="brand-cta">
        <div class="eyebrow">Creators & brands</div>

        <h2>Have an idea worth discussing?</h2>

        <p>
          Whether you have feedback about the platform or a relevant
          collaboration opportunity, send us the details and we'll take a
          look.
        </p>

        <a
          class="primary"
          href={`mailto:${contactEmail}?subject=Create%20With%20Soumay%20Inquiry`}
        >
          Start a Conversation →
        </a>
      </div>
    </div>
  </section>
</Layout>
