---
import Layout from '../layouts/Layout.astro';
import PromptCard from '../components/PromptCard.astro';
import prompts from '../data/prompts.json';
import blogs from '../data/blogs.json';
import { isPublished } from '../lib/publication.js';

const siteUrl = (Astro.site || 'https://www.createwithsoumay.store').toString().replace(/\/$/, '');

const categories = [...new Set(prompts.map((p) => p.category))].sort();

const categoryCounts = {};
prompts.forEach((p) => {
  categoryCounts[p.category] = (categoryCounts[p.category] || 0) + 1;
});

const trendPriority = {
  hot: 0,
  current: 1,
  rising: 2,
  seasonal: 3,
  evergreen: 4
};

const trendingPrompts = prompts
  .filter((p) => p.trending === true)
  .sort((a, b) => {
    const priorityA = trendPriority[a.trendStatus] ?? 99;
    const priorityB = trendPriority[b.trendStatus] ?? 99;

    if (priorityA !== priorityB) {
      return priorityA - priorityB;
    }

    return String(b.createdAt || '').localeCompare(
      String(a.createdAt || '')
    );
  });

const latestPrompts = [...prompts]
  .filter((p) => p.createdAt)
  .sort((a, b) =>
    String(b.createdAt).localeCompare(String(a.createdAt))
  );

const latestBlogs = blogs.filter((blog) => isPublished(blog.date)).slice(0, 3);

const categoryDescriptions = {
  Couple: 'Romantic portraits, mirror selfies and cinematic couple concepts.',
  Vintage: 'Retro film, Polaroid and nostalgic photography concepts.',
  Cinematic: 'Dramatic lighting, rain, neon and cinematic portrait ideas.',
  Wedding: 'Wedding, traditional and elegant couple photography.',
  Travel: 'Travel, airport, beach and destination photography.',
  Aesthetic: 'Soft, cozy, luxury and lifestyle-inspired visuals.',
  Friends: 'Best-friend selfies, group photos and lifestyle concepts.',
  Selfie: 'Mirror selfies, car selfies and realistic social portraits.',
  Fashion: 'Streetwear, editorial, luxury and studio fashion concepts.',
  Portrait: 'Professional, dramatic and realistic portrait photography.',
  Anime: 'Anime, chibi and illustrated character concepts.',
  Festival: 'Festive and traditional portrait concepts.',
  Celebration: 'Birthday and special-event photography ideas.'
};
---

<Layout
  title="100+ Free AI Image Prompts | Gemini, ChatGPT & Nano Banana"
  description="Explore 100+ free AI image prompts and copy-paste photo prompts for Gemini, ChatGPT and Nano Banana. Discover couple, saree, festival, selfie and fashion prompts for Instagram and more."
  active="Home"
>

  <!-- HERO -->

  <section class="hero homepage-hero">

    <div class="container">

      <div class="eyebrow">
        AI prompts · creator resources
      </div>

      <h1>
        Free AI Image Prompts for Gemini, ChatGPT & Nano Banana &amp;
        <span class="gradient-text">Creator Tools</span>
      </h1>

      <p class="hero-lede">
        Discover free, copy-ready AI image prompts for Gemini, ChatGPT and Nano Banana.
        Create realistic AI photos, couple portraits, saree looks, festival images,
        selfies and fashion photos for Instagram and more.
      </p>

      <form
        class="search homepage-search"
        action="/search/"
        role="search"
      >

        <input
          name="q"
          placeholder="Search couple, selfie, fashion, Instagram..."
          aria-label="Search prompts, blogs and creator resources"
        />

        <button type="submit">
          Search
        </button>

      </form>

      <div class="hero-popular" aria-label="Popular prompt categories">
        <a href="/prompts/couple/">Couple</a>
        <a href="/prompts/navratri/">Navratri</a>
        <a href="/prompts/saree/">Saree</a>
        <a href="/prompts/festival/">Festival</a>
      </div>

      <div class="hero-actions">

        <a
          class="primary"
          href="/prompts/"
        >
          Explore AI Prompts →
        </a>

        <a
          class="secondary"
          href="/creator-hub/"
        >
          Creator Hub
        </a>

      </div>

      <div class="hero-stats">

        <div>
          <strong>{prompts.length}+</strong>
          <span>AI Prompts</span>
        </div>

        <div>
          <strong>{categories.length}</strong>
          <span>Categories</span>
        </div>

        <div>
          <strong>{blogs.length}+</strong>
          <span>Creator Guides</span>
        </div>

        <div>
          <strong>Free</strong>
          <span>Resources</span>
        </div>

      </div>

    </div>

  </section>


  <!-- TRENDING PROMPTS -->

  {trendingPrompts.length > 0 && (
    <section class="section trending-section" id="trending">

      <div class="container">

        <div class="section-head">

          <div>
            <div class="eyebrow">
              🔥 Popular right now
            </div>

            <h2>
              Trending AI Prompts
            </h2>

            <p class="section-subtitle">
              Fresh and popular AI image prompts worth trying right now.
            </p>
          </div>

          <a
            class="muted section-link"
            href="/prompts/"
          >
            Explore all →
          </a>

        </div>


        <div class="grid">

          {trendingPrompts.slice(0, 6).map((p) => (
            <PromptCard p={p} />
          ))}

        </div>

      </div>

    </section>
  )}



  <!-- CATEGORY EXPLORER -->

  <section
    class="section category-section"
    id="categories"
  >

    <div class="container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            Explore the library
          </div>

          <h2>
            Browse AI Prompt Categories
          </h2>

          <p class="section-subtitle">
            Find a visual style that matches your idea.
          </p>
        </div>

        <a
          class="muted section-link"
          href="/prompts/"
        >
          Browse all prompt categories →
        </a>

      </div>


      <div class="category-grid">

        {categories.map((category) => (

          <a
            class="category-card"
            href={`/prompts/${encodeURIComponent(category.toLowerCase())}/`}
          >

            <div class="category-card-top">

              <strong>
                {category}
              </strong>

              <span>
                {categoryCounts[category]}
              </span>

            </div>

            <p>
              {categoryDescriptions[category] ||
                `Explore ${category.toLowerCase()} AI image prompts.`}
            </p>

            <span class="category-link">
              Explore →
            </span>

          </a>

        ))}

      </div>

    </div>

  </section>


  <!-- LATEST PROMPTS -->

  <section
    class="section"
    id="latest"
  >

    <div class="container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            More ideas
          </div>

          <h2>
            Latest Prompt Additions
          </h2>

          <p class="section-subtitle">
            Recently added AI image prompts to explore and customize.
          </p>
        </div>

        <a
          class="muted section-link"
          href="/prompts/"
        >
          Explore all →
        </a>

      </div>

      <div class="grid">

        {latestPrompts.slice(0, 3).map((p) => (
          <PromptCard p={p} />
        ))}

      </div>

    </div>

  </section>


  <!-- CREATOR HUB -->

  <section class="section creator-section">

    <div class="container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            Beyond prompts
          </div>

          <h2>
            Build Better Content
          </h2>

          <p class="section-subtitle">
            Practical resources for creators working on Instagram
            and visual content.
          </p>
        </div>

        <a
          class="muted section-link"
          href="/creator-hub/"
        >
          Open Creator Hub →
        </a>

      </div>


      <div class="resource-grid">

        <a
          class="resource-card"
          href="/creator-tools/trending-hashtags/"
          aria-label="Trending Instagram Hashtags — curated hashtag sets for Reels and creators"
        >

          <span class="resource-icon">
            #
          </span>

          <div class="eyebrow">
            Instagram
          </div>

          <h3>
            Trending Instagram Hashtags
          </h3>

          <p>
            Find curated hashtag sets by topic for Instagram posts and Reels.
          </p>

          <strong>
            Explore hashtags →
          </strong>

        </a>


        <a
          class="resource-card"
          href="/creator-hub/#reel-ideas"
        >

          <span class="resource-icon">
            🎬
          </span>

          <div class="eyebrow">
            Content
          </div>

          <h3>
            Reel Ideas
          </h3>

          <p>
            Repeatable concepts and formats for your next
            Instagram Reel.
          </p>

          <strong>
            Explore ideas →
          </strong>

        </a>


        <a
          class="resource-card"
          href="/creator-hub/#growth"
        >

          <span class="resource-icon">
            📈
          </span>

          <div class="eyebrow">
            Growth
          </div>

          <h3>
            Instagram Growth
          </h3>

          <p>
            Practical resources for improving your profile,
            content and creator strategy.
          </p>

          <strong>
            Learn more →
          </strong>

        </a>


      </div>

    </div>

  </section>



  <!-- FINAL CTA -->

  <section class="section">

    <div class="container">

      <div class="homepage-cta">

        <div class="eyebrow">
          Start creating
        </div>

        <h2>
          Your next idea starts with a prompt.
        </h2>

        <p>
          Explore detailed AI image prompts and find a starting
          point for your next creation.
        </p>

        <div class="cta-actions">

          <a
            class="primary"
            href="/prompts/"
          >
            Explore Prompts →
          </a>

          <a
            class="secondary"
            href="/blog/"
          >
            Read Creator Guides
          </a>

        </div>

      </div>

    </div>

  </section>



  <!-- Homepage structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Create With Soumay | AI Image Prompts & Creator Tools',
      description:
        'Free AI image prompts, Instagram creator tools, Reel ideas and practical guides from Create With Soumay.',
      url: `${siteUrl}/`,
      mainEntityOfPage: `${siteUrl}/`,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Create With Soumay',
        url: `${siteUrl}/`
      },
      about: [
        'AI image prompts',
        'Instagram creator tools',
        'Instagram content ideas',
        'AI image creation'
      ],
      publisher: {
        '@type': 'Organization',
        name: 'Create With Soumay',
        url: `${siteUrl}/`,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}/images/createloom-logo.png`
        }
      }
    })}
  />



</Layout>


<style>

  /* Hero */

  .homepage-hero {
    padding-bottom: 65px;
  }


  .homepage-hero h1 {
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
    font-size: clamp(2.1rem, 4vw, 3.15rem);
    line-height: 1.12;
  }

  .hero-lede {
    max-width: 720px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    font-size: 1.08rem;
    line-height: 1.8;
  }


  .homepage-search {
    max-width: 720px;
    margin: 28px auto 0;
  }


  .hero-popular {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 14px auto 0;
  }

  .hero-popular a {
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 999px;
    background: rgba(255,255,255,0.025);
    color: #a78bfa;
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .hero-popular a:hover {
    background: rgba(139,92,246,0.08);
    border-color: rgba(139,92,246,0.38);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }


  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 35px;
    margin-top: 32px;
  }


  .hero-stats div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-align: center;
  }


  .hero-stats strong {
    color: #fff;
    font-size: 1.1rem;
  }


  .hero-stats span {
    color: var(--muted, #a1a1aa);
    font-size: 0.72rem;
  }


  /* Shared sections */

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 25px;
  }


  .section-head h2 {
    margin: 7px 0 5px;
  }


  .section-subtitle {
    margin: 0;
    color: var(--muted, #a1a1aa);
    line-height: 1.6;
  }


  .section-link {
    white-space: nowrap;
    text-decoration: none;
  }


  /* Trending */

  .trending-section {
    background:
      linear-gradient(
        180deg,
        rgba(139,92,246,0.045),
        rgba(255,255,255,0.012)
      );
    border-top: 1px solid rgba(255,255,255,0.035);
    border-bottom: 1px solid rgba(255,255,255,0.035);
  }

  /* Categories */

  .category-section {
    background: rgba(255,255,255,0.015);
  }


  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }


  .category-card {
    display: block;
    padding: 18px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    background: rgba(255,255,255,0.02);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }


  .category-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,0.38);
    background: rgba(139,92,246,0.05);
  }


  .category-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }


  .category-card-top strong {
    color: #fff;
  }


  .category-card-top span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 25px;
    height: 25px;
    padding: 0 6px;
    border-radius: 999px;
    background: rgba(139,92,246,0.1);
    color: #c4b5fd;
    font-size: 0.7rem;
    font-weight: 800;
  }


  .category-card p {
    margin: 12px 0;
    color: var(--muted, #a1a1aa);
    font-size: 0.78rem;
    line-height: 1.6;
  }


  .category-link {
    color: #c4b5fd;
    font-size: 0.78rem;
    font-weight: 700;
  }


  /* Creator resources */

  .creator-section {
    background: rgba(255,255,255,0.015);
  }


  .resource-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 13px;
  }


  .resource-card {
    display: flex;
    flex-direction: column;
    min-height: 240px;
    padding: 21px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 17px;
    background: rgba(255,255,255,0.02);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }


  .resource-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,0.35);
  }


  .resource-icon {
    margin-bottom: 15px;
    font-size: 1.55rem;
  }


  .resource-card h3 {
    margin: 6px 0 8px;
  }


  .resource-card p {
    margin: 0;
    color: var(--muted, #a1a1aa);
    font-size: 0.84rem;
    line-height: 1.65;
  }


  .resource-card strong {
    margin-top: auto;
    padding-top: 18px;
    color: #c4b5fd;
    font-size: 0.8rem;
  }



  /* CTA */

  .homepage-cta {
    padding: 48px 25px;
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 23px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.13),
        rgba(255,255,255,0.025)
      );
    text-align: center;
  }


  .homepage-cta h2 {
    margin: 8px 0 10px;
  }


  .homepage-cta p {
    max-width: 620px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
  }


  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 22px;
  }


  .cta-actions a {
    text-decoration: none;
  }


  /* Responsive */

  @media (max-width: 950px) {

    .category-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .resource-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }

  }


  @media (max-width: 700px) {

    .category-grid,
    .article-grid {
      grid-template-columns: 1fr;
    }

    .section-head {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero-stats {
      gap: 24px;
    }

  }


  @media (max-width: 700px) {
    .homepage-hero h1 {
      font-size: 2rem;
      line-height: 1.15;
    }
  }

  @media (max-width: 500px) {

    .resource-grid {
      grid-template-columns: 1fr;
    }

    .hero-actions,
    .cta-actions {
      flex-direction: column;
    }

    .hero-actions a,
    .cta-actions a {
      justify-content: center;
    }

  }

</style>
