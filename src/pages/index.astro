          href="/prompts/"
        >
          Explore all →
        </a>

      </div>

      <div class="grid">

        {latestPrompts.slice(0, 3).map((p) => (
          <PromptCard p={p} />
        ))}

      </div>

    </div>

  </section>


  <!-- CREATOR HUB -->

  <section class="section creator-section">

    <div class="container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            Beyond prompts
          </div>

          <h2>
            Build Better Content
          </h2>

          <p class="section-subtitle">
            Practical resources for creators working on Instagram
            and visual content.
          </p>
        </div>

        <a
          class="muted section-link"
          href="/creator-hub/"
        >
          Creator Hub →
        </a>

      </div>


      <div class="resource-grid">

        <a
          class="resource-card"
          href="/creator-tools/trending-hashtags/"
          aria-label="Trending Instagram Hashtags — curated hashtag sets for Reels and creators"
        >

          <span class="resource-icon">
            #
          </span>

          <div class="eyebrow">
            Instagram
          </div>

          <h3>
            Trending Instagram Hashtags
          </h3>

          <p>
            Find curated hashtag sets by topic for Instagram posts and Reels.
          </p>

          <strong>
            Explore hashtags →
          </strong>

        </a>


        <a
          class="resource-card"
          href="/creator-hub/#reels"
        >

          <span class="resource-icon">
            🎬
          </span>

          <div class="eyebrow">
            Content
          </div>

          <h3>
            Reel Ideas
          </h3>

          <p>
            Repeatable concepts and formats for your next
            Instagram Reel.
          </p>

          <strong>
            Explore ideas →
          </strong>

        </a>


        <a
          class="resource-card"
          href="/creator-hub/#growth"
        >

          <span class="resource-icon">
            📈
          </span>

          <div class="eyebrow">
            Growth
          </div>

          <h3>
            Instagram Growth
          </h3>

          <p>
            Practical resources for improving your profile,
            content and creator strategy.
          </p>

          <strong>
            Learn more →
          </strong>

        </a>


        <a
          class="resource-card"
          href="/creator-hub/#brand-deals"
        >

          <span class="resource-icon">
            🤝
          </span>

          <div class="eyebrow">
            Business
          </div>

          <h3>
            Brand Deals
          </h3>

          <p>
            Learn how to position your profile and approach
            potential brand partners.
          </p>

          <strong>
            Explore resources →
          </strong>

        </a>


        <a
          class="resource-card"
          href="/creator-hub/#captions"
        >

          <span class="resource-icon">
            ✍️
          </span>

          <div class="eyebrow">
            Writing
          </div>

          <h3>
            Hooks & Captions
          </h3>

          <p>
            Ideas for making your content clearer, stronger
            and easier to package.
          </p>

          <strong>
            Get ideas →
          </strong>

        </a>

      </div>

    </div>

  </section>


  <!-- RELATED CREATOR TOOLS -->

  <section class="section related-tools-section">

    <div class="container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            More creator tools
          </div>

          <h2>
            Tools & Resources for Instagram Creators
          </h2>

          <p class="section-subtitle">
            Continue from prompts into hashtag research, creator guides and content resources.
          </p>
        </div>

        <a
          class="muted section-link"
          href="/creator-hub/"
        >
          Open Creator Hub →
        </a>

      </div>

      <div class="related-tools-links">
        <a href="/creator-tools/trending-hashtags/">
          Trending Instagram Hashtags
        </a>
        <a href="/creator-hub/">
          Instagram Creator Hub
        </a>
        <a href="/blog/">
          Creator Guides
        </a>
        <a href="/prompts/">
          AI Prompt Library
        </a>
      </div>

    </div>

  </section>


  <!-- BLOG -->

  <section class="section">

    <div class="container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            Learn something useful
          </div>

          <h2>
            Creator Guides
          </h2>

          <p class="section-subtitle">
            Practical articles about AI, Instagram and creator growth.
          </p>
        </div>

        <a
          class="muted section-link"
          href="/blog/"
        >
          Read all →
        </a>

      </div>


      <div class="article-grid">

        {latestBlogs.map((blog) => (

          <a
            class="article-card"
            href={`/blog/${blog.id}/`}
          >

            <div class="article-card-top">

              <span class="eyebrow">
                {blog.category}
              </span>

              <span>
                ↗
              </span>

            </div>

            <h3>
              {blog.title}
            </h3>

            <p>
              {blog.excerpt}
            </p>

            <div class="article-meta">
              {blog.readTime} · {blog.date}
            </div>

            <strong>
              Read guide →
            </strong>

          </a>

        ))}

      </div>

    </div>

  </section>


  <!-- WHY CREATELOOM -->

  <section class="section about-section">

    <div class="container">

      <div class="about-grid">

        <div>

          <div class="eyebrow">
            Why CreateLoom
          </div>

          <h2>
            A practical home for AI creation and creator resources.
          </h2>

        </div>

        <div>

          <p>
            CreateLoom brings ready-to-use AI image prompts together
            with practical resources for creators. Instead of searching
            through scattered examples, you can find a prompt, copy it,
            customize it and move directly into your creative workflow.
          </p>

          <p>
            The library covers concepts such as couples, selfies,
            portraits, fashion, vintage photography, anime, travel
            and more. The Creator Hub and blog provide additional
            resources for content ideas, Instagram strategy and
            creator growth.
          </p>

          <a
            href="/about/"
            class="text-link"
          >
            Learn more about CreateLoom →
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- FAQ -->

  <section class="section">

    <div class="container faq-container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            Quick answers
          </div>

          <h2>
            Frequently Asked Questions
          </h2>
        </div>

      </div>


      <div class="faq">

        <details>
          <summary>
            What is CreateLoom?
          </summary>

          <p>
            CreateLoom is a creator-focused library of AI image
            prompts, practical guides and resources for Instagram
            and visual content creation.
          </p>
        </details>


        <details>
          <summary>
            Can I copy the AI prompts?
          </summary>

          <p>
            Yes. Individual prompt pages include a copy button so
            you can quickly copy the complete prompt and customize
            it for your preferred AI image generator.
          </p>
        </details>


        <details>
          <summary>
            Can I share a specific prompt?
          </summary>

          <p>
            Yes. Every prompt has its own URL, making it easy to
            share a specific prompt with someone through a message,
            social post or Instagram workflow.
          </p>
        </details>


        <details>
          <summary>
            Are CreateLoom prompts free?
          </summary>

          <p>
            CreateLoom provides free prompt resources. The AI
            generation service you choose may have its own plans,
            limits or pricing.
          </p>
        </details>

      </div>

    </div>

  </section>


  <!-- FINAL CTA -->

  <section class="section">

    <div class="container">

      <div class="homepage-cta">

        <div class="eyebrow">
          Start creating
        </div>

        <h2>
          Your next idea starts with a prompt.
        </h2>

        <p>
          Explore detailed AI image prompts and find a starting
          point for your next creation.
        </p>

        <div class="cta-actions">

          <a
            class="primary"
            href="/prompts/"
          >
            Explore Prompts →
          </a>

          <a
            class="secondary"
            href="/blog/"
          >
            Read Creator Guides
          </a>

        </div>

      </div>

    </div>

  </section>



  <!-- Homepage structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'CreateLoom — AI Image Prompts & Creator Resources',
      description:
        'Discover detailed AI image prompts, Instagram creator resources and practical guides on CreateLoom.',
      url: 'https://createloom.vercel.app/',
      isPartOf: {
        '@type': 'WebSite',
        name: 'CreateLoom',
        url: 'https://createloom.vercel.app/'
      },
      about: [
        'AI image prompts',
        'Instagram creator resources',
        'Instagram content ideas',
        'AI image creation'
      ]
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What is CreateLoom?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'CreateLoom is a creator-focused library of AI image prompts, practical guides and resources for Instagram and visual content creation.'
          }
        },
        {
          '@type': 'Question',
          name: 'Can I copy the AI prompts?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Individual prompt pages include a copy button so you can quickly copy the complete prompt and customize it for your preferred AI image generator.'
          }
        },
        {
          '@type': 'Question',
          name: 'Can I share a specific prompt?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Yes. Every prompt has its own URL, making it easy to share a specific prompt through a message, social post or Instagram workflow.'
          }
        },
        {
          '@type': 'Question',
          name: 'Are CreateLoom prompts free?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'CreateLoom provides free prompt resources. The AI generation service you choose may have its own plans, limits or pricing.'
          }
        }
      ]
    })}
  />

</Layout>


<style>

  /* Hero */

  .homepage-hero {
    padding-bottom: 65px;
  }


  .hero-lede {
    max-width: 720px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    font-size: 1.08rem;
    line-height: 1.8;
  }


  .homepage-search {
    max-width: 720px;
    margin: 28px auto 0;
  }


  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }


  .hero-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 35px;
    margin-top: 32px;
  }


  .hero-stats div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-align: center;
  }


  .hero-stats strong {
    color: #fff;
    font-size: 1.1rem;
  }


  .hero-stats span {
    color: var(--muted, #a1a1aa);
    font-size: 0.72rem;
  }


  /* Shared sections */

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 25px;
  }


  .section-head h2 {
    margin: 7px 0 5px;
  }


  .section-subtitle {
    margin: 0;
    color: var(--muted, #a1a1aa);
    line-height: 1.6;
  }


  .section-link {
    white-space: nowrap;
    text-decoration: none;
  }


  /* Trending */

  .trending-section {
    background:
      linear-gradient(
        180deg,
        rgba(139,92,246,0.045),
        rgba(255,255,255,0.012)
      );
    border-top: 1px solid rgba(255,255,255,0.035);
    border-bottom: 1px solid rgba(255,255,255,0.035);
  }

  /* Categories */

  .category-section {
    background: rgba(255,255,255,0.015);
  }


  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }


  .category-card {
    display: block;
    padding: 18px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 16px;
    background: rgba(255,255,255,0.02);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }


  .category-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,0.38);
    background: rgba(139,92,246,0.05);
  }


  .category-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }


  .category-card-top strong {
    color: #fff;
  }


  .category-card-top span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 25px;
    height: 25px;
    padding: 0 6px;
    border-radius: 999px;
    background: rgba(139,92,246,0.1);
    color: #c4b5fd;
    font-size: 0.7rem;
    font-weight: 800;
  }


  .category-card p {
    margin: 12px 0;
    color: var(--muted, #a1a1aa);
    font-size: 0.78rem;
    line-height: 1.6;
  }


  .category-link {
    color: #c4b5fd;
    font-size: 0.78rem;
    font-weight: 700;
  }


  /* Creator resources */

  .creator-section {
    background: rgba(255,255,255,0.015);
  }


  .resource-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 13px;
  }


  .resource-card {
    display: flex;
    flex-direction: column;
    min-height: 240px;
    padding: 21px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 17px;
    background: rgba(255,255,255,0.02);
    color: inherit;
    text-decoration: none;
