    border-color: rgba(139,92,246,0.38);
  }


  .article-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #a78bfa;
  }


  .article-card h3 {
    margin: 16px 0 10px;
    line-height: 1.4;
  }


  .article-card p {
    margin: 0;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
    font-size: 0.88rem;
  }


  .article-meta {
    margin-top: auto;
