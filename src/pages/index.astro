    border-color: rgba(139,92,246,0.35);
    background: rgba(139,92,246,0.05);
  }


  /* Articles */

  .article-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
  }


  .article-card {
    display: flex;
    flex-direction: column;
    min-height: 270px;
    padding: 22px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 17px;
