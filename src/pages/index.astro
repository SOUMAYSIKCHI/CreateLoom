---
import Layout from '../layouts/Layout.astro';
import PromptCard from '../components/PromptCard.astro';
import prompts from '../data/prompts.json';
import blogs from '../data/blogs.json';

const categories = [...new Set(prompts.map((p) => p.category))].sort();

const featuredPrompts = prompts.slice(0, 6);

const trendPriority = {
  hot: 0,
  current: 1,
  rising: 2,
  seasonal: 3,
  evergreen: 4
};

const trendingPrompts = prompts
  .filter((p) => p.trending === true)
  .sort((a, b) => {
    const priorityA = trendPriority[a.trendStatus] ?? 99;
    const priorityB = trendPriority[b.trendStatus] ?? 99;

    if (priorityA !== priorityB) {
      return priorityA - priorityB;
    }

    return String(b.createdAt || '').localeCompare(
      String(a.createdAt || '')
    );
  });

const latestPrompts = [...prompts]
  .filter((p) => p.createdAt)
  .sort((a, b) =>
    String(b.createdAt).localeCompare(String(a.createdAt))
  );

const latestBlogs = blogs.slice(0, 3);

const categoryDescriptions = {
  Couple: 'Romantic portraits, mirror selfies and cinematic couple concepts.',
  Vintage: 'Retro film, Polaroid and nostalgic photography concepts.',
  Cinematic: 'Dramatic lighting, rain, neon and cinematic portrait ideas.',
  Wedding: 'Wedding, traditional and elegant couple photography.',
  Travel: 'Travel, airport, beach and destination photography.',
  Aesthetic: 'Soft, cozy, luxury and lifestyle-inspired visuals.',
  Friends: 'Best-friend selfies, group photos and lifestyle concepts.',
  Selfie: 'Mirror selfies, car selfies and realistic social portraits.',
  Fashion: 'Streetwear, editorial, luxury and studio fashion concepts.',
  Portrait: 'Professional, dramatic and realistic portrait photography.',
  Anime: 'Anime, chibi and illustrated character concepts.',
  Festival: 'Festive and traditional portrait concepts.',
  Celebration: 'Birthday and special-event photography ideas.'
};
---

<Layout
  title="CreateLoom — AI Image Prompts & Creator Resources"
  description="Discover detailed AI image prompts, Instagram creator resources and practical guides on CreateLoom. Copy prompts for couples, selfies, portraits, fashion, anime, vintage photography and more."
  active="Home"
>

  <!-- HERO -->

  <section class="hero homepage-hero">

    <div class="container">

      <div class="eyebrow">
        AI prompts · creator resources
      </div>

      <h1>
        Create.
        <span class="gradient-text">Inspire.</span>
        Repeat.
      </h1>

      <p class="hero-lede">
        Discover detailed AI image prompts and practical creator
        resources designed to turn your ideas into better content.
      </p>

      <form
        class="search homepage-search"
        action="/search/"
        role="search"
      >

        <input
          name="q"
          placeholder="Search couple, selfie, fashion, Instagram..."
          aria-label="Search prompts, blogs and creator resources"
        />

        <button type="submit">
          Search
        </button>

      </form>

      <div class="hero-actions">

        <a
          class="primary"
          href="/prompts/"
        >
          Explore AI Prompts →
        </a>

        <a
          class="secondary"
          href="/creator-hub/"
        >
          Creator Hub
        </a>

      </div>

      <div class="hero-stats">

        <div>
          <strong>{prompts.length}+</strong>
          <span>AI Prompts</span>
        </div>

        <div>
          <strong>{categories.length}</strong>
          <span>Categories</span>
        </div>

        <div>
          <strong>{blogs.length}+</strong>
          <span>Creator Guides</span>
        </div>

        <div>
          <strong>Free</strong>
          <span>Resources</span>
        </div>

      </div>

    </div>

  </section>


  <!-- TRENDING PROMPTS -->

  {trendingPrompts.length > 0 && (
    <section class="section trending-section" id="trending">

      <div class="container">

        <div class="section-head">

          <div>
            <div class="eyebrow">
              🔥 Popular right now
            </div>

            <h2>
              Trending AI Prompts
            </h2>

            <p class="section-subtitle">
              Fresh and popular AI image prompts worth trying right now.
            </p>
          </div>

          <a
            class="muted section-link"
            href="/prompts/"
          >
            Explore all →
          </a>

        </div>


        <div class="grid">

          {trendingPrompts.slice(0, 6).map((p) => (
            <PromptCard p={p} />
          ))}

        </div>

      </div>

    </section>
  )}


  <!-- FEATURED PROMPTS -->

  <section class="section">

    <div class="container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            Start creating
          </div>

          <h2>
            Featured AI Prompts
          </h2>

          <p class="section-subtitle">
            Detailed starting points for your next AI image.
          </p>
        </div>

        <a
          class="muted section-link"
          href="/prompts/"
        >
          View all →
        </a>

      </div>

      <div class="grid">

        {featuredPrompts.slice(0, 3).map((p) => (
          <PromptCard p={p} />
        ))}

      </div>

    </div>

  </section>


  <!-- CATEGORY EXPLORER -->

  <section
    class="section category-section"
    id="categories"
  >

    <div class="container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            Explore the library
          </div>

          <h2>
            Browse AI Prompt Categories
          </h2>

          <p class="section-subtitle">
            Find a visual style that matches your idea.
          </p>
        </div>

        <a
          class="muted section-link"
          href="/prompts/"
        >
          Full library →
        </a>

      </div>


      <div class="category-grid">

        {categories.map((category) => (

          <a
            class="category-card"
            href={`/prompts/${encodeURIComponent(category.toLowerCase())}/`}
          >

            <div class="category-card-top">

              <strong>
                {category}
              </strong>

              <span>
                {prompts.filter(
                  (p) => p.category === category
                ).length}
              </span>

            </div>

            <p>
              {categoryDescriptions[category] ||
                `Explore ${category.toLowerCase()} AI image prompts.`}
            </p>

            <span class="category-link">
              Explore →
            </span>

          </a>

        ))}

      </div>

    </div>

  </section>


  <!-- LATEST PROMPTS -->

  <section
    class="section"
    id="latest"
  >

    <div class="container">

      <div class="section-head">

        <div>
          <div class="eyebrow">
            More ideas
          </div>

          <h2>
            Latest Prompt Additions
          </h2>

          <p class="section-subtitle">
            Recently added AI image prompts to explore and customize.
          </p>
        </div>

        <a
