---
import Layout from '../layouts/Layout.astro'; import PromptCard from '../components/PromptCard.astro'; import prompts from '../data/prompts.json'; import blogs from '../data/blogs.json';
const categories=[...new Set(prompts.map(p=>p.category))].sort();
---
<Layout title="CreateLoom — AI Prompts & Creator Resources" description="Discover ready-to-copy AI prompts, Instagram creator resources and practical guides on CreateLoom." active="Home">
<section class="hero"><div class="container"><div class="eyebrow">AI prompts · creator resources</div><h1>Create. <span class="gradient-text">Inspire.</span> Repeat.</h1><p>Discover powerful AI prompts and practical creator resources designed to turn your ideas into something amazing.</p><form class="search" action="/search/" role="search"><input name="q" placeholder="Search prompts, blogs & creator resources..." aria-label="Search prompts, blogs and creator resources"/><button>Search</button></form><div class="actions"><a class="primary" href="/prompts/">Explore Prompts</a><a class="secondary" href="/creator-hub/">Creator Hub</a></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Fresh ideas</div><h2>Trending Prompts</h2></div><a class="muted" href="/prompts/">View all →</a></div><div class="grid">{prompts.slice(0,3).map(p=><PromptCard p={p}/>)}</div></div></section>
<section class="section" id="categories"><div class="container"><div class="section-head"><div><div class="eyebrow">Explore</div><h2>Browse Categories</h2></div></div><div class="category-grid">{categories.map(c=><a class="category" href={`/prompts/${encodeURIComponent(c.toLowerCase())}/`}>{c}</a>)}</div></div></section>
<section class="section" id="latest"><div class="container"><div class="section-head"><div><div class="eyebrow">Fresh from CreateLoom</div><h2>Latest Prompts</h2></div><a class="muted" href="/prompts/">Explore →</a></div><div class="grid">{prompts.slice(-3).reverse().map(p=><PromptCard p={p}/>)}</div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Creator resources</div><h2>Build Better Content</h2></div><a class="muted" href="/creator-hub/">Explore →</a></div><div class="resource-grid"><a class="resource" href="/creator-hub/#reels"><div class="eyebrow">Content</div><h3>🎬 Reel Ideas</h3><p>Repeatable formats and concepts for your next Instagram Reel.</p></a><a class="resource" href="/creator-hub/#growth"><div class="eyebrow">Growth</div><h3>📈 Instagram Growth</h3><p>Practical resources for improving your creator profile and content strategy.</p></a><a class="resource" href="/creator-hub/#brand-deals"><div class="eyebrow">Business</div><h3>🤝 Brand Deals</h3><p>Learn how to position your profile and approach potential brand partners.</p></a><a class="resource" href="/creator-hub/#captions"><div class="eyebrow">Writing</div><h3>✍️ Hooks & Captions</h3><p>Ideas to make your content clearer, stronger and easier to package.</p></a></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">From the blog</div><h2>Latest Articles</h2></div><a class="muted" href="/blog/">Read all →</a></div><div class="grid">{blogs.slice(0,3).map(b=><a class="card" href={`/blog/${b.id}/`}><span class="eyebrow">{b.category}</span><h3>{b.title}</h3><p>{b.excerpt}</p><div class="muted" style="margin-top:14px;font-size:13px">{b.readTime} · {b.date}</div></a>)}</div></div></section>
<section class="section"><div class="container"><div class="card seo-copy"><div class="eyebrow">CreateLoom</div><h2>AI prompts and creator resources in one place.</h2><p>Explore ready-to-copy prompts for AI image creation, then use the CreateLoom Creator Hub for Instagram ideas, growth resources and brand collaboration guidance. New prompts and articles can be added through CreateLoom's simple content files.</p></div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">FAQ</div><h2>Frequently asked questions</h2></div></div><div class="faq"><details><summary>What is CreateLoom?</summary><p>CreateLoom is a creator-focused library of AI prompts, practical guides and Instagram resources.</p></details><details><summary>Can I copy the prompts?</summary><p>Yes. Every prompt has a copy button so you can quickly move the text into your preferred AI tool.</p></details><details><summary>Can I share a specific prompt?</summary><p>Yes. Each prompt has its own shareable URL, so you can send the exact prompt from an Instagram Reel or message.</p></details><details><summary>Are CreateLoom prompts free?</summary><p>CreateLoom is designed around free-to-use prompt resources. Individual third-party AI tools may have their own pricing.</p></details></div></div></section>
<section class="section"><div class="container"><div class="card cta"><div class="eyebrow">Start creating</div><h2>Ready to create something amazing?</h2><p class="muted">Explore prompts, creator resources and practical guides.</p><a class="primary" href="/prompts/">Explore Prompts →</a></div></div></section>
</Layout>
