    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
  }

  .category-overview {
    padding-top: 55px;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 45px;
    align-items: center;
  }

  .overview-grid h2 {
    margin: 8px 0 18px;
  }

  .overview-grid p {
    color: #c7c7cf;
    line-height: 1.8;
  }

