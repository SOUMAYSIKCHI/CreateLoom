---
import Layout from '../../layouts/Layout.astro';
import PromptCard from '../../components/PromptCard.astro';
import prompts from '../../data/prompts.json';

export function getStaticPaths() {
  return [...new Set(prompts.map((p) => p.category))].map((category) => ({
    params: {
      category: category.toLowerCase()
    },
    props: {
      category,
      prompts: prompts.filter((p) => p.category === category)
    }
  }));
}

const { category, prompts: items } = Astro.props;

const categoryDescriptions = {
  Couple:
    'Explore romantic couple photography prompts for mirror selfies, cinematic portraits, dates, sunsets and creative relationship photos.',

  Vintage:
    'Create nostalgic AI photos inspired by film cameras, Polaroids, retro aesthetics, 80s photography and early digital cameras.',

  Cinematic:
    'Discover cinematic AI image prompts featuring dramatic lighting, rainy streets, neon cities, atmospheric environments and movie-inspired compositions.',

  Wedding:
    'Find elegant wedding and traditional couple prompts for portraits, celebrations, ceremonies and timeless photography concepts.',

  Travel:
    'Create travel-inspired AI photos featuring airports, beaches, city streets, destinations and lifestyle photography.',

  Aesthetic:
    'Explore soft, cozy, luxury and lifestyle AI image prompts designed for polished aesthetic photography.',

  Friends:
    'Find AI prompts for best-friend selfies, group photos, college memories and natural lifestyle photography.',

  Selfie:
    'Discover AI selfie prompts for mirror selfies, car selfies, rainy streets and realistic social-media portraits.',

  Fashion:
    'Explore fashion photography prompts for streetwear, editorial portraits, luxury styling, mirror selfies and studio shoots.',

  Portrait:
    'Create professional, dramatic and realistic AI portraits with studio lighting, black-and-white photography and clean compositions.',

  Anime:
    'Explore anime and chibi prompts for transforming creative ideas into illustrated characters and expressive portraits.',

  Festival:
    'Create festive and traditional AI portraits inspired by cultural celebrations, traditional clothing and colorful environments.',

  Celebration:
    'Find birthday and celebration photography prompts for memorable portraits, couple photos and special occasions.'
};

const description =
  categoryDescriptions[category] ||
  `Explore detailed ${category.toLowerCase()} AI image prompts on CreateLoom.`;

const related = prompts
  .filter((p) => p.category !== category)
  .filter((p) =>
    p.tags.some((tag) =>
      items.some((item) => item.tags.includes(tag))
    )
  )
  .slice(0, 3);

const canonicalUrl = new URL(
  `/prompts/${category.toLowerCase()}/`,
  Astro.site || Astro.url
).href;

const pageTitle = `${category} AI Prompts — ${items.length}+ Ready-to-Use Prompts | CreateLoom`;
---

<Layout
  title={pageTitle}
  description={description}
  active="Prompts"
>

  <!-- Hero -->
  <section class="hero hero-compact category-hero">

    <div class="container">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/prompts/">AI Prompts</a>
        <span>/</span>
        <span>{category}</span>
      </nav>

      <div class="eyebrow">
        AI Prompt Category
      </div>

      <h1>
        <span class="gradient-text">{category}</span>
        AI Prompts
      </h1>

      <p class="hero-description">
        {description}
      </p>

      <div class="hero-actions">
        <a class="secondary" href="/prompts/">
          ← All Prompts
        </a>

        <a class="secondary" href="#prompts">
          Browse {items.length} Prompts ↓
        </a>
      </div>

    </div>

  </section>


  <!-- Category Overview -->
  <section class="section category-overview">

    <div class="container">

      <div class="overview-grid">

        <div>

          <div class="eyebrow">
            {category} Collection
          </div>

          <h2>
            Ready-to-use {category.toLowerCase()} prompts
          </h2>

          <p>
            This collection brings together detailed AI image prompts
            specifically focused on {category.toLowerCase()} photography
            and visual concepts. Copy any prompt, customize the details
            and use it as a starting point for your next generation.
          </p>

          <p>
            The prompts are designed to give an image generator clearer
            direction around composition, subject, lighting, environment,
            camera perspective and overall visual style.
          </p>

          <p>
            If you're creating content for Instagram, continue with the
            <a href="/creator-hub/">Instagram Creator Hub</a> for Reel ideas
            and growth resources, or use our
            <a href="/creator-tools/trending-hashtags/">trending Instagram hashtags</a>
            tool to find curated hashtag sets by topic.
          </p>

        </div>

        <div class="category-stat-card">

          <div class="stat-number">
            {items.length}
          </div>

          <div class="stat-label">
            Prompts in this category
          </div>

          <div class="stat-divider"></div>

          <a href="/prompts/">
            Explore the full library →
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- Prompt Collection -->
  <section
    class="section"
    id="prompts"
  >

    <div class="container">

      <div class="section-heading">

        <div>

          <div class="eyebrow">
            Browse collection
          </div>

          <h2>
            {category} Prompt Library
          </h2>

          <p>
            Copy, customize and use any prompt below.
          </p>

        </div>

        <span class="results-note">
          {items.length} prompts
        </span>

      </div>

      <div class="grid">

        {items.map((p) => (
          <PromptCard p={p} />
        ))}

      </div>

    </div>

  </section>


  <!-- How to Use -->
  <section class="section how-section">

    <div class="container narrow">

      <div class="eyebrow">
        Getting better results
      </div>

      <h2>
        How to use {category.toLowerCase()} AI prompts
      </h2>

      <p>
        AI image prompts work best when they give the image generator
        enough visual direction without making the request unnecessarily
        confusing. Start with one of the prompts above and customize
        the elements that matter most to your idea.
      </p>

      <div class="steps">

        <div class="step">
          <span>01</span>
          <div>
            <h3>Choose a prompt</h3>
            <p>
              Pick a concept that matches the type of
              {category.toLowerCase()} image you want to create.
            </p>
          </div>
        </div>

        <div class="step">
          <span>02</span>
          <div>
            <h3>Copy the prompt</h3>
            <p>
              Open the prompt page and copy the complete prompt
              with one click.
            </p>
          </div>
        </div>

        <div class="step">
          <span>03</span>
          <div>
            <h3>Customize the details</h3>
            <p>
              Change clothing, location, lighting, pose, mood,
              camera perspective or other details to fit your concept.
            </p>
          </div>
        </div>

        <div class="step">
          <span>04</span>
          <div>
            <h3>Generate and refine</h3>
            <p>
              Generate your image and make small targeted changes
              if the result needs improvement.
            </p>
          </div>
        </div>

      </div>

    </div>

  </section>


  <!-- Related Prompts -->
  {related.length > 0 && (
    <section class="section related-section">

      <div class="container">

        <div class="section-heading">

          <div>
            <div class="eyebrow">
              Explore more
            </div>

            <h2>
              You might also like
            </h2>

            <p>
              More AI prompts with related visual styles and ideas.
            </p>
          </div>

          <a
            href="/prompts/"
            class="text-link"
          >
            View all →
          </a>

        </div>

        <div class="grid">

          {related.map((p) => (
            <PromptCard p={p} />
          ))}

        </div>

      </div>

    </section>
  )}


  <!-- Related Creator Resources -->
  <section class="section category-tools-section">

    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">More from CreateLoom</div>
          <h2>Creator Resources & Tools</h2>
          <p>
            Explore related resources after choosing your {category.toLowerCase()} prompt.
          </p>
        </div>
      </div>

      <div class="category-tools-links">
        <a href="/creator-hub/">
          <strong>Instagram Creator Hub</strong>
          <span>Reel ideas, growth resources and creator strategy.</span>
        </a>

        <a href="/creator-tools/trending-hashtags/">
          <strong>Trending Instagram Hashtags</strong>
          <span>Curated hashtag sets for Instagram posts and Reels.</span>
        </a>

        <a href="/prompts/">
          <strong>All AI Image Prompts</strong>
          <span>Browse every CreateLoom prompt category.</span>
        </a>
      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="section">

    <div class="container">

      <div class="category-cta">

        <div class="eyebrow">
          Create something new
        </div>

        <h2>
          Can't find the exact idea?
        </h2>

        <p>
          Browse the complete CreateLoom library for more styles,
          concepts and AI image prompts.
        </p>

        <a
          href="/prompts/"
          class="primary"
        >
          Explore All AI Prompts →
        </a>

      </div>

    </div>

  </section>


  <!-- Structured Data -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: pageTitle,
      description,
      url: canonicalUrl,
      isPartOf: {
        '@type': 'WebSite',
        name: 'CreateLoom',
        url: new URL('/', Astro.site || Astro.url).href
      },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: items.length,
        itemListElement: items.map((p, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: p.title,
          url: new URL(
            `/prompt/${p.id}/`,
            Astro.site || Astro.url
          ).href
        }))
      }
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: pageTitle,
      description,
      url: canonicalUrl,
      isPartOf: {
        '@type': 'WebSite',
        name: 'CreateLoom',
        url: new URL('/', Astro.site || Astro.url).href
      },
      about: {
        '@type': 'Thing',
        name: `${category} AI image prompts`
      }
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL('/', Astro.site || Astro.url).href
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'AI Prompts',
          item: new URL('/prompts/', Astro.site || Astro.url).href
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: `${category} Prompts`,
          item: canonicalUrl
        }
      ]
    })}
  />

</Layout>


<style>

  .category-hero {
    padding-bottom: 55px;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 30px;
    font-size: 0.78rem;
    color: var(--muted, #a1a1aa);
  }

  .breadcrumb a {
    color: #a78bfa;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .hero-description {
    max-width: 760px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 25px;
  }

  .category-overview {
    padding-top: 55px;
  }

  .overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 45px;
    align-items: center;
  }

  .overview-grid h2 {
    margin: 8px 0 18px;
  }

  .overview-grid p {
    color: #c7c7cf;
    line-height: 1.8;
  }

  .overview-grid a {
    color: #c4b5fd;
    font-weight: 700;
    text-decoration: none;
  }

  .overview-grid a:hover {
    text-decoration: underline;
  }

  .category-tools-section {
    background: rgba(255,255,255,0.015);
  }

  .category-tools-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .category-tools-links a {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-height: 115px;
    padding: 18px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 15px;
    background: rgba(255,255,255,0.02);
    color: inherit;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease;
  }

  .category-tools-links a:hover {
    transform: translateY(-2px);
    border-color: rgba(139,92,246,0.35);
  }

  .category-tools-links strong {
    color: #fff;
    font-size: .88rem;
  }

  .category-tools-links span {
    color: var(--muted, #a1a1aa);
    font-size: .78rem;
    line-height: 1.55;
  }

  .category-stat-card {
    padding: 30px;
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 20px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.12),
        rgba(255,255,255,0.025)
      );
    text-align: center;
  }

  .stat-number {
    font-size: 3rem;
    line-height: 1;
    font-weight: 900;
    color: #c4b5fd;
  }

  .stat-label {
    margin-top: 8px;
    color: var(--muted, #a1a1aa);
    font-size: 0.85rem;
  }

  .stat-divider {
    height: 1px;
    margin: 22px 0;
    background: rgba(255,255,255,0.08);
  }

  .category-stat-card a {
    color: #c4b5fd;
    text-decoration: none;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 25px;
  }

  .section-heading h2 {
    margin: 7px 0 5px;
  }

  .section-heading p {
    margin: 0;
    color: var(--muted, #a1a1aa);
    line-height: 1.6;
  }

  .results-note {
    color: var(--muted, #a1a1aa);
    font-size: 0.82rem;
    white-space: nowrap;
  }

  .narrow {
    max-width: 850px;
  }

  .how-section {
    background: rgba(255,255,255,0.015);
  }

  .how-section h2 {
    margin: 8px 0 15px;
  }

  .how-section > .container > p {
    color: #c7c7cf;
    line-height: 1.8;
  }

  .steps {
    display: grid;
    gap: 12px;
    margin-top: 28px;
  }

  .step {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 15px;
    padding: 18px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 15px;
    background: rgba(255,255,255,0.02);
  }

  .step > span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: rgba(139,92,246,0.12);
    color: #c4b5fd;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .step h3 {
    margin: 1px 0 5px;
    font-size: 1rem;
  }

  .step p {
    margin: 0;
    color: var(--muted, #a1a1aa);
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .related-section {
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  .text-link {
    color: #c4b5fd;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .category-cta {
    padding: 45px 25px;
    text-align: center;
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.12),
        rgba(255,255,255,0.025)
      );
  }

  .category-cta h2 {
    margin: 8px 0 10px;
  }

  .category-cta p {
    max-width: 600px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
  }

  .category-cta .primary {
    display: inline-flex;
    margin-top: 20px;
    text-decoration: none;
  }

  @media (max-width: 700px) {

    .category-tools-links {
      grid-template-columns: 1fr;
    }

    .overview-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero-actions {
      flex-direction: column;
    }

    .hero-actions a {
      justify-content: center;
    }

  }

</style>
