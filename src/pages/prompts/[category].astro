    text-decoration: underline;
  }

  .category-filters-section {
    padding-top: 5px;
    padding-bottom: 15px;
  }

  .filters-card {
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 18px;
    background: rgba(255,255,255,0.02);
  }

  .filter-group + .filter-group {
    margin-top: 18px;
  }

  .filter-label {
    margin-bottom: 10px;
    color: #a78bfa;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .12em;
