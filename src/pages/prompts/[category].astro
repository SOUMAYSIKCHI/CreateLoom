---
import Layout from '../../layouts/Layout.astro';
import PromptCard from '../../components/PromptCard.astro';
import prompts from '../../data/prompts.json';
import categoriesData from '../../data/categories.json';

export function getStaticPaths() {
  const categories = categoriesData.categories || categoriesData;

  return categories
    .filter((meta) => meta.slug !== 'all' && meta.slug !== 'trending')
    .map((meta) => {
      const category = prompts.find((p) => p.category === meta.name)?.category || meta.name;

      return {
        params: {
          category: meta.slug
        },
        props: {
          category,
          categoryMeta: meta,
          prompts: prompts.filter((p) => p.category === category)
        }
      };
    })
    .filter((entry) => entry.props.prompts.length > 0);
}

const {
  category,
  categoryMeta,
  prompts: items
} = Astro.props;

const description =
  categoryMeta?.seoDescription ||
  categoryMeta?.description ||
  categoryMeta?.shortDescription ||
  `Explore free ${category} AI image prompts, photo editing prompts and ready-to-use ideas on Create With Soumay.`;

const categorySeoContent =
  categoryMeta?.seoContent ||
  categoryMeta?.categoryIntro ||
  description;

const searchTerms = Array.isArray(categoryMeta?.searchTerms)
  ? categoryMeta.searchTerms
  : [];

const related = prompts
  .filter((p) => p.category !== category)
  .filter((p) =>
    p.tags?.some((tag) =>
      items.some((item) => item.tags?.includes(tag))
    )
  )
  .slice(0, 3);

const canonicalUrl = new URL(
  `/prompts/${categoryMeta?.slug || category.toLowerCase()}/`,
  Astro.site || Astro.url
).href;

const pageTitle =
  categoryMeta?.metaTitle ||
  `${category} AI Image Prompts | Free ${category} Photo Editing Prompts | Create With Soumay`;

const pageKeywords = searchTerms.length
  ? searchTerms.join(', ')
  : `${category.toLowerCase()} ai image prompts, ${category.toLowerCase()} ai photo editing prompts, ${category.toLowerCase()} prompts`;

const isNavratri = categoryMeta?.slug === 'navratri';

const typeFilters = ['All', 'Boy', 'Girl', 'Couple', 'Unisex'];
const toolFilters = ['All', 'ChatGPT', 'Gemini', 'Nano Banana', 'Midjourney'];
---

<Layout
  title={pageTitle}
  description={description}
  active="Prompts"
>

  <!-- Hero -->
  <section class="hero hero-compact category-hero">

    <div class="container">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/prompts/">AI Prompts</a>
        <span>/</span>
        <span>{category}</span>
      </nav>

      <div class="eyebrow">
        AI Prompt Category
      </div>

      <h1>
        <span class="gradient-text">{category}</span>
        AI Prompts
      </h1>

      <p class="hero-description">
        {description}
      </p>

      <div class="hero-actions">
        <a class="secondary" href="/prompts/">
          ← All Prompts
        </a>

        <a class="secondary" href="#prompts">
          Browse {items.length} Prompts ↓
        </a>
      </div>

    </div>

  </section>


  <!-- Category Overview -->
  <section class="section category-overview">

    <div class="container">

      <div class="overview-grid">

        <div>

          <div class="eyebrow">
            {category} Collection
          </div>

          <h2>
            Ready-to-use {category} AI image prompts
          </h2>

          <p class="category-short-intro">
            Explore free {category} AI image prompts and ready-to-use photo
            editing ideas for realistic portraits, social media content and
            creative image generation.
          </p>

        </div>

        <div class="category-stat-card">

          <div class="stat-number">
            {items.length}
          </div>

          <div class="stat-label">
            Prompts in this category
          </div>

          <div class="stat-divider"></div>

          <a href="/prompts/">
            Explore the full library →
          </a>

        </div>

      </div>

    </div>

  </section>


  <!-- Prompt Filters -->
  <section class="section category-filters-section">
    <div class="container">
      <div class="filters-card">
        <div class="filter-group">
          <div class="filter-label">Filter by Type</div>
          <div class="filter-buttons" id="typeFilters" role="group" aria-label="Filter prompts by type">
            {typeFilters.map((type) => (
              <button
                type="button"
                class:list={{ active: type === 'All' }}
                data-type={type.toLowerCase()}
              >
                {type}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <div class="filter-label">Filter by AI Tool</div>
          <div class="filter-buttons" id="toolFilters" role="group" aria-label="Filter prompts by AI tool">
            {toolFilters.map((tool) => (
              <button
                type="button"
                class:list={{ active: tool === 'All' }}
                data-tool={tool.toLowerCase()}
              >
                {tool}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- Prompt Collection -->
  <section
    class="section"
    id="prompts"
  >

    <div class="container">

      <div class="section-heading">

        <div>

          <div class="eyebrow">
            Browse collection
          </div>

          <h2>
            {category} Prompt Library
          </h2>

          <p>
            Copy, customize and use any prompt below.
          </p>

        </div>

        <span class="results-note">
          {items.length} prompts
        </span>

      </div>

      <div class="grid prompt-category-grid" id="promptGrid">

        {items.map((p) => (
          <div
            class="prompt-filter-item"
            data-type={(p.type || 'Unisex').toLowerCase()}
            data-tools={(p.tools || []).map((tool) => tool.toLowerCase()).join('|')}
            data-category={p.category.toLowerCase()}
          >
            <PromptCard p={p} />
          </div>
        ))}

      </div>

      <div class="filter-empty" id="filterEmpty" hidden>
        <strong>No prompts match these filters.</strong>
        <span>Try another type or AI tool.</span>
      </div>

    </div>

  </section>


  <!-- Category SEO Content -->
  <section class="section category-seo-section">
    <div class="container narrow">
      <div class="eyebrow">About {category} AI Prompts</div>

      <h2>
        {category} AI Image Prompts, Photo Editing Ideas &amp; Creative Concepts
      </h2>

      <p>
        {categorySeoContent}
      </p>

      {isNavratri && (
        <p>
          Looking for <strong>Navratri AI image prompts</strong>, <strong>Navratri
          photo editing prompts</strong>, <strong>Navratri prompts for Gemini</strong>,
          <strong>Nano Banana Navratri prompts</strong>, <strong>Garba photo prompts</strong>
          or <strong>Dandiya AI photo prompts</strong>? This collection brings
          those festive visual ideas together in one place, including realistic
          Garba-night portraits, traditional outfits, festive selfies, boys'
          Navratri looks and romantic Navratri couple photos.
        </p>
      )}

      <div class="keyword-pills" aria-label="{category} search topics">
        {searchTerms.slice(0, 8).map((term) => (
          <span>{term}</span>
        ))}
      </div>
    </div>
  </section>


  <!-- SEO Content -->
  <section class="section category-seo-section">
    <div class="container narrow">

      <div class="eyebrow">About {category} AI Prompts</div>

      <h2>
        {category} AI Image Prompts, Photo Editing Ideas &amp; Creative Concepts
      </h2>

      <p>
        {categorySeoContent}
      </p>

      <p>
        Browse ready-to-use {category.toLowerCase()} AI image prompts for
        realistic photo editing, portraits, social media content and creative
        image generation. Copy a prompt, customize the subject, pose, outfit,
        background, lighting and camera style, then adapt it for your preferred
        AI image generator.
      </p>

      <p>
        These prompts are designed for supported image-generation workflows
        with tools such as <strong>ChatGPT, Google Gemini, Nano Banana and
        Midjourney</strong>. For photo-editing prompts, use your own image when
        the selected tool supports image input and follow the identity
        preservation instructions in the individual prompt.
      </p>

      {isNavratri && (
        <p>
          Looking for <strong>Navratri AI image prompts</strong>,
          <strong>Navratri photo editing prompts</strong>,
          <strong>Navratri prompts for Gemini</strong>,
          <strong>Nano Banana Navratri prompts</strong>,
          <strong>Garba photo prompts</strong> or
          <strong>Dandiya AI photo prompts</strong>? This collection brings
          those festive visual ideas together, including realistic Garba-night
          portraits, traditional outfits, festive selfies, boys' Navratri
          looks and romantic Navratri couple photos.
        </p>
      )}

      <p>
        Looking for more creator resources? Explore the
        <a href="/creator-hub/">Instagram Creator Hub</a> for Reel ideas and
        growth resources, or use the
        <a href="/creator-tools/trending-hashtags/">trending Instagram hashtags</a>
        tool for social content.
      </p>

      <div class="keyword-pills" aria-label="{category} search topics">
        {searchTerms.slice(0, 8).map((term) => (
          <span>{term}</span>
        ))}
      </div>

    </div>
  </section>


  <!-- How to Use -->
  <section class="section how-section">

    <div class="container narrow">

      <div class="eyebrow">
        Getting better results
      </div>

      <h2>
        How to use {category.toLowerCase()} AI prompts
      </h2>

      <p>
        AI image prompts work best when they give the image generator
        enough visual direction without making the request unnecessarily
        confusing. Start with one of the prompts above and customize
        the elements that matter most to your idea.
      </p>

      <div class="steps">

        <div class="step">
          <span>01</span>
          <div>
            <h3>Choose a prompt</h3>
            <p>
              Pick a concept that matches the type of
              {category.toLowerCase()} image you want to create.
            </p>
          </div>
        </div>

        <div class="step">
          <span>02</span>
          <div>
            <h3>Copy the prompt</h3>
            <p>
              Open the prompt page and copy the complete prompt
              with one click.
            </p>
          </div>
        </div>

        <div class="step">
          <span>03</span>
          <div>
            <h3>Customize the details</h3>
            <p>
              Change clothing, location, lighting, pose, mood,
              camera perspective or other details to fit your concept.
            </p>
          </div>
        </div>

        <div class="step">
          <span>04</span>
          <div>
            <h3>Generate and refine</h3>
            <p>
              Generate your image and make small targeted changes
              if the result needs improvement.
            </p>
          </div>
        </div>

      </div>

    </div>

  </section>


  <!-- Related Prompts -->
  {related.length > 0 && (
    <section class="section related-section">

      <div class="container">

        <div class="section-heading">

          <div>
            <div class="eyebrow">
              Explore more
            </div>

            <h2>
              You might also like
            </h2>

            <p>
              More AI prompts with related visual styles and ideas.
            </p>
          </div>

          <a
            href="/prompts/"
            class="text-link"
          >
            View all →
          </a>

        </div>

        <div class="grid">

          {related.map((p) => (
            <PromptCard p={p} />
          ))}

        </div>

      </div>

    </section>
  )}


  <!-- Related Creator Resources -->
  <section class="section category-tools-section">

    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">More from Create With Soumay</div>
          <h2>Creator Resources & Tools</h2>
          <p>
            Explore related resources after choosing your {category.toLowerCase()} prompt.
          </p>
        </div>
      </div>

      <div class="category-tools-links">
        <a href="/creator-hub/">
          <strong>Instagram Creator Hub</strong>
          <span>Reel ideas, growth resources and creator strategy.</span>
        </a>

        <a href="/creator-tools/trending-hashtags/">
          <strong>Trending Instagram Hashtags</strong>
          <span>Curated hashtag sets for Instagram posts and Reels.</span>
        </a>

        <a href="/prompts/">
          <strong>All AI Image Prompts</strong>
          <span>Browse every Create With Soumay prompt category.</span>
        </a>
      </div>

    </div>

  </section>


  <!-- CTA -->
  <section class="section">

    <div class="container">

      <div class="category-cta">

        <div class="eyebrow">
          Create something new
        </div>

        <h2>
          Can't find the exact idea?
        </h2>

        <p>
          Browse the complete Create With Soumay library for more styles,
          concepts and AI image prompts.
        </p>

        <a
          href="/prompts/"
          class="primary"
        >
          Explore All AI Prompts →
        </a>

      </div>

    </div>

  </section>


  <!-- Structured Data -->

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: pageTitle,
      description,
      url: canonicalUrl,
      keywords: pageKeywords,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Create With Soumay',
        url: new URL('/', Astro.site || Astro.url).href
      },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: items.length,
        itemListElement: items.map((p, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: p.title,
          url: new URL(
            `/prompt/${p.id}/`,
            Astro.site || Astro.url
          ).href
        }))
      }
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: pageTitle,
      description,
      url: canonicalUrl,
      keywords: pageKeywords,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Create With Soumay',
        url: new URL('/', Astro.site || Astro.url).href
      },
      about: {
        '@type': 'Thing',
        name: `${category} AI image prompts`
      }
    })}
  />


  {categoryMeta?.faq?.length > 0 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: categoryMeta.faq.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer
          }
        }))
      })}
    />
  )}

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: new URL('/', Astro.site || Astro.url).href
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'AI Prompts',
          item: new URL('/prompts/', Astro.site || Astro.url).href
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: `${category} Prompts`,
          item: canonicalUrl
        }
      ]
    })}
  />

</Layout>

<script is:inline>
  const typeButtons = document.querySelectorAll('#typeFilters button');
  const toolButtons = document.querySelectorAll('#toolFilters button');
  const promptItems = document.querySelectorAll('.prompt-filter-item');
  const filterEmpty = document.getElementById('filterEmpty');

  let selectedType = 'all';
  let selectedTool = 'all';

  function applyFilters() {
    let visible = 0;

    promptItems.forEach((item) => {
      const itemType = item.dataset.type || 'unisex';
      const itemTools = (item.dataset.tools || '').split('|').filter(Boolean);

      const typeMatch =
        selectedType === 'all' ||
        itemType === selectedType;

      const toolMatch =
        selectedTool === 'all' ||
        itemTools.includes(selectedTool);

      const show = typeMatch && toolMatch;

      item.hidden = !show;
      if (show) visible++;
    });

    if (filterEmpty) {
      filterEmpty.hidden = visible !== 0;
    }
  }

  typeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      typeButtons.forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');
      selectedType = button.dataset.type || 'all';
      applyFilters();
    });
  });

  toolButtons.forEach((button) => {
    button.addEventListener('click', () => {
      toolButtons.forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');
      selectedTool = button.dataset.tool || 'all';
      applyFilters();
    });
  });
</script>


<style>

