    gap: 20px;
    margin-bottom: 25px;
  }

  .section-heading h2 {
    margin: 7px 0 5px;
  }

  .section-heading p {
    margin: 0;
    color: var(--muted, #a1a1aa);
    line-height: 1.6;
  }

  .results-note {
    color: var(--muted, #a1a1aa);
    font-size: 0.82rem;
