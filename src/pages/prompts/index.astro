---
import Layout from '../../layouts/Layout.astro';
import PromptCard from '../../components/PromptCard.astro';
import prompts from '../../data/prompts.json';

const cats = [...new Set(prompts.map((p) => p.category))].sort();

const types = ['Boy', 'Girl', 'Couple', 'Unisex'];
const toolOptions = ['ChatGPT', 'Gemini', 'Nano Banana', 'Midjourney'];

const trendRank = {
  hot: 0,
  current: 1,
  rising: 2,
  seasonal: 3,
  evergreen: 4
};

const sortByCreatedAtDesc = (a, b) =>
  String(b.createdAt || '').localeCompare(String(a.createdAt || ''));

// Always show the newest prompts first by noId.
const sortedPrompts = [...prompts].sort(
  (a, b) => Number(b.noId || 0) - Number(a.noId || 0)
);

const trendingPrompts = prompts
  .filter((p) => p.trending === true)
  .sort((a, b) => {
    const rankA = trendRank[a.trendStatus] ?? 99;
    const rankB = trendRank[b.trendStatus] ?? 99;
    return rankA - rankB || sortByCreatedAtDesc(a, b);
  });

const featured = sortedPrompts.slice(0, 6);

const categoryDescriptions = {
  Couple: 'Romantic couple photos, mirror selfies, dates and cinematic relationship portraits.',
  Vintage: 'Retro, film, Polaroid and nostalgic photography prompts.',
  Cinematic: 'Moody cinematic portraits, rain scenes, neon lighting and dramatic compositions.',
  Wedding: 'Wedding, traditional and elegant couple portrait prompts.',
  Travel: 'Travel photography concepts including beaches, airports, streets and destinations.',
  Aesthetic: 'Soft, cozy, luxury and lifestyle-inspired aesthetic prompts.',
  Friends: 'Selfies, group photos and lifestyle concepts for friends.',
  Selfie: 'Mirror selfies, car selfies and realistic social-media portrait concepts.',
  Fashion: 'Streetwear, editorial, luxury and fashion photography prompts.',
  Portrait: 'Professional, dramatic, studio and clean portrait prompts.',
  Anime: 'Anime, chibi and illustrated character concepts.',
  Festival: 'Festive, traditional and celebration-focused portrait ideas.',
  Celebration: 'Birthday and special-event photography concepts.'
};
---

<Layout
  title="Free AI Image Prompts | 40+ Ready-to-Use Prompts | Create With Soumay"
  description="Explore free AI image prompts for couples, selfies, portraits, fashion, vintage photography, anime, travel and more. Search, filter and copy ready-to-use prompts for ChatGPT, Gemini, Nano Banana and Midjourney."
  active="Prompts"
>

  <!-- Hero -->
  <section class="hero hero-compact">
    <div class="container">

      <div class="eyebrow">Create With Soumay Prompt Library</div>

      <h1>
        Free AI Image
        <span class="gradient-text">Prompts</span>
      </h1>

      <p class="hero-description">
        Explore free, ready-to-use AI image prompts for realistic portraits,
        couple photos, selfies, fashion, vintage photography, anime and
        creative social content. Copy and customize prompts for your favorite
        AI image generator.
      </p>

      <form class="search" id="promptSearchForm">
        <input
          id="promptSearch"
          name="q"
          placeholder="Search couple, selfie, fashion, vintage..."
          autocomplete="off"
          aria-label="Search AI prompts"
        />

        <button type="submit">
          Search
        </button>
      </form>


  <!-- All Prompts -->
  <section
    class="section"
    id="all-prompts"
  >

    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Full library</div>
          <h2>Browse All Prompts</h2>
          <p>
            Search the complete Create With Soumay prompt collection.
          </p>
        </div>

        <span
          class="results-note"
          id="resultCount"
          aria-live="polite"
        >
          {prompts.length} prompts
        </span>
      </div>


      <!-- Filters -->
      <div class="toolbar">

        <div class="filter-group">
          <span class="filter-label">Category</span>
          <div
            class="filters"
            id="categoryFilters"
            aria-label="Prompt categories"
          >
            <button
              type="button"
              class="small-btn active-filter"
              data-category="All"
              aria-pressed="true"
            >
              All
            </button>

            <button
              type="button"
              class="small-btn"
              data-category="Trending"
              aria-pressed="false"
            >
              Trending
            </button>

            {cats.map((category) => (
              <button
                type="button"
                class="small-btn"
                data-category={category}
                aria-pressed="false"
              >
                {category}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">Type</span>
          <div
            class="filters"
            id="typeFilters"
            aria-label="Prompt type"
          >
            <button
              type="button"
              class="small-btn active-filter"
              data-type="All"
              aria-pressed="true"
            >
              All
            </button>

            {types.map((type) => (
              <button
                type="button"
                class="small-btn"
                data-type={type}
                aria-pressed="false"
              >
                {type}
              </button>
            ))}
          </div>
        </div>

        <div class="filter-group">
          <span class="filter-label">AI tool</span>
          <div
            class="filters"
            id="toolFilters"
            aria-label="Compatible AI tool"
          >
            <button
              type="button"
              class="small-btn active-filter"
              data-tool="All"
              aria-pressed="true"
            >
              All
            </button>

            {toolOptions.map((tool) => (
              <button
                type="button"
                class="small-btn"
                data-tool={tool}
                aria-pressed="false"
              >
                {tool}
              </button>
            ))}
          </div>
        </div>

      </div>


      <!-- Prompt Grid -->
      <div
        class="grid"
        id="promptGrid"
      >
        {sortedPrompts.map((p) => (
          <PromptCard p={p} />
        ))}
      </div>


      <!-- Empty State -->
      <div
        class="empty-state"
        id="empty"
        hidden
      >
        <div class="empty-icon">⌕</div>

        <h3>No prompts found</h3>

        <p>
          Try a different keyword or choose another category.
        </p>

        <button
          type="button"
          class="small-btn"
          id="clearSearch"
        >
          Clear Search
        </button>
      </div>

    </div>

  </section>




    </div>
  </section>


  <!-- Library stats -->
  <section class="hero-stats-section">
    <div class="container">
      <div class="hero-stats">
        <div>
          <strong>{prompts.length}+</strong>
          <span>AI Prompts</span>
        </div>

        <div>
          <strong>{cats.length}</strong>
          <span>Categories</span>
        </div>

        <div>
          <strong>Free</strong>
          <span>To Copy & Use</span>
        </div>
      </div>
    </div>
  </section>


  <!-- Featured -->
  <section class="section featured-section">
    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Start here</div>
          <h2>Featured AI Prompts</h2>
          <p>
            Popular concepts to help you get started quickly.
          </p>
        </div>

        <a href="#all-prompts" class="text-link">
          Browse all →
        </a>
      </div>

      <div class="featured-grid">

        {featured.map((p) => (
          <a
            class="featured-card"
            href={`/prompt/${p.id}/`}
          >
            <span>{p.category}</span>

            <h3>{p.title}</h3>

            <p>
              {p.description || `A ready-to-use ${p.category.toLowerCase()} AI image prompt.`}
            </p>

            <strong>
              View prompt →
            </strong>
          </a>
        ))}

      </div>

    </div>
  </section>


  <!-- Categories -->
  <section class="section category-section">

    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Explore by style</div>
          <h2>Prompt Categories</h2>
          <p>
            Find prompts based on the type of image you want to create.
          </p>
        </div>
      </div>

      <div class="category-grid">

        {cats.map((category) => (
          <a
            class="category-card"
            href={`/prompts/${category.toLowerCase()}/`}
          >

            <span class="category-name">
              {category}
            </span>

            <span class="category-count">
              {prompts.filter((p) => p.category === category).length}
              prompts
            </span>

            <p>
              {categoryDescriptions[category] ||
                `Explore ${category.toLowerCase()} AI image prompts.`}
            </p>

            <span class="category-arrow">
              Explore →
            </span>

          </a>
        ))}

      </div>

    </div>

  </section>


  <!-- CREATOR TOOLS -->

  <section class="section prompt-related-section">

    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Create beyond the prompt</div>
          <h2>More Tools for Visual Creators</h2>
          <p>
            Pair AI image prompts with creator resources, Instagram ideas and hashtag research.
          </p>
        </div>
      </div>

      <div class="prompt-related-links">
        <a href="/creator-hub/">
          <strong>Instagram Creator Hub</strong>
          <span>Reel ideas, growth resources and creator strategy.</span>
        </a>

        <a href="/trends/">
          <strong>AI Photo Trends</strong>
          <span>Explore trending AI photo styles and learn how to create them.</span>
        </a>

        <a href="/ai-photo-guides/">
          <strong>AI Photo Guides</strong>
          <span>Learn practical techniques for better, more consistent AI images.</span>
        </a>

        <a href="/creator-tools/trending-hashtags/">
          <strong>Trending Instagram Hashtags</strong>
          <span>Find curated hashtag sets by topic for posts and Reels.</span>
        </a>

        <a href="/blog/">
          <strong>Creator Guides</strong>
          <span>Practical articles about AI, Instagram and content growth.</span>
        </a>
      </div>

    </div>

  </section>



  <!-- SEO Content -->
  <section class="section seo-section">

    <div class="container narrow">

      <div class="eyebrow">
        About the library
      </div>

      <h2>
        Detailed AI image prompts for creative projects
      </h2>

      <p>
        Create With Soumay is a growing library of ready-to-use AI image prompts
        designed to help creators turn visual ideas into clearer image
        generation instructions. Instead of starting with a blank prompt,
        you can explore structured concepts for portraits, selfies,
        couples, fashion, travel, vintage photography, anime and more.
      </p>

      <p>
        Each prompt is designed around practical visual details such as
        composition, subject direction, lighting, environment, camera
        perspective, mood and realism. When a reference image is involved,
        prompts can also include explicit instructions for preserving the
        subject's recognizable identity and natural proportions.
      </p>

      <p>
        You can copy a prompt directly from Create With Soumay, customize the
        details for your own concept and experiment with different
        variations. For better results, change one major element at a time
        instead of rewriting the entire prompt after every generation.
      </p>

      <p>
        Whether you're creating an Instagram Reel, experimenting with AI
        photography or simply looking for a new visual concept, the
        Create With Soumay prompt library gives you a practical starting point.
        After choosing an image concept, you can explore the
        <a href="/creator-hub/">Instagram Creator Hub</a> for content ideas
        or use our <a href="/creator-tools/trending-hashtags/">trending
        Instagram hashtags</a> tool to research curated hashtag sets for
        your next post or Reel.
      </p>

    </div>

  </section>


  <!-- CTA -->
  <section class="section">

    <div class="container">

      <div class="library-cta">

        <div class="eyebrow">
          Create something new
        </div>

        <h2>
          Find a prompt. Make it yours.
        </h2>

        <p>
          Copy a detailed prompt, customize the concept and create your
          next AI image.
        </p>

        <a
          href="/blog/"
          class="primary"
        >
          Read Creator Guides →
        </a>

      </div>

    </div>

  </section>


  <script is:inline>
    const input = document.querySelector('#promptSearch');
    const form = document.querySelector('#promptSearchForm');
    const cards = [
      ...document.querySelectorAll('#promptGrid .prompt-card')
    ];

    const categoryButtons = [
      ...document.querySelectorAll('#categoryFilters button[data-category]')
    ];

    const typeButtons = [
      ...document.querySelectorAll('#typeFilters button[data-type]')
    ];

    const toolButtons = [
      ...document.querySelectorAll('#toolFilters button[data-tool]')
    ];

    const count = document.querySelector('#resultCount');
    const empty = document.querySelector('#empty');
    const clearButton = document.querySelector('#clearSearch');

    const params = new URLSearchParams(location.search);

    let cat = params.get('category') || 'All';
    let type = params.get('type') || 'All';
    let tool = params.get('tool') || 'All';

    if (
      cat !== 'All' &&
      !categoryButtons.some((button) => button.dataset.category === cat)
    ) {
      cat = 'All';
    }

    if (
      type !== 'All' &&
      !typeButtons.some((button) => button.dataset.type === type)
    ) {
      type = 'All';
    }

    if (
      tool !== 'All' &&
      !toolButtons.some((button) => button.dataset.tool === tool)
    ) {
      tool = 'All';
    }

    input.value = params.get('q') || '';

    function updateUrl() {
      const q = input.value.trim();
      const url = new URL(location.href);

      url.search = '';

      if (q) url.searchParams.set('q', q);
      if (cat !== 'All') url.searchParams.set('category', cat);
      if (type !== 'All') url.searchParams.set('type', type);
      if (tool !== 'All') url.searchParams.set('tool', tool);

      history.replaceState({}, '', url);
    }

    function setActive(buttons, value, key) {
      buttons.forEach((button) => {
        const active = button.dataset[key] === value;

        button.classList.toggle('active-filter', active);
        button.setAttribute('aria-pressed', String(active));
      });
    }

    function filterPrompts() {
      const q = input.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const searchableText = [
          card.dataset.title,
          card.dataset.category,
          card.dataset.type,
          card.dataset.tools,
          card.dataset.tags,
          card.dataset.prompt,
          card.dataset.description,
          card.dataset.searchTerms,
          card.dataset.trending === 'true' ? 'trending' : ''
        ]
          .filter(Boolean)
          .join(' ')
          .toLowerCase();

        const matchesCategory =
          cat === 'All' ||
          (cat === 'Trending'
            ? card.dataset.trending === 'true'
            : card.dataset.category === cat);

        const matchesType =
          type === 'All' ||
          card.dataset.type === type;

        const cardTools = card.dataset.tools || '';

        const matchesTool =
          tool === 'All' ||
          cardTools.includes(tool);

        const matchesSearch =
          !q || searchableText.includes(q);

        const show =
          matchesCategory &&
          matchesType &&
          matchesTool &&
          matchesSearch;

        card.style.display = show ? '' : 'none';

        if (show) visible++;
      });

      setActive(categoryButtons, cat, 'category');
      setActive(typeButtons, type, 'type');
      setActive(toolButtons, tool, 'tool');

      count.textContent =
        `${visible} prompt${visible === 1 ? '' : 's'}`;

      empty.hidden = visible !== 0;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      updateUrl();
      filterPrompts();

      document
        .querySelector('#all-prompts')
        ?.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
    });

    input.addEventListener('input', () => {
      updateUrl();
      filterPrompts();
    });

    categoryButtons.forEach((button) => {
      button.addEventListener('click', () => {
        cat = button.dataset.category;
        updateUrl();
        filterPrompts();

        document
          .querySelector('#all-prompts')
          ?.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
      });
    });

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        type = button.dataset.type;
        updateUrl();
        filterPrompts();

        document
          .querySelector('#all-prompts')
          ?.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
      });
    });

    toolButtons.forEach((button) => {
      button.addEventListener('click', () => {
        tool = button.dataset.tool;
        updateUrl();
        filterPrompts();

        document
          .querySelector('#all-prompts')
          ?.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
      });
    });

    clearButton?.addEventListener('click', () => {
      input.value = '';
      cat = 'All';
      type = 'All';
      tool = 'All';

      updateUrl();
      filterPrompts();
    });

    filterPrompts();
  </script>


  <!-- Prompt library structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Free AI Image Prompts | 40+ Ready-to-Use Prompts',
      description:
        "Explore free AI image prompts for couples, selfies, portraits, fashion, vintage photography, anime, travel and more. Search, filter and copy ready-to-use prompts for ChatGPT, Gemini, Nano Banana and Midjourney.",
      url: 'https://createwithsoumay.store/prompts/',
      isPartOf: {
        '@type': 'WebSite',
        name: 'Create With Soumay',
        url: 'https://createwithsoumay.store/'
      },
      publisher: {
        '@type': 'Organization',
        name: 'Create With Soumay',
        url: 'https://createwithsoumay.store/',
        logo: 'https://createwithsoumay.store/images/createloom-logo.png'
      },
      mainEntity: {
        '@type': 'ItemList',
        name: 'AI Image Prompt Library',
        numberOfItems: prompts.length,
        itemListOrder: 'https://schema.org/ItemListOrderDescending'
      },
      about: [
        'AI image prompts',
        'AI photography prompts',
        'portrait prompts',
        'couple photo prompts',
        'Instagram visual content'
      ],
      numberOfItems: prompts.length
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://createwithsoumay.store/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'AI Image Prompts',
          item: 'https://createwithsoumay.store/prompts/'
        }
      ]
    })}
  />

</Layout>

<style>

  .hero-description {
    max-width: 720px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.8;
  }

  .hero-stats-section {
    padding: 0 0 10px;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 30px;
  }

  .hero-stats div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-align: center;
  }

  .hero-stats strong {
    color: #fff;
    font-size: 1.15rem;
  }

  .hero-stats span {
    color: var(--muted, #a1a1aa);
    font-size: 0.75rem;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
  }

  .section-heading h2 {
    margin: 7px 0 5px;
  }

  .section-heading p {
    margin: 0;
    color: var(--muted, #a1a1aa);
    line-height: 1.6;
  }

