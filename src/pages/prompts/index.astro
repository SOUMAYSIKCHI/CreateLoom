---
import Layout from '../../layouts/Layout.astro';
import PromptCard from '../../components/PromptCard.astro';
import prompts from '../../data/prompts.json';

const cats = [...new Set(prompts.map((p) => p.category))].sort();

const featured = prompts.slice(0, 6);

const categoryDescriptions = {
  Couple: 'Romantic couple photos, mirror selfies, dates and cinematic relationship portraits.',
  Vintage: 'Retro, film, Polaroid and nostalgic photography prompts.',
  Cinematic: 'Moody cinematic portraits, rain scenes, neon lighting and dramatic compositions.',
  Wedding: 'Wedding, traditional and elegant couple portrait prompts.',
  Travel: 'Travel photography concepts including beaches, airports, streets and destinations.',
  Aesthetic: 'Soft, cozy, luxury and lifestyle-inspired aesthetic prompts.',
  Friends: 'Selfies, group photos and lifestyle concepts for friends.',
  Selfie: 'Mirror selfies, car selfies and realistic social-media portrait concepts.',
  Fashion: 'Streetwear, editorial, luxury and fashion photography prompts.',
  Portrait: 'Professional, dramatic, studio and clean portrait prompts.',
  Anime: 'Anime, chibi and illustrated character concepts.',
  Festival: 'Festive, traditional and celebration-focused portrait ideas.',
  Celebration: 'Birthday and special-event photography concepts.'
};
---

<Layout
  title="AI Image Prompts — 40+ Ready-to-Use Prompts | CreateLoom"
  description="Browse CreateLoom's collection of detailed AI image prompts for couples, selfies, portraits, fashion, vintage photos, anime, travel and more. Search, filter and copy prompts."
  active="Prompts"
>

  <!-- Hero -->
  <section class="hero hero-compact">
    <div class="container">

      <div class="eyebrow">CreateLoom Prompt Library</div>

      <h1>
        AI Image
        <span class="gradient-text">Prompts</span>
      </h1>

      <p class="hero-description">
        Explore detailed, ready-to-use AI image prompts for realistic
        portraits, couple photos, selfies, fashion, vintage photography,
        anime and creative social content.
      </p>

      <form class="search" id="promptSearchForm">
        <input
          id="promptSearch"
          name="q"
          placeholder="Search couple, selfie, fashion, vintage..."
          autocomplete="off"
          aria-label="Search AI prompts"
        />

        <button type="submit">
          Search
        </button>
      </form>

      <div class="hero-stats">
        <div>
          <strong>{prompts.length}+</strong>
          <span>AI Prompts</span>
        </div>

        <div>
          <strong>{cats.length}</strong>
          <span>Categories</span>
        </div>

        <div>
          <strong>Free</strong>
          <span>To Copy & Use</span>
        </div>
      </div>

    </div>
  </section>


  <!-- Featured -->
  <section class="section featured-section">
    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Start here</div>
          <h2>Featured AI Prompts</h2>
          <p>
            Popular concepts to help you get started quickly.
          </p>
        </div>

        <a href="#all-prompts" class="text-link">
          Browse all →
        </a>
      </div>

      <div class="featured-grid">

        {featured.map((p) => (
          <a
            class="featured-card"
            href={`/prompt/${p.id}/`}
          >
            <span>{p.category}</span>

            <h3>{p.title}</h3>

            <p>
              {p.prompt.slice(0, 125)}
              {p.prompt.length > 125 ? '…' : ''}
            </p>

            <strong>
              View prompt →
            </strong>
          </a>
        ))}

      </div>

    </div>
  </section>


  <!-- Categories -->
  <section class="section category-section">

    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Explore by style</div>
          <h2>Prompt Categories</h2>
          <p>
            Find prompts based on the type of image you want to create.
          </p>
        </div>
      </div>

      <div class="category-grid">

        {cats.map((category) => (
          <a
            class="category-card"
            href={`/prompts/${category.toLowerCase()}/`}
          >

            <span class="category-name">
              {category}
            </span>

            <span class="category-count">
              {prompts.filter((p) => p.category === category).length}
              prompts
            </span>

            <p>
              {categoryDescriptions[category] ||
                `Explore ${category.toLowerCase()} AI image prompts.`}
            </p>

            <span class="category-arrow">
              Explore →
            </span>

          </a>
        ))}

      </div>

    </div>

  </section>


  <!-- All Prompts -->
  <section
    class="section"
    id="all-prompts"
  >

    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Full library</div>
          <h2>Browse All Prompts</h2>
          <p>
            Search the complete CreateLoom prompt collection.
          </p>
        </div>

        <span
          class="results-note"
          id="resultCount"
          aria-live="polite"
        >
          {prompts.length} prompts
        </span>
      </div>


      <!-- Filters -->
      <div class="toolbar">

        <div
          class="filters"
          id="filters"
          aria-label="Prompt categories"
        >

          <button
            type="button"
            class="small-btn active-filter"
            data-category="All"
          >
            All
          </button>

          <button
            type="button"
            class="small-btn"
            data-category="Trending"
          >
            Trending
          </button>

          {cats.map((category) => (
            <button
              type="button"
              class="small-btn"
              data-category={category}
            >
              {category}
            </button>
          ))}

        </div>

      </div>


      <!-- Prompt Grid -->
      <div
        class="grid"
        id="promptGrid"
      >
        {prompts.map((p) => (
          <PromptCard p={p} />
        ))}
      </div>


      <!-- Empty State -->
      <div
        class="empty-state"
        id="empty"
        hidden
      >
        <div class="empty-icon">⌕</div>

        <h3>No prompts found</h3>

        <p>
          Try a different keyword or choose another category.
        </p>

        <button
          type="button"
          class="small-btn"
          id="clearSearch"
        >
          Clear Search
        </button>
      </div>

    </div>

  </section>


  <!-- SEO Content -->
  <section class="section seo-section">

    <div class="container narrow">

      <div class="eyebrow">
        About the library
      </div>

      <h2>
        Detailed AI image prompts for creative projects
      </h2>

      <p>
        CreateLoom is a growing library of ready-to-use AI image prompts
        designed to help creators turn visual ideas into clearer image
        generation instructions. Instead of starting with a blank prompt,
        you can explore structured concepts for portraits, selfies,
        couples, fashion, travel, vintage photography, anime and more.
      </p>

      <p>
        Each prompt is designed around practical visual details such as
        composition, subject direction, lighting, environment, camera
        perspective, mood and realism. When a reference image is involved,
        prompts can also include explicit instructions for preserving the
        subject's recognizable identity and natural proportions.
      </p>

      <p>
        You can copy a prompt directly from CreateLoom, customize the
        details for your own concept and experiment with different
        variations. For better results, change one major element at a time
        instead of rewriting the entire prompt after every generation.
      </p>

      <p>
        Whether you're creating an Instagram Reel, experimenting with AI
        photography or simply looking for a new visual concept, the
        CreateLoom prompt library gives you a practical starting point.
      </p>

    </div>

  </section>


  <!-- CTA -->
  <section class="section">

    <div class="container">

      <div class="library-cta">

        <div class="eyebrow">
          Create something new
        </div>

        <h2>
          Find a prompt. Make it yours.
        </h2>

        <p>
          Copy a detailed prompt, customize the concept and create your
          next AI image.
        </p>

        <a
          href="/blog/"
          class="primary"
        >
          Read Creator Guides →
        </a>

      </div>

    </div>

  </section>


  <script is:inline>
    const input = document.querySelector('#promptSearch');
    const form = document.querySelector('#promptSearchForm');
    const cards = [
      ...document.querySelectorAll('#promptGrid .prompt-card')
    ];
    const buttons = [
      ...document.querySelectorAll('#filters button[data-category]')
    ];
    const count = document.querySelector('#resultCount');
    const empty = document.querySelector('#empty');
    const clearButton = document.querySelector('#clearSearch');

    const params = new URLSearchParams(location.search);

    let cat = params.get('category') || 'All';

    if (
      cat !== 'All' &&
      !buttons.some((button) => button.dataset.category === cat)
    ) {
      cat = 'All';
    }

    input.value = params.get('q') || '';

    function updateUrl() {
      const q = input.value.trim();

      const url = new URL(location.href);

      url.search = '';

      if (q) {
        url.searchParams.set('q', q);
      }

      if (cat !== 'All') {
        url.searchParams.set('category', cat);
      }

      history.replaceState({}, '', url);
    }

    function filterPrompts() {
      const q = input.value.trim().toLowerCase();

      let visible = 0;

      cards.forEach((card) => {

        const searchableText = (
          card.dataset.title +
          ' ' +
          card.dataset.category +
          ' ' +
          (card.dataset.trending === 'true' ? 'trending' : '') +
          ' ' +
          card.dataset.tags +
          ' ' +
          card.dataset.prompt
        ).toLowerCase();

        const matchesCategory =
          cat === 'All' ||
          (cat === 'Trending'
            ? card.dataset.trending === 'true'
            : card.dataset.category === cat);

        const matchesSearch =
          !q ||
          searchableText.includes(q);

        const show =
          matchesCategory &&
          matchesSearch;

        /* Use inline display instead of only [hidden].
           The global .card rule defines display:flex, which can override
           the browser's default hidden behavior. */
        card.style.display = show ? '' : 'none';

        if (show) {
          visible++;
        }
      });

      buttons.forEach((button) => {
        const active = button.dataset.category === cat;

        button.classList.toggle(
          'active-filter',
          active
        );

        button.setAttribute(
          'aria-pressed',
          String(active)
        );
      });

      count.textContent =
        `${visible} prompt${visible === 1 ? '' : 's'}`;

      empty.hidden = visible !== 0;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      updateUrl();
      filterPrompts();

      document
        .querySelector('#all-prompts')
        ?.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
    });

    input.addEventListener(
      'input',
      () => {
        updateUrl();
        filterPrompts();
      }
    );

    buttons.forEach((button) => {

      button.addEventListener('click', () => {

        cat = button.dataset.category;

        updateUrl();
        filterPrompts();

        document
          .querySelector('#all-prompts')
          ?.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });

      });

    });

    clearButton?.addEventListener('click', () => {

      input.value = '';
      cat = 'All';

      updateUrl();
      filterPrompts();

    });

    filterPrompts();
  </script>

</Layout>

<style>

  .hero-description {
    max-width: 720px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.8;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 30px;
  }

  .hero-stats div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-align: center;
  }

  .hero-stats strong {
    color: #fff;
    font-size: 1.15rem;
  }

  .hero-stats span {
    color: var(--muted, #a1a1aa);
    font-size: 0.75rem;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
  }

  .section-heading h2 {
    margin: 7px 0 5px;
  }

  .section-heading p {
    margin: 0;
    color: var(--muted, #a1a1aa);
    line-height: 1.6;
  }

  .text-link {
    color: #c4b5fd;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
  }

  .featured-card {
    display: block;
    padding: 21px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 17px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.08),
        rgba(255,255,255,0.025)
      );
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .featured-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,0.4);
  }

  .featured-card > span {
    color: #a78bfa;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-card h3 {
    margin: 10px 0;
    color: #fff;
    line-height: 1.35;
  }

  .featured-card p {
    color: var(--muted, #a1a1aa);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .featured-card strong {
    color: #c4b5fd;
    font-size: 0.82rem;
  }

  .category-section {
    background: rgba(255,255,255,0.015);
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .category-card {
    display: block;
    padding: 18px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 15px;
    color: inherit;
    text-decoration: none;
    background: rgba(255,255,255,0.02);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .category-card:hover {
    transform: translateY(-2px);
    border-color: rgba(139,92,246,0.35);
    background: rgba(139,92,246,0.05);
  }

  .category-name {
    display: block;
    color: #fff;
    font-weight: 800;
  }

  .category-count {
    display: block;
    margin-top: 3px;
    color: #a78bfa;
    font-size: 0.72rem;
  }

  .category-card p {
    margin: 11px 0;
    color: var(--muted, #a1a1aa);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .category-arrow {
    color: #c4b5fd;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .toolbar {
    margin-bottom: 24px;
  }

  .filters {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .active-filter {
    border-color: rgba(139,92,246,0.5) !important;
    background: rgba(139,92,246,0.13) !important;
    color: #c4b5fd !important;
  }

  .results-note {
    color: var(--muted, #a1a1aa);
    font-size: 0.82rem;
  }

  .empty-state {
    padding: 65px 20px;
    text-align: center;
  }

  .empty-icon {
    font-size: 2rem;
    color: #a78bfa;
  }

  .empty-state h3 {
    margin: 10px 0 5px;
  }

  .empty-state p {
    color: var(--muted, #a1a1aa);
    margin-bottom: 18px;
  }

  .narrow {
    max-width: 850px;
  }

  .seo-section {
    background: rgba(255,255,255,0.015);
  }

  .seo-section h2 {
    margin: 8px 0 20px;
  }

  .seo-section p {
    color: #c7c7cf;
    line-height: 1.85;
    font-size: 1rem;
  }

  .library-cta {
    padding: 45px 25px;
    text-align: center;
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.12),
        rgba(255,255,255,0.025)
      );
  }

  .library-cta h2 {
    margin: 8px 0 10px;
  }

  .library-cta p {
    max-width: 620px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
  }

  .library-cta .primary {
    display: inline-flex;
    margin-top: 20px;
    text-decoration: none;
  }

  @media (max-width: 900px) {

    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .category-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 600px) {

    .hero-stats {
      gap: 25px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .featured-grid,
    .category-grid {
      grid-template-columns: 1fr;
    }

    .featured-card {
      padding: 18px;
    }

  }

</style>
