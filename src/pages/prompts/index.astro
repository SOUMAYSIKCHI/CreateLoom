    line-height: 1.65;
  }

  .category-view-more {
    flex: 0 0 auto;
    color: #c4b5fd;
    text-decoration: none;
    font-size: .82rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .category-view-more:hover {
    text-decoration: underline;
  }

  .category-prompt-grid {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 13px;
  }

  .category-empty {
    padding: 22px;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 15px;
    color: var(--muted, #a1a1aa);
  }

  .category-empty a {
    color: #c4b5fd;
    font-weight: 700;
    text-decoration: none;
  }

