    white-space: nowrap;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
  }

  .featured-card {
    display: block;
    padding: 21px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 17px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.08),
        rgba(255,255,255,0.025)
      );
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .featured-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,0.4);
  }

  .featured-card > span {
    color: #a78bfa;
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .featured-card h3 {
    margin: 10px 0;
    color: #fff;
    line-height: 1.35;
  }

  .featured-card p {
    color: var(--muted, #a1a1aa);
    font-size: 0.88rem;
    line-height: 1.65;
  }

  .featured-card strong {
    color: #c4b5fd;
    font-size: 0.82rem;
  }

  .category-preview-section {
    background: rgba(255,255,255,0.015);
  }

  .category-nav {
    display: flex;
    gap: 9px;
    flex-wrap: wrap;
    margin: 0 0 42px;
    padding: 15px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 17px;
    background: rgba(255,255,255,0.02);
  }

  .category-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 7px 12px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 999px;
    color: #d4d4d8;
    text-decoration: none;
    font-size: .76rem;
    font-weight: 700;
    transition: border-color .2s ease, background .2s ease, color .2s ease;
  }

  .category-nav a:hover {
    border-color: rgba(139,92,246,.4);
    background: rgba(139,92,246,.08);
    color: #c4b5fd;
  }

  .category-preview-list {
    display: grid;
    gap: 58px;
  }

  .category-preview {
    scroll-margin-top: 90px;
  }

  .category-preview-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 22px;
    margin-bottom: 20px;
  }

  .category-preview-heading h3 {
    margin: 7px 0 6px;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.3;
  }

  .category-preview-heading h3 a {
    color: #fff;
    text-decoration: none;
  }

  .category-preview-heading h3 a:hover {
    color: #c4b5fd;
  }

  .category-preview-heading p {
    max-width: 760px;
    margin: 0;
