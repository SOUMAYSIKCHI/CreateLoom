    max-width: 720px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.8;
  }

  .hero-stats-section {
    padding: 0 0 10px;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 40px;
    margin-top: 30px;
  }

  .hero-stats div {
    display: flex;
    flex-direction: column;
    gap: 3px;
    text-align: center;
  }

  .hero-stats strong {
    color: #fff;
    font-size: 1.15rem;
  }

  .hero-stats span {
    color: var(--muted, #a1a1aa);
    font-size: 0.75rem;
  }

  .section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 25px;
  }

  .section-heading h2 {
    margin: 7px 0 5px;
  }

  .section-heading p {
    margin: 0;
