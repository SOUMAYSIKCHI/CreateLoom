    margin: 10px 0 5px;
  }

  .empty-state p {
    color: var(--muted, #a1a1aa);
    margin-bottom: 18px;
  }

  .narrow {
    max-width: 850px;
  }

  .seo-section {
    background: rgba(255,255,255,0.015);
  }

