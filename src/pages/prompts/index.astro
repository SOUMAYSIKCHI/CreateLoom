    color: #c4b5fd;
    font-weight: 700;
    text-decoration: none;
  }

  .seo-section a:hover {
    text-decoration: underline;
  }

  /* Related creator tools */

  .prompt-related-section {
    background: rgba(255,255,255,0.015);
  }

  .prompt-related-links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .prompt-related-links a {
    display: flex;
    flex-direction: column;
    gap: 7px;
    min-height: 120px;
    padding: 18px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 15px;
    background: rgba(255,255,255,0.02);
    color: inherit;
    text-decoration: none;
    transition: transform .2s ease, border-color .2s ease;
  }

  .prompt-related-links a:hover {
    transform: translateY(-2px);
    border-color: rgba(139,92,246,0.35);
  }

  .prompt-related-links strong {
    color: #fff;
    font-size: .88rem;
  }

  .prompt-related-links span {
    color: var(--muted, #a1a1aa);
    font-size: .78rem;
    line-height: 1.55;
  }

  .library-cta {
    padding: 45px 25px;
    text-align: center;
    border: 1px solid rgba(139,92,246,0.2);
    border-radius: 22px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.12),
        rgba(255,255,255,0.025)
      );
  }

  .library-cta h2 {
    margin: 8px 0 10px;
  }

  .library-cta p {
    max-width: 620px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
  }

  .library-cta .primary {
    display: inline-flex;
    margin-top: 20px;
    text-decoration: none;
  }

  @media (max-width: 900px) {

    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .category-prompt-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

  }

  @media (max-width: 600px) {

    .prompt-related-links {
      grid-template-columns: 1fr;
    }

    .hero-stats {
      gap: 25px;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .featured-grid,
    .category-prompt-grid {
      grid-template-columns: 1fr;
    }

    .category-preview-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .featured-card {
      padding: 18px;
    }

  }

</style>
