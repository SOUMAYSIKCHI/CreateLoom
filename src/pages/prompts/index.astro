---
import Layout from '../../layouts/Layout.astro';
import PromptCard from '../../components/PromptCard.astro';
import prompts from '../../data/prompts.json';
import categoriesData from '../../data/categories.json';

// categories.json uses a top-level { categories: [...] } object.
// Keep a small fallback so the page remains compatible if the JSON
// is later changed to a plain array.
const categories = categoriesData.categories || categoriesData;

const types = ['Boy', 'Girl', 'Couple', 'Unisex'];
const toolOptions = ['ChatGPT', 'Gemini', 'Nano Banana', 'Midjourney'];

const trendRank = {
  hot: 0,
  current: 1,
  rising: 2,
  seasonal: 3,
  evergreen: 4
};

const sortByCreatedAtDesc = (a, b) =>
  String(b.createdAt || '').localeCompare(String(a.createdAt || ''));

// Always show the newest prompts first by noId.
const sortedPrompts = [...prompts].sort(
  (a, b) => Number(b.noId || 0) - Number(a.noId || 0)
);

const trendingPrompts = prompts
  .filter((p) => p.trending === true)
  .sort((a, b) => {
    const rankA = trendRank[a.trendStatus] ?? 99;
    const rankB = trendRank[b.trendStatus] ?? 99;
    return rankA - rankB || sortByCreatedAtDesc(a, b);
  });

const featured = sortedPrompts.slice(0, 6);

// Category metadata comes from categories.json.
// Category names, slugs, descriptions and ratings stay in one source of truth.
const categoryMeta = new Map(
  categories.map((category) => [category.slug, category])
);

const categoryItems = categories
  .filter(
    (category) =>
      category.slug !== 'all' &&
      category.slug !== 'trending'
  )
  .map((category) => ({
    category: category.name,
    meta: category,
    count: prompts.filter((p) => p.category === category.name).length
  }))
  .filter((item) => item.count > 0)
  .sort(
    (a, b) =>
      Number(b.meta?.starRating ?? 0) -
        Number(a.meta?.starRating ?? 0) ||
      Number(a.meta?.displayOrder ?? 999) -
        Number(b.meta?.displayOrder ?? 999)
  );

const cats = categoryItems.map((item) => item.category);
---

<Layout
  title="Free AI Image Prompts | ChatGPT, Gemini & Nano Banana Prompts | Create With Soumay"
  description="Explore free AI image prompts for couples, selfies, portraits, fashion, Navratri, vintage photography, anime and more. Copy ready-to-use prompts for ChatGPT, Gemini, Nano Banana and Midjourney."
  active="Prompts"
>

  <!-- Hero -->
  <section class="hero hero-compact">
    <div class="container">

      <div class="eyebrow">Create With Soumay Prompt Library</div>

      <h1>
        Free AI Image
        <span class="gradient-text">Prompts</span>
      </h1>

      <p class="hero-description">
        Explore free, ready-to-use AI image prompts for realistic portraits,
        couple photos, selfies, fashion, vintage photography, anime and
        creative social content. Copy and customize prompts for your favorite
        AI image generator.
      </p>

      <form class="search" id="promptSearchForm">
        <input
          id="promptSearch"
          name="q"
          placeholder="Search couple, selfie, fashion, vintage..."
          autocomplete="off"
          aria-label="Search AI prompts"
        />

        <button type="submit">
          Search
        </button>
      </form>


  <!-- Library stats -->
  <section class="hero-stats-section">
    <div class="container">
      <div class="hero-stats">
        <div>
          <strong>{prompts.length}+</strong>
          <span>AI Prompts</span>
        </div>

        <div>
          <strong>{categoryItems.length}</strong>
          <span>Categories</span>
        </div>

        <div>
          <strong>Free</strong>
          <span>To Copy & Use</span>
        </div>
      </div>
    </div>
  </section>


  <!-- Featured -->
  <section class="section featured-section">
    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Start here</div>
          <h2>Featured AI Prompts</h2>
          <p>
            Popular concepts to help you get started quickly.
          </p>
        </div>

        <a href="#all-prompts" class="text-link">
          Browse all →
        </a>
      </div>

      <div class="featured-grid">

        {featured.map((p) => (
          <a
            class="featured-card"
            href={`/prompt/${p.id}/`}
          >
            <span>{p.category}</span>

            <h3>{p.title}</h3>

            <p>
              {p.description || `A ready-to-use ${p.category.toLowerCase()} AI image prompt.`}
            </p>

            <strong>
              View prompt →
            </strong>
          </a>
        ))}

      </div>

    </div>
  </section>


  <!-- Browse All Categories -->
  <section class="section category-preview-section" id="browse-categories">
    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Browse by category</div>
          <h2>Explore AI Image Prompts by Category</h2>
          <p>
            Discover free, ready-to-use AI image prompts organized by style,
            occasion and creative use case. Each category links directly to
            its complete prompt collection.
          </p>
        </div>
      </div>

      <!-- Crawlable category navigation -->
      <nav class="category-nav" aria-label="AI image prompt categories">
        {categoryItems.map(({ category, meta }) => (
          <a
            href={`/prompts/${meta?.slug || category.toLowerCase()}/`}
            title={meta?.title || `${category} AI image prompts`}
          >
            {category}
          </a>
        ))}
      </nav>

      <div class="category-preview-list">
        {categoryItems.map(({ category, meta, count }) => {
          const categoryPrompts = prompts
            .filter(
              (p) =>
                p.category === category &&
                p.preview === true
            )
            .slice(0, 5);

          return (
            <section
              class="category-preview"
              id={`category-${meta?.slug || category.toLowerCase()}`}
              aria-labelledby={`heading-${meta?.slug || category.toLowerCase()}`}
            >
              <div class="category-preview-heading">
                <div>
                  <div class="eyebrow">
                    {count} {count === 1 ? 'prompt' : 'prompts'}
                    {meta?.starRating ? ` · ${meta.starRating.toFixed(1)} ★` : ''}
                  </div>

                  <h3 id={`heading-${meta?.slug || category.toLowerCase()}`}>
                    <a
                      href={`/prompts/${meta?.slug || category.toLowerCase()}/`}
                    >
                      {meta?.title || `${category} AI Image Prompts`}
                    </a>
                  </h3>

                  <p>
                    {meta?.shortDescription ||
                      meta?.description ||
                      `Explore ${category.toLowerCase()} AI image prompts.`}
                  </p>
                </div>

                <a
                  class="category-view-more"
                  href={`/prompts/${meta?.slug || category.toLowerCase()}/`}
                  aria-label={`View all ${category} AI image prompts`}
                >
                  View More →
                </a>
              </div>

              {categoryPrompts.length > 0 ? (
                <div class="grid category-prompt-grid">
                  {categoryPrompts.map((p) => (
                    <PromptCard p={p} />
                  ))}
                </div>
              ) : (
                <p class="category-empty">
                  More {category.toLowerCase()} AI image prompts are coming soon.
                  <a href={`/prompts/${meta?.slug || category.toLowerCase()}/`}>
                    Explore the category →
                  </a>
                </p>
              )}
            </section>
          );
        })}
      </div>

    </div>
  </section>

  <!-- CREATOR TOOLS -->

  <section class="section prompt-related-section">

    <div class="container">

      <div class="section-heading">
        <div>
          <div class="eyebrow">Create beyond the prompt</div>
          <h2>More Tools for Visual Creators</h2>
          <p>
            Pair AI image prompts with creator resources, Instagram ideas and hashtag research.
          </p>
        </div>
      </div>

      <div class="prompt-related-links">
        <a href="/creator-hub/">
          <strong>Instagram Creator Hub</strong>
          <span>Reel ideas, growth resources and creator strategy.</span>
        </a>

        <a href="/trends/">
          <strong>AI Photo Trends</strong>
          <span>Explore trending AI photo styles and learn how to create them.</span>
        </a>

        <a href="/ai-photo-guides/">
          <strong>AI Photo Guides</strong>
          <span>Learn practical techniques for better, more consistent AI images.</span>
        </a>

        <a href="/creator-tools/trending-hashtags/">
          <strong>Trending Instagram Hashtags</strong>
          <span>Find curated hashtag sets by topic for posts and Reels.</span>
        </a>

        <a href="/blog/">
          <strong>Creator Guides</strong>
          <span>Practical articles about AI, Instagram and content growth.</span>
        </a>
      </div>

    </div>

  </section>



  <!-- SEO Content -->
  <section class="section seo-section">

    <div class="container narrow">

      <div class="eyebrow">
        About the library
      </div>

      <h2>
        Detailed AI image prompts for creative projects
      </h2>

      <p>
        Create With Soumay is a growing library of ready-to-use AI image prompts
        designed to help creators turn visual ideas into clearer image
        generation instructions. Instead of starting with a blank prompt,
        you can explore structured concepts for portraits, selfies,
        couples, fashion, travel, vintage photography, anime and more.
      </p>

      <p>
        Each prompt is designed around practical visual details such as
        composition, subject direction, lighting, environment, camera
        perspective, mood and realism. When a reference image is involved,
        prompts can also include explicit instructions for preserving the
        subject's recognizable identity and natural proportions.
      </p>

      <p>
        You can copy a prompt directly from Create With Soumay, customize the
        details for your own concept and experiment with different
        variations. For better results, change one major element at a time
        instead of rewriting the entire prompt after every generation.
      </p>

      <p>
        Whether you're creating an Instagram Reel, experimenting with AI
        photography or simply looking for a new visual concept, the
        Create With Soumay prompt library gives you a practical starting point.
        After choosing an image concept, you can explore the
        <a href="/creator-hub/">Instagram Creator Hub</a> for content ideas
        or use our <a href="/creator-tools/trending-hashtags/">trending
        Instagram hashtags</a> tool to research curated hashtag sets for
        your next post or Reel.
      </p>

    </div>

  </section>


  <!-- CTA -->
  <section class="section">

    <div class="container">

      <div class="library-cta">

        <div class="eyebrow">
          Create something new
        </div>

        <h2>
          Find a prompt. Make it yours.
        </h2>

        <p>
          Copy a detailed prompt, customize the concept and create your
          next AI image.
        </p>

        <a
          href="/blog/"
          class="primary"
        >
          Read Creator Guides →
        </a>

      </div>

    </div>

  </section>



  <!-- Prompt library structured data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Free AI Image Prompts | ChatGPT, Gemini & Nano Banana Prompts',
      description:
        "Explore free AI image prompts for couples, selfies, portraits, fashion, Navratri, vintage photography, anime and more. Copy ready-to-use prompts for ChatGPT, Gemini, Nano Banana and Midjourney.",
      url: 'https://www.createwithsoumay.store/prompts/',
      isPartOf: {
        '@type': 'WebSite',
        name: 'Create With Soumay',
        url: 'https://www.createwithsoumay.store'
      },
      publisher: {
        '@type': 'Organization',
        name: 'Create With Soumay',
        url: 'https://www.createwithsoumay.store',
        logo: 'https://www.createwithsoumay.store/images/createloom-logo.png'
      },
      mainEntity: {
        '@type': 'ItemList',
        name: 'AI Image Prompt Library',
        numberOfItems: prompts.length,
        itemListOrder: 'https://schema.org/ItemListOrderDescending'
      },
      about: [
        'AI image prompts',
        'AI photography prompts',
        'portrait prompts',
        'couple photo prompts',
        'Instagram visual content'
      ],
      numberOfItems: prompts.length
    })}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://www.createwithsoumay.store/'
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'AI Image Prompts',
          item: 'https://www.createwithsoumay.store/prompts/'
        }
      ]
    })}
  />

</Layout>

<style>

