---
import Layout from '../../layouts/Layout.astro';
import PromptCard from '../../components/PromptCard.astro';
import prompts from '../../data/prompts.json';
import categoriesData from '../../data/categories.json';

const categories = categoriesData.categories || categoriesData;

const categoryItems = categories
  .filter((category) => category.slug !== 'all' && category.slug !== 'trending')
  .map((category) => ({
    category: category.name,
    meta: category,
    count: prompts.filter((p) => p.category === category.name).length
  }))
  .filter((item) => item.count > 0)
  .sort(
    (a, b) =>
      Number(a.meta?.displayOrder ?? 999) - Number(b.meta?.displayOrder ?? 999)
  );

const initialPrompts = [...prompts]
  .sort((a, b) => Number(b.noId || 0) - Number(a.noId || 0))
  .slice(0, 10);

const types = ['Boy', 'Girl', 'Unisex', 'Couple'];
const filterCategories = ['All', ...categoryItems.map((item) => item.category)];
---

<Layout
  title="Free AI Image Prompts | ChatGPT, Gemini & Nano Banana Prompts | Create With Soumay"
  description="Explore free AI image prompts for couples, selfies, portraits, fashion, Navratri, vintage photography, anime and more. Copy ready-to-use prompts for ChatGPT, Gemini, Nano Banana and Midjourney."
  active="Prompts"
>
  <section class="hero hero-compact">
    <div class="container">
      <div class="eyebrow">Create With Soumay Prompt Library</div>
      <h1>Free AI Image <span class="gradient-text">Prompts</span></h1>
      <p class="hero-description">
        Explore ready-to-use AI image prompts for portraits, couples, selfies,
        fashion, vintage photography, anime and creative social content.
      </p>

      <form class="search" id="promptSearchForm">
        <input
          id="promptSearch"
          name="q"
          placeholder="Search couple, selfie, fashion, vintage..."
          autocomplete="off"
          aria-label="Search AI prompts"
        />
        <button type="submit">Search</button>
      </form>
    </div>
  </section>

  <section class="hero-stats-section">
    <div class="container">
      <div class="hero-stats">
        <div><strong>{prompts.length}+</strong><span>AI Prompts</span></div>
        <div><strong>{categoryItems.length}</strong><span>Categories</span></div>
        <div><strong>Free</strong><span>To Copy & Use</span></div>
      </div>
    </div>
  </section>

  <section class="section category-preview-section" id="browse-categories">
    <div class="container">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Browse by category</div>
          <h2>Explore AI Image Prompts by Category</h2>
          <p>
            Choose a category to browse its dedicated prompt collection.
            Each category has its own crawlable URL and focused content.
          </p>
        </div>
      </div>

      <nav class="category-nav" aria-label="AI image prompt categories">
        {categoryItems.map(({ category, meta, count }) => (
          <a
            href={`/prompts/${meta?.slug || category.toLowerCase()}/`}
            title={meta?.title || `${category} AI image prompts`}
          >
            {category}
            <span class="category-count">{count}</span>
          </a>
        ))}
      </nav>

      <div class="prompt-library-section" id="prompt-library">
        <div class="prompt-library-heading">
          <div>
            <div class="eyebrow">Latest prompts</div>
            <h2>Find an AI Image Prompt</h2>
            <p>
              The newest prompts appear first. Use search and filters to find a
              prompt, then open its dedicated page for the complete instructions.
            </p>
          </div>
          <div class="prompt-library-heading-actions">
            <div class="results-note" id="promptResultsNote" aria-live="polite">
              Showing {Math.min(10, prompts.length)} of {prompts.length} prompts
            </div>
            <a
              id="categoryViewMore"
              class="category-view-more-link"
              href="#"
              hidden
            >
              View more prompts →
            </a>
          </div>
        </div>

        <div class="toolbar" aria-label="Prompt filters">
          <div class="filter-group">
            <div class="filter-label">Category</div>
            <div class="filters" id="categoryFilters" role="group" aria-label="Filter prompts by category">
              {filterCategories.map((category) => (
                <button
                  type="button"
                  class:list={{ 'active-filter': category === 'All' }}
                  data-category-filter={category}
                  data-category-slug={
                    category === 'All'
                      ? ''
                      : categories.find((item) => item.name === category)?.slug ||
                        category.toLowerCase().replace(/[^a-z0-9]+/g, '-')
                  }
                  aria-pressed={category === 'All' ? 'true' : 'false'}
                >
                  {category}
                </button>
              ))}
            </div>
          </div>

          <div class="filter-group">
            <div class="filter-label">Type</div>
            <div class="filters" id="typeFilters" role="group" aria-label="Filter prompts by type">
              {['All', ...types].map((type) => (
                <button
                  type="button"
                  class:list={{ 'active-filter': type === 'All' }}
                  data-type-filter={type}
                  aria-pressed={type === 'All' ? 'true' : 'false'}
                >
                  {type}
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="grid prompt-library-grid" id="promptLibraryGrid" aria-live="polite">
          {initialPrompts.map((p) => (
            <div
              class="prompt-library-item"
              data-prompt-id={p.id}
              data-prompt-category={p.category || ''}
              data-prompt-type={p.type || 'Unisex'}
              data-prompt-noid={String(p.noId ?? '')}
            >
              <PromptCard p={p} compact />
            </div>
          ))}
        </div>

        <div class="prompt-library-actions">
          <button type="button" class="load-more-button" id="loadMorePrompts">
            Load More
          </button>
        </div>

        <p class="prompt-library-empty" id="promptLibraryEmpty" hidden>
          No prompts match these filters yet. Try another category, type or search term.
        </p>
      </div>
    </div>
  </section>

  <section class="section prompt-related-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <div class="eyebrow">Create beyond the prompt</div>
          <h2>More Tools for Visual Creators</h2>
          <p>Pair AI image prompts with creator resources and Instagram tools.</p>
        </div>
      </div>

      <div class="prompt-related-links">
        <a href="/creator-hub/"><strong>Instagram Creator Hub</strong><span>Reel ideas, growth resources and creator strategy.</span></a>
        <a href="/trends/"><strong>AI Photo Trends</strong><span>Explore trending AI photo styles and learn how to create them.</span></a>
        <a href="/ai-photo-guides/"><strong>AI Photo Guides</strong><span>Learn practical techniques for better AI images.</span></a>
        <a href="/creator-tools/trending-hashtags/"><strong>Trending Instagram Hashtags</strong><span>Find curated hashtag sets by topic for posts and Reels.</span></a>
        <a href="/blog/"><strong>Creator Guides</strong><span>Practical articles about AI, Instagram and content creation.</span></a>
      </div>
    </div>
  </section>

  <section class="section seo-section">
    <div class="container narrow">
      <div class="eyebrow">About the library</div>
      <h2>AI image prompts organized for faster discovery</h2>
      <p>
        Create With Soumay provides ready-to-use AI image prompts for portraits,
        selfies, couples, fashion, travel, vintage photography, anime and more.
        The main library is designed for discovery, while every prompt has a
        dedicated page containing its complete instructions and creative details.
      </p>
      <p>
        Browse a category to find focused collections, or use the search and
        filters above to discover the latest prompts. Open any prompt to copy
        the full text and customize it for your preferred AI image generator.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="library-cta">
        <div class="eyebrow">Create something new</div>
        <h2>Find a prompt. Make it yours.</h2>
        <p>Open a prompt, customize the concept and create your next AI image.</p>
        <a href="/blog/" class="primary">Read Creator Guides →</a>
      </div>
    </div>
  </section>

  <script is:inline>
    (() => {
      const grid = document.getElementById('promptLibraryGrid');
      const loadMoreButton = document.getElementById('loadMorePrompts');
      const emptyState = document.getElementById('promptLibraryEmpty');
      const resultsNote = document.getElementById('promptResultsNote');
      const categoryViewMore = document.getElementById('categoryViewMore');
      const searchForm = document.getElementById('promptSearchForm');
      const searchInput = document.getElementById('promptSearch');
      const categoryButtons = document.querySelectorAll('[data-category-filter]');
      const typeButtons = document.querySelectorAll('[data-type-filter]');

      if (!grid || !loadMoreButton) return;

      const pageSize = 10;
      let allPrompts = [];
      let visibleCount = pageSize;
      let selectedCategory = 'All';
      let selectedType = 'All';
      let searchTerm = '';
      let loading = true;

      const normalize = (value) => String(value || '').trim().toLowerCase();

      const escapeHtml = (value) =>
        String(value ?? '').replace(/[&<>'"]/g, (char) => ({
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          "'": '&#39;',
          '"': '&quot;'
        })[char]);

      const excerpt = (prompt) => {
        const text =
          prompt.description ||
          `A ready-to-use ${prompt.category || ''} AI image prompt.`;
        return text.length > 155 ? `${text.slice(0, 155).trim()}…` : text;
      };

      const matches = (prompt) => {
        const categoryMatch =
          selectedCategory === 'All' ||
          (selectedCategory === 'Trending'
            ? prompt.trending === true
            : normalize(prompt.category) === normalize(selectedCategory));

        const typeMatch =
          selectedType === 'All' ||
          normalize(prompt.type || 'Unisex') === normalize(selectedType);

        const haystack = [
          prompt.title,
          prompt.category,
          prompt.type,
          prompt.description,
          ...(prompt.tags || []),
          ...(prompt.searchTerms || [])
        ].join(' ');

        const searchMatch =
          !searchTerm || normalize(haystack).includes(normalize(searchTerm));

        return categoryMatch && typeMatch && searchMatch;
      };

      const cardMarkup = (prompt) => `
        <div class="prompt-library-item">
          <article class="card prompt-card">
            <a
              class="prompt-card-image-link"
              href="/prompt/${encodeURIComponent(prompt.id || '')}/"
              aria-label="View ${escapeHtml(prompt.title)} result preview"
            >
              <div class="prompt-card-image-wrap">
                <img
                  class="prompt-card-image"
                  src="${escapeHtml(prompt.image || '/images/prompts/createloom.png')}"
                  alt="Example result for ${escapeHtml(prompt.title)} AI image prompt"
                  width="1080"
                  height="1920"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </a>

            <div class="prompt-meta compact-meta">
              <div class="meta-left">
                <a
                  class="category-link"
                  href="/prompts/${encodeURIComponent(String(prompt.category || '').toLowerCase().replace(/[^a-z0-9]+/g, '-'))}/"
                  aria-label="Browse ${escapeHtml(prompt.category)} AI prompts"
                >
                  ${escapeHtml(prompt.category)}
                </a>
                <span class="type-badge" aria-label="Prompt type: ${escapeHtml(prompt.type || 'Unisex')}">
                  ${escapeHtml(prompt.type || 'Unisex')}
                </span>
              </div>
            </div>

            <a
              class="prompt-card-main compact-main"
              href="/prompt/${encodeURIComponent(prompt.id || '')}/"
              aria-label="Open ${escapeHtml(prompt.title)}"
            >
              <div class="title-row">
                <h3>${escapeHtml(prompt.title)}</h3>
                <span class="open-arrow" aria-hidden="true">↗</span>
              </div>
              <p class="prompt-preview">${escapeHtml(excerpt(prompt))}</p>
            </a>

            <div class="card-actions compact-actions">
              <a
                class="small-btn open-btn"
                href="/prompt/${encodeURIComponent(prompt.id || '')}/"
                aria-label="Open ${escapeHtml(prompt.title)}"
              >
                Open <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        </div>`;

      const updateButtons = (buttons, selected, key) => {
        buttons.forEach((button) => {
          const active = button.dataset[key] === selected;
          button.classList.toggle('active-filter', active);
          button.setAttribute('aria-pressed', String(active));
        });
      };

      const render = () => {
        const filtered = allPrompts.filter(matches);
        const visible = filtered.slice(0, visibleCount);

        grid.innerHTML = visible.map(cardMarkup).join('');

        if (resultsNote) {
          resultsNote.textContent = filtered.length
            ? `Showing ${visible.length} of ${filtered.length} prompts`
            : '0 prompts found';
        }

        if (emptyState) {
          emptyState.hidden = filtered.length !== 0;
        }

        loadMoreButton.hidden = loading || visible.length >= filtered.length;
        loadMoreButton.disabled = loading;
        loadMoreButton.textContent = loading ? 'Loading…' : 'Load More';

        if (categoryViewMore) {
          const selectedButton = Array.from(categoryButtons).find(
            (button) => button.dataset.categoryFilter === selectedCategory
          );
          const slug = selectedButton?.dataset.categorySlug || '';

          if (selectedCategory !== 'All' && slug) {
            categoryViewMore.href = `/prompts/${slug}/`;
            categoryViewMore.textContent =
              `View all ${selectedCategory} prompts →`;
            categoryViewMore.hidden = false;
          } else {
            categoryViewMore.hidden = true;
          }
        }
      };

      categoryButtons.forEach((button) => {
        button.addEventListener('click', () => {
          selectedCategory = button.dataset.categoryFilter || 'All';
          visibleCount = pageSize;
          updateButtons(categoryButtons, selectedCategory, 'categoryFilter');
          render();
        });
      });

      typeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          selectedType = button.dataset.typeFilter || 'All';
          visibleCount = pageSize;
          updateButtons(typeButtons, selectedType, 'typeFilter');
          render();
        });
      });

      searchForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        searchTerm = searchInput?.value.trim() || '';
        visibleCount = pageSize;
        render();
      });

      loadMoreButton.addEventListener('click', () => {
        visibleCount += pageSize;
        render();
      });

      const loadPromptData = async () => {
        try {
          const response = await fetch('/api/prompts.json', {
            headers: { Accept: 'application/json' }
          });

          if (!response.ok) {
            throw new Error(`Prompt API returned ${response.status}`);
          }

          const data = await response.json();
          allPrompts = Array.isArray(data.prompts)
            ? data.prompts
            : Array.isArray(data)
              ? data
              : [];

          allPrompts.sort(
            (a, b) => Number(b.noId || 0) - Number(a.noId || 0)
          );
        } catch (error) {
          console.error('Unable to load prompts:', error);
          allPrompts = [];
        } finally {
          loading = false;
          visibleCount = pageSize;
          render();
        }
      };

      render();
      loadPromptData();
    })();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Free AI Image Prompts | ChatGPT, Gemini & Nano Banana Prompts',
    description: 'Explore free AI image prompts for couples, selfies, portraits, fashion, Navratri, vintage photography, anime and more.',
    url: 'https://www.createwithsoumay.store/prompts/',
    isPartOf: {
      '@type': 'WebSite',
      name: 'Create With Soumay',
      url: 'https://www.createwithsoumay.store'
    },
    mainEntity: {
      '@type': 'ItemList',
      name: 'Latest AI Image Prompts',
      numberOfItems: initialPrompts.length,
      itemListElement: initialPrompts.map((p, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: p.title,
        url: `https://www.createwithsoumay.store/prompt/${p.id}/`
      }))
    },
    numberOfItems: prompts.length
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.createwithsoumay.store/' },
      { '@type': 'ListItem', position: 2, name: 'AI Image Prompts', item: 'https://www.createwithsoumay.store/prompts/' }
    ]
  })} />
</Layout>

<style>
  .hero-description { max-width: 720px; margin: 0 auto; color: var(--muted, #a1a1aa); line-height: 1.8; }
  .hero-stats-section { padding: 0 0 10px; }
  .hero-stats { display: flex; justify-content: center; flex-wrap: wrap; gap: 40px; margin-top: 30px; }
  .hero-stats div { display: flex; flex-direction: column; gap: 3px; text-align: center; }
  .hero-stats strong { color: #fff; font-size: 1.15rem; }
  .hero-stats span { color: var(--muted, #a1a1aa); font-size: .75rem; }

  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 25px; }
  .section-heading h2 { margin: 7px 0 5px; }
  .section-heading p { margin: 0; color: var(--muted, #a1a1aa); line-height: 1.6; }

  .category-preview-section { background: rgba(255,255,255,.015); }
  .category-nav { display: flex; gap: 9px; flex-wrap: wrap; margin: 0 0 42px; padding: 15px; border: 1px solid rgba(255,255,255,.07); border-radius: 17px; background: rgba(255,255,255,.02); }
  .category-nav a { display: inline-flex; align-items: center; gap: 7px; min-height: 34px; padding: 7px 12px; border: 1px solid rgba(255,255,255,.08); border-radius: 999px; color: #d4d4d8; text-decoration: none; font-size: .76rem; font-weight: 700; transition: border-color .2s ease, background .2s ease, color .2s ease; }
  .category-nav a:hover { border-color: rgba(139,92,246,.4); background: rgba(139,92,246,.08); color: #c4b5fd; }
  .category-count { color: #85858f; font-size: .68rem; }

  .prompt-library-section { margin: 0 0 62px; }
  .prompt-library-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .prompt-library-heading h2 { margin: 7px 0 5px; }
  .prompt-library-heading p { max-width: 760px; margin: 0; color: var(--muted, #a1a1aa); line-height: 1.6; }
  .prompt-library-heading-actions { display: flex; align-items: center; justify-content: flex-end; gap: 14px; flex-wrap: wrap; }
  .category-view-more-link { color: #c4b5fd; text-decoration: none; font-size: .78rem; font-weight: 800; white-space: nowrap; }
  .category-view-more-link:hover { text-decoration: underline; }
  .prompt-library-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; align-items: stretch; }
  .prompt-library-actions { display: flex; justify-content: center; margin-top: 28px; }
  .load-more-button { min-height: 42px; padding: 10px 20px; border: 1px solid rgba(255,255,255,.1); border-radius: 999px; background: rgba(255,255,255,.03); color: #fff; font: inherit; font-size: .82rem; font-weight: 800; cursor: pointer; transition: border-color .2s ease, background .2s ease, transform .2s ease; }
  .load-more-button:hover { border-color: rgba(139,92,246,.45); background: rgba(139,92,246,.1); transform: translateY(-1px); }
  .prompt-library-empty { padding: 42px 20px; margin: 22px 0 0; border: 1px solid rgba(255,255,255,.07); border-radius: 15px; color: var(--muted, #a1a1aa); text-align: center; }

  .toolbar { display: grid; gap: 16px; margin-bottom: 24px; }
  .filter-group { display: grid; gap: 8px; }
  .filter-label { color: #85858f; font-size: .68rem; font-weight: 850; letter-spacing: .07em; text-transform: uppercase; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; }
  .filters button { min-height: 36px; padding: 7px 13px; border: 1px solid rgba(255,255,255,.10); border-radius: 999px; background: rgba(255,255,255,.035); color: #d4d4d8; font: inherit; font-size: .76rem; font-weight: 700; line-height: 1; cursor: pointer; }
  .filters button.active-filter { border-color: rgba(139,92,246,.45); background: rgba(139,92,246,.12); color: #c4b5fd; }
  .filters button:focus-visible, .load-more-button:focus-visible { outline: 2px solid #a78bfa; outline-offset: 2px; }

  @media (max-width: 900px) { .prompt-library-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .prompt-library-grid { grid-template-columns: 1fr; } .section-heading, .prompt-library-heading { align-items: flex-start; flex-direction: column; } .prompt-library-heading-actions { justify-content: flex-start; } }
</style>

<style is:global>
  /* Dynamic prompt cards are created by client-side JS, so their card/image CSS must be global. */
  #promptLibraryGrid .prompt-library-item {
    min-width: 0;
    width: 100%;
  }

  #promptLibraryGrid .prompt-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    overflow: hidden;
    box-sizing: border-box;
    padding: 18px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 18px;
    background: linear-gradient(145deg, rgba(255,255,255,.035), rgba(255,255,255,.018));
  }

  #promptLibraryGrid .prompt-card-image-link {
    display: block;
    width: calc(100% + 36px);
    margin: -18px -18px 16px;
    color: inherit;
    text-decoration: none;
  }

  #promptLibraryGrid .prompt-card-image-wrap {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    box-sizing: border-box;
    background: #0d0c13;
  }

  #promptLibraryGrid .prompt-card-image {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    object-position: center;
  }

  #promptLibraryGrid .prompt-meta,
  #promptLibraryGrid .prompt-card-main {
    min-width: 0;
    max-width: 100%;
  }

  #promptLibraryGrid .prompt-card-main {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  #promptLibraryGrid .title-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    min-width: 0;
  }

  #promptLibraryGrid .title-row h3 {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  #promptLibraryGrid .prompt-preview {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    #promptLibraryGrid .prompt-card {
      padding: 16px;
    }
    #promptLibraryGrid .prompt-card-image-link {
      width: calc(100% + 32px);
      margin: -16px -16px 16px;
    }
  }
</style>
