    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 15px;
  }

  .featured-card {
    display: block;
    padding: 21px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 17px;
    background:
      linear-gradient(
        145deg,
        rgba(139,92,246,0.08),
        rgba(255,255,255,0.025)
      );
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

