---
import Layout from '../layouts/Layout.astro';
import prompts from '../data/prompts.json';
import blogs from '../data/blogs.json';

const searchData = {
  prompts,
  blogs
};
---

<Layout
  title="Search CreateLoom — Prompts, Blogs & Creator Resources"
  description="Search CreateLoom for AI prompts, blog guides and creator resources."
>
  <section class="hero hero-compact">
    <div class="container">
      <div class="eyebrow">Everything in one place</div>

      <h1>
        Search <span class="gradient-text">CreateLoom</span>
      </h1>

      <p>Find prompts, articles and creator resources.</p>

      <form class="search" id="globalSearch">
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Search prompts, blogs, categories..."
          autocomplete="off"
        />
        <button type="submit">Search</button>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div id="results"></div>
    </div>
  </section>

  <script define:vars={{ searchData }}>
    const data = searchData;

    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get('q') || '';

    const form = document.querySelector('#globalSearch');
    const input = document.querySelector('#q');
    const results = document.querySelector('#results');

    input.value = initialQuery;

    function escapeHTML(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');
    }

    function searchablePrompt(prompt) {
      return [
        prompt.title,
        prompt.category,
        ...(prompt.tags || []),
        prompt.prompt
      ]
        .join(' ')
        .toLowerCase();
    }

    function searchableBlog(blog) {
      return [
        blog.title,
        blog.category,
        ...(blog.tags || []),
        blog.excerpt,
        ...(blog.content || [])
      ]
        .join(' ')
        .toLowerCase();
    }

    function render() {
      const term = input.value.trim().toLowerCase();

      if (!term) {
        results.innerHTML = `
          <div class="card">
            <h2>Start searching</h2>
            <p>
              Try “couple”, “selfie”, “cinematic”, “reels”,
              “brand deals” or any topic you're interested in.
            </p>
          </div>
        `;
        return;
      }

      const promptResults = data.prompts
        .filter(prompt => searchablePrompt(prompt).includes(term))
        .slice(0, 8);

      const blogResults = data.blogs
        .filter(blog => searchableBlog(blog).includes(term))
        .slice(0, 8);

      let html = `
        <div class="section-head">
          <div>
            <div class="eyebrow">Search results</div>
            <h2>Results for "${escapeHTML(term)}"</h2>
          </div>
        </div>
      `;

      if (promptResults.length) {
        html += `
          <h3>Prompts</h3>
          <div class="grid">
            ${promptResults
              .map(
                prompt => `
                  <a
                    class="card"
                    href="/prompt/${encodeURIComponent(prompt.id)}/"
                  >
                    <span class="eyebrow">
                      ${escapeHTML(prompt.category)}
                    </span>

                    <h3>${escapeHTML(prompt.title)}</h3>

                    <p>
                      ${escapeHTML(prompt.prompt.slice(0, 150))}
                      ${prompt.prompt.length > 150 ? '…' : ''}
                    </p>

                    <div class="tags">
                      ${(prompt.tags || [])
                        .slice(0, 3)
                        .map(
                          tag =>
                            `<span class="tag">#${escapeHTML(tag)}</span>`
                        )
                        .join('')}
                    </div>
                  </a>
                `
              )
              .join('')}
          </div>
        `;
      }

      if (blogResults.length) {
        html += `
          <h3 style="margin-top:42px">Blog</h3>

          <div class="grid">
            ${blogResults
              .map(
                blog => `
                  <a
                    class="card"
                    href="/blog/${encodeURIComponent(blog.id)}/"
                  >
                    <span class="eyebrow">
                      ${escapeHTML(blog.category)}
                    </span>

                    <h3>${escapeHTML(blog.title)}</h3>

                    <p>${escapeHTML(blog.excerpt)}</p>
                  </a>
                `
              )
              .join('')}
          </div>
        `;
      }

      if (!promptResults.length && !blogResults.length) {
        html += `
          <div class="empty-state" style="display:block">
            <h3>No matching content found.</h3>
            <p>
              Try a different keyword such as
              “couple”, “portrait”, “anime”, “Instagram” or “brand”.
            </p>
          </div>
        `;
      }

      results.innerHTML = html;
    }

    form.addEventListener('submit', event => {
      event.preventDefault();

      const query = input.value.trim();

      const url = query
        ? `/search/?q=${encodeURIComponent(query)}`
        : '/search/';

      window.history.replaceState({}, '', url);

      render();
    });

    render();
  </script>
</Layout>
