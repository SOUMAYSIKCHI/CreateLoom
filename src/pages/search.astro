---
import Layout from '../layouts/Layout.astro';
import prompts from '../data/prompts.json';
import blogs from '../data/blogs.json';

const searchData = {
  prompts,
  blogs
};

const promptCategories = [...new Set(prompts.map((p) => p.category))].sort();
const blogCategories = [...new Set(blogs.map((b) => b.category))].sort();
---

<Layout
  title="Search CreateLoom — AI Prompts, Blogs & Creator Guides"
  description="Search the complete CreateLoom library for AI image prompts, creator guides, Instagram resources, categories and more."
>

  <!-- Hero -->

  <section class="hero hero-compact search-hero">

    <div class="container">

      <div class="eyebrow">
        CreateLoom Search
      </div>

      <h1>
        Find
        <span class="gradient-text">Anything</span>
      </h1>

      <p class="hero-description">
        Search AI image prompts, creator guides, Instagram resources,
        categories and more across CreateLoom.
      </p>

      <form
        class="search global-search"
        id="globalSearch"
      >

        <input
          id="q"
          name="q"
          type="search"
          placeholder="Try “couple”, “selfie”, “cinematic”, “reels”..."
          autocomplete="off"
          aria-label="Search CreateLoom"
        />

        <button type="submit">
          Search
        </button>

      </form>

      <div class="quick-searches">

        <span>Popular:</span>

        <button type="button" data-quick="couple">
          Couple
        </button>

        <button type="button" data-quick="selfie">
          Selfie
        </button>

        <button type="button" data-quick="cinematic">
          Cinematic
        </button>

        <button type="button" data-quick="instagram">
          Instagram
        </button>

        <button type="button" data-quick="brand">
          Brand
        </button>

      </div>

    </div>

  </section>


  <!-- Search Results -->

  <section class="section">

    <div class="container">

      <div
        id="results"
        aria-live="polite"
      ></div>

    </div>

  </section>


  <!-- Browse without searching -->

  <section class="section browse-section">

    <div class="container">

      <div class="section-heading">

        <div>
          <div class="eyebrow">
            Browse instead
          </div>

          <h2>
            Explore CreateLoom
          </h2>

          <p>
            You can also browse the library directly.
          </p>
        </div>

      </div>


      <div class="browse-grid">

        <a
          href="/prompts/"
          class="browse-card"
        >
          <span class="browse-icon">✦</span>

          <h3>
            AI Prompts
          </h3>

          <p>
            Explore {prompts.length}+ detailed prompts for couples,
            portraits, selfies, fashion, anime and more.
          </p>

          <strong>
            Browse prompts →
          </strong>
        </a>


        <a
          href="/blog/"
          class="browse-card"
        >
          <span class="browse-icon">✎</span>

          <h3>
            Creator Guides
          </h3>

          <p>
            Read practical articles about AI image creation,
            Instagram, creator growth and brand collaborations.
          </p>

          <strong>
            Browse guides →
          </strong>
        </a>


        <a
          href="/creator-hub/"
          class="browse-card"
        >
          <span class="browse-icon">◎</span>

          <h3>
            Creator Hub
          </h3>

          <p>
            Explore resources and ideas designed to help creators
            build better content and grow.
          </p>

          <strong>
            Open Creator Hub →
          </strong>
        </a>

      </div>

    </div>

  </section>


  <script define:vars={{ searchData, promptCategories, blogCategories }}>

    const data = searchData;

    const params = new URLSearchParams(
      window.location.search
    );

    const initialQuery =
      params.get('q') || '';


    const form =
      document.querySelector('#globalSearch');

    const input =
      document.querySelector('#q');

    const results =
      document.querySelector('#results');

    const quickButtons =
      [...document.querySelectorAll('[data-quick]')];


    input.value = initialQuery;


    function escapeHTML(value) {

      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;');

    }


    function normalize(value) {

      return String(value || '')
        .toLowerCase()
        .trim();

    }


    function searchablePrompt(prompt) {

      return [
        prompt.title,
        prompt.category,
        ...(prompt.tags || []),
        prompt.prompt,
        prompt.best_for || ''
      ]
        .join(' ')
        .toLowerCase();

    }


    function searchableBlog(blog) {

      return [
        blog.title,
        blog.category,
        ...(blog.tags || []),
        blog.excerpt,
        ...(blog.content || [])
      ]
        .join(' ')
        .toLowerCase();

    }


    function getMatchedWords(text, term) {

      const clean = String(text || '');

      if (!term) {
        return clean;
      }

      const index =
        clean.toLowerCase().indexOf(term);

      if (index === -1) {
        return clean;
      }

      const start =
        Math.max(0, index - 55);

      const end =
        Math.min(
          clean.length,
          index + term.length + 110
        );

      let excerpt =
        clean.slice(start, end);

      if (start > 0) {
        excerpt = '…' + excerpt;
      }

      if (end < clean.length) {
        excerpt += '…';
      }

      return excerpt;

    }


    function updateUrl(term) {

      const url =
        new URL(window.location.href);

      url.search = '';

      if (term) {
        url.searchParams.set('q', term);
      }

      window.history.replaceState(
        {},
        '',
        url
      );

    }


    function renderPromptCard(prompt, term) {

      const preview =
        getMatchedWords(
          prompt.prompt,
          term
        );


      return `
        <a
          class="result-card"
          href="/prompt/${encodeURIComponent(prompt.id)}/"
        >

          <div class="result-card-top">

            <span class="eyebrow">
              ${escapeHTML(prompt.category)}
            </span>

            <span class="result-type">
              Prompt
            </span>

          </div>

          <h3>
            ${escapeHTML(prompt.title)}
          </h3>

          <p>
            ${escapeHTML(preview)}
          </p>

          <div class="tags">

            ${(prompt.tags || [])
              .slice(0, 3)
              .map(
                tag =>
                  `<span class="tag">#${escapeHTML(tag)}</span>`
              )
              .join('')}

          </div>

          <span class="result-link">
            View prompt →
          </span>

        </a>
      `;

    }


    function renderBlogCard(blog, term) {

      const preview =
        getMatchedWords(
          blog.excerpt,
          term
        );


      return `
        <a
          class="result-card"
          href="/blog/${encodeURIComponent(blog.id)}/"
        >

          <div class="result-card-top">

            <span class="eyebrow">
              ${escapeHTML(blog.category)}
            </span>

            <span class="result-type">
              Guide
            </span>

          </div>

          <h3>
            ${escapeHTML(blog.title)}
          </h3>

          <p>
            ${escapeHTML(preview)}
          </p>

          <div class="result-meta">
            ${escapeHTML(blog.readTime || '')}
            ${blog.readTime && blog.date ? ' · ' : ''}
            ${escapeHTML(blog.date || '')}
          </div>

          <span class="result-link">
            Read guide →
          </span>

        </a>
      `;

    }


    function renderCategoryMatches(term) {

      const normalized =
        normalize(term);

      const promptMatches =
        promptCategories.filter(
          category =>
            normalize(category)
              .includes(normalized)
        );

      const blogMatches =
        blogCategories.filter(
          category =>
            normalize(category)
              .includes(normalized)
        );


      const matches = [
        ...promptMatches.map(
          category => ({
            category,
            type: 'Prompt Category',
            url:
              `/prompts/${encodeURIComponent(
                category.toLowerCase()
              )}/`
          })
        ),

        ...blogMatches.map(
          category => ({
            category,
            type: 'Blog Topic',
            url:
              `/blog/?category=${encodeURIComponent(
                category
              )}`
          })
        )
      ];


      if (!matches.length) {
        return '';
      }


      return `
        <section class="search-section category-results">

          <div class="section-heading compact">

            <div>
              <div class="eyebrow">
                Categories
              </div>

              <h2>
                Matching Topics
              </h2>
            </div>

          </div>

          <div class="category-results-grid">

            ${matches
              .slice(0, 6)
              .map(
                match => `
                  <a
                    class="category-result"
                    href="${match.url}"
                  >

                    <span>
                      ${escapeHTML(match.type)}
                    </span>

                    <strong>
                      ${escapeHTML(match.category)}
                    </strong>

                    <b>
                      Explore →
                    </b>

                  </a>
                `
              )
              .join('')}

          </div>

        </section>
      `;

    }


    function render() {

      const term =
        input.value.trim();

      const normalized =
        normalize(term);


      if (!normalized) {

        results.innerHTML = `

          <div class="search-start">

            <div class="search-start-icon">
              ⌕
            </div>

            <div class="eyebrow">
              Search the library
            </div>

            <h2>
              What are you looking for?
            </h2>

            <p>
              Search across AI prompts and CreateLoom
              creator guides using keywords, categories
              or topics.
            </p>

          </div>

        `;

        return;

      }


      const promptResults =
        data.prompts
          .filter(
            prompt =>
              searchablePrompt(prompt)
                .includes(normalized)
          )
          .slice(0, 8);


      const blogResults =
        data.blogs
          .filter(
            blog =>
              searchableBlog(blog)
                .includes(normalized)
          )
          .slice(0, 8);


      const total =
        promptResults.length +
        blogResults.length;


      let html = `

        <div class="search-result-header">

          <div>

            <div class="eyebrow">
              Search results
            </div>

            <h2>
              Results for
              <span>
                "${escapeHTML(term)}"
              </span>
            </h2>

          </div>

          <div class="result-count">
            ${total}
            ${total === 1 ? 'result' : 'results'}
          </div>

        </div>

      `;


      html +=
        renderCategoryMatches(term);


      if (promptResults.length) {

        html += `

          <section class="search-section">

            <div class="section-heading compact">

              <div>
                <div class="eyebrow">
                  AI Image Library
                </div>

                <h2>
                  Prompts
                </h2>
              </div>

              <a
                href="/prompts/"
                class="text-link"
              >
                View all →
              </a>

            </div>

            <div class="grid">

              ${promptResults
                .map(
                  prompt =>
                    renderPromptCard(
                      prompt,
                      normalized
                    )
                )
                .join('')}

            </div>

          </section>

        `;

      }


      if (blogResults.length) {

        html += `

          <section class="search-section">

            <div class="section-heading compact">

              <div>
                <div class="eyebrow">
                  Creator Resources
                </div>

                <h2>
                  Blog Guides
                </h2>
              </div>

              <a
                href="/blog/"
                class="text-link"
              >
                View all →
              </a>

            </div>

            <div class="grid">

              ${blogResults
                .map(
                  blog =>
                    renderBlogCard(
                      blog,
                      normalized
                    )
                )
                .join('')}

            </div>

          </section>

        `;

      }


      if (
        !promptResults.length &&
        !blogResults.length
      ) {

        html += `

          <div class="no-results">

            <div class="no-results-icon">
              ⌕
            </div>

            <h3>
              No matching content
            </h3>

            <p>
              We couldn't find anything for
              <strong>
                "${escapeHTML(term)}"
              </strong>.
            </p>

            <div class="suggestions">

              <span>Try:</span>

              <button
                type="button"
                data-suggestion="couple"
              >
                couple
              </button>

              <button
                type="button"
                data-suggestion="selfie"
              >
                selfie
              </button>

              <button
                type="button"
                data-suggestion="portrait"
              >
                portrait
              </button>

              <button
                type="button"
                data-suggestion="instagram"
              >
                Instagram
              </button>

              <button
                type="button"
                data-suggestion="brand"
              >
                brand
              </button>

            </div>

          </div>

        `;

      }


      results.innerHTML = html;


      document
        .querySelectorAll('[data-suggestion]')
        .forEach(button => {

          button.addEventListener(
            'click',
            () => {

              input.value =
                button.dataset.suggestion;

              updateUrl(
                input.value
              );

              render();

              window.scrollTo({
                top: 0,
                behavior: 'smooth'
              });

            }
          );

        });

    }


    form.addEventListener(
      'submit',
      event => {

        event.preventDefault();

        const query =
          input.value.trim();

        updateUrl(query);

        render();

      }
    );


    input.addEventListener(
      'input',
      () => {

        if (!input.value.trim()) {
          updateUrl('');
        }

        render();

      }
    );


    quickButtons.forEach(
      button => {

        button.addEventListener(
          'click',
          () => {

            input.value =
              button.dataset.quick;

            updateUrl(
              input.value
            );

            render();

            window.scrollTo({
              top: 0,
              behavior: 'smooth'
            });

          }
        );

      }
    );


    render();

  </script>

</Layout>


<style>

  .search-hero {
    padding-bottom: 45px;
  }


  .hero-description {
    max-width: 720px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.8;
  }


  .global-search {
    max-width: 720px;
    margin: 28px auto 0;
  }


  .quick-searches {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 18px;
    color: var(--muted, #a1a1aa);
    font-size: 0.78rem;
  }


  .quick-searches button {
    padding: 5px 10px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 999px;
    background: rgba(255,255,255,0.03);
    color: #c4b5fd;
    cursor: pointer;
  }


  .quick-searches button:hover {
    border-color: rgba(139,92,246,0.4);
    background: rgba(139,92,246,0.08);
  }


  .search-start {
    max-width: 680px;
    margin: 10px auto 0;
    padding: 60px 25px;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 22px;
    background: rgba(255,255,255,0.02);
  }


  .search-start-icon {
    margin-bottom: 15px;
    color: #a78bfa;
    font-size: 2.4rem;
  }


  .search-start h2 {
    margin: 8px 0 10px;
  }


  .search-start p {
    max-width: 560px;
    margin: 0 auto;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
  }


  .search-result-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 28px;
  }


  .search-result-header h2 {
    margin: 8px 0 0;
  }


  .search-result-header h2 span {
    color: #c4b5fd;
  }


  .result-count {
    color: var(--muted, #a1a1aa);
    font-size: 0.82rem;
    white-space: nowrap;
  }


  .search-section {
    margin-top: 50px;
  }


  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    margin-bottom: 22px;
  }


  .section-heading.compact h2 {
    margin: 7px 0 0;
  }


  .text-link {
    color: #c4b5fd;
    text-decoration: none;
    font-weight: 700;
    white-space: nowrap;
  }


  .result-card {
    display: flex;
    flex-direction: column;
    min-height: 245px;
    padding: 21px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 17px;
    background: rgba(255,255,255,0.025);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }


  .result-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,0.4);
    background: rgba(139,92,246,0.05);
  }


  .result-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }


  .result-type {
    color: rgba(255,255,255,0.38);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }


  .result-card h3 {
    margin: 13px 0 10px;
    color: #fff;
    line-height: 1.4;
  }


  .result-card p {
    margin: 0;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
    font-size: 0.88rem;
  }


  .result-card .tags {
    margin-top: 16px;
  }


  .result-link {
    display: inline-block;
    margin-top: auto;
    padding-top: 18px;
    color: #c4b5fd;
    font-size: 0.82rem;
    font-weight: 700;
  }


  .result-meta {
    margin-top: 15px;
    color: rgba(255,255,255,0.4);
    font-size: 0.75rem;
  }


  .category-results-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }


  .category-result {
    display: flex;
    flex-direction: column;
    padding: 17px;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    background: rgba(255,255,255,0.02);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease;
  }


  .category-result:hover {
    border-color: rgba(139,92,246,0.35);
  }


  .category-result span {
    color: #a78bfa;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
  }


  .category-result strong {
    margin: 7px 0 12px;
    color: #fff;
  }


  .category-result b {
    color: #c4b5fd;
    font-size: 0.75rem;
  }


  .no-results {
    margin-top: 35px;
    padding: 60px 25px;
    text-align: center;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 22px;
    background: rgba(255,255,255,0.02);
  }


  .no-results-icon {
    color: #a78bfa;
    font-size: 2.3rem;
  }


  .no-results h3 {
    margin: 10px 0 5px;
  }


  .no-results p {
    color: var(--muted, #a1a1aa);
  }


  .suggestions {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    color: var(--muted, #a1a1aa);
    font-size: 0.8rem;
  }


  .suggestions button {
    padding: 6px 11px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 999px;
    background: rgba(255,255,255,0.03);
    color: #c4b5fd;
    cursor: pointer;
  }


  .browse-section {
    background: rgba(255,255,255,0.015);
  }


  .browse-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }


  .browse-card {
    display: flex;
    flex-direction: column;
    min-height: 230px;
    padding: 23px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 18px;
    background: rgba(255,255,255,0.025);
    color: inherit;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }


  .browse-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,0.35);
  }


  .browse-icon {
    color: #a78bfa;
    font-size: 1.4rem;
  }


  .browse-card h3 {
    margin: 13px 0 8px;
    color: #fff;
  }


  .browse-card p {
    margin: 0;
    color: var(--muted, #a1a1aa);
    line-height: 1.7;
    font-size: 0.88rem;
  }


  .browse-card strong {
    margin-top: auto;
    padding-top: 20px;
    color: #c4b5fd;
    font-size: 0.82rem;
  }


  @media (max-width: 800px) {

    .category-results-grid,
    .browse-grid {
      grid-template-columns: 1fr;
    }

  }


  @media (max-width: 600px) {

    .search-result-header,
    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .quick-searches {
      justify-content: flex-start;
    }

  }

</style>
