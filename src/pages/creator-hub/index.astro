<style>
  .creator-hero {
    padding-bottom: 50px;
  }

  .hero-copy {
    max-width: 760px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 850px;
    margin-top: 46px;
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    background: rgba(255,255,255,.025);
  }

  .stat {
    padding: 22px;
    border-right: 1px solid var(--border);
  }

  .stat:last-child {
    border-right: 0;
  }

  .stat strong {
    display: block;
    font-size: 28px;
    letter-spacing: -.04em;
  }

  .stat span {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 13px;
  }

  .section-heading {
