---
import '../styles/global.css';

const {
  title = 'Create With Soumay — AI Prompts & Creator Resources',
  description = 'Discover AI image prompts, Instagram creator resources, Reel ideas, growth guides and more with Create With Soumay.',
  active = '',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  ogImage,
  ogImageAlt = 'Create With Soumay — AI Prompts & Creator Resources'
} = Astro.props;

const nav = [
  ['Home', '/'],
  ['Prompts', '/prompts/'],
  ['Creator Hub', '/creator-hub/'],
  ['Blog', '/blog/'],
  ['Brands', '/brands/'],
  ['Favorites', '/favorites/']
];

const creatorHubLinks = [
  {
    label: 'Creator Hub',
    url: '/creator-hub/',
    icon: '🧭',
    desc: 'Browse the full creator toolkit'
  },
  {
    label: 'Trending Instagram Hashtags',
    url: '/creator-tools/trending-hashtags/',
    icon: '#',
    desc: 'Curated hashtag sets for Reels',
    badge: 'NEW'
  },
  {
    label: 'Reel Ideas & Growth',
    url: '/creator-hub/#reel-ideas',
    icon: '🎬',
    desc: 'Fresh ideas to keep posting'
  },
  {
    label: 'Brand Deals',
    url: '/creator-hub/#brand-deals',
    icon: '🤝',
    desc: 'Pitch, price and land collabs'
  },
  {
    label: 'Media Kit',
    url: '/creator-hub/#media-kit',
    icon: '📇',
    desc: 'Build your creator profile'
  }
];

const siteName = 'Create With Soumay';
const siteUrl = 'https://createwithsoumay.store';

const canonical = new URL(
  Astro.url.pathname,
  Astro.site || siteUrl
);

const canonicalHref = canonical.href;
const defaultOgImage = `${siteUrl}/images/createloom-logo.png`;
const resolvedOgImage = ogImage || defaultOgImage;

const year = new Date().getFullYear();
---

<html lang="en">
<head>
<!-- Google tag (gtag.js) -->
<script
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-12W9ZPFSFG"
></script>


<script is:inline>
  window.dataLayer = window.dataLayer || [];

  function gtag() {
    window.dataLayer.push(arguments);
  }

  gtag('js', new Date());
  gtag('config', 'G-12W9ZPFSFG');
</script>
  <meta charset="utf-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  />

  <meta
    name="google-site-verification"
    content="xGY9a0sGJrY8z7fgWek6AN0Y5K0FjYj47oOj3r-_RCw"
  />

  <title>{title}</title>

  <meta
    name="description"
    content={description}
  />

  <meta
    name="robots"
    content={robots}
  />

  <meta
    name="googlebot"
    content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  />

  <meta name="google-adsense-account" content="ca-pub-1438137309361519"/>


  <meta
    name="theme-color"
    content="#08070d"
  />

  <meta
    name="color-scheme"
    content="dark"
  />

  <link
    rel="canonical"
    href={canonicalHref}
  />
  <link
  rel="alternate"
  type="application/rss+xml"
  title="Create With Soumay Blog"
  href={new URL('/rss.xml', Astro.site ?? siteUrl).href}
/>
  <link
    rel="sitemap"
    type="application/xml"
    href="/sitemap.xml"
  />

  <!-- Open Graph -->
  <meta
    property="og:type"
    content="website"
  />

  <meta
    property="og:site_name"
    content={siteName}
  />

  <meta
    property="og:locale"
    content="en_US"
  />

  <meta
    property="og:title"
    content={title}
  />

  <meta
    property="og:description"
    content={description}
  />

  <meta
    property="og:url"
    content={canonicalHref}
  />

  <meta
    property="og:image"
    content={resolvedOgImage}
  />

  <meta
    property="og:image:alt"
    content={ogImageAlt}
  />

  <!-- Twitter / X -->
  <meta
    name="twitter:card"
    content="summary"
  />

  <meta
    name="twitter:title"
    content={title}
  />

  <meta
    name="twitter:description"
    content={description}
  />

  <meta
    name="twitter:image"
    content={resolvedOgImage}
  />

  <meta
    name="twitter:image:alt"
    content={ogImageAlt}
  />

  <!-- Performance -->
  <link
    rel="dns-prefetch"
    href="//www.google.com"
  />
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1438137309361519"
     crossorigin="anonymous"></script>

  <!-- Global site identity -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: `${siteUrl}/`,
      description:
        'AI image prompts and creator resources for Instagram creators.',
      potentialAction: {
        '@type': 'SearchAction',
        target: `${siteUrl}/search/?q={search_term_string}`,
        'query-input':
          'required name=search_term_string'
      }
    })}
  />
</head>

<body>

  <!-- Accessibility -->
  
  <a
    class="skip-link"
    href="#main-content"
  >
    Skip to content
  </a>

  <!-- Header -->
  <header class="site-header">

    <div class="container nav">

      <!-- Brand -->
      
        <a
        class="brand"
        href="/"
        aria-label="Create With Soumay home"
      >
        <span class="logo" aria-hidden="true">
          <img
            src="/images/createloom-logo.png"
            alt=""
            width="40"
            height="40"
            loading="eager"
            decoding="async"
          />
        </span>

        <span>Create With Soumay</span>
      </a>

      <!-- Desktop navigation -->
      <nav
        class="nav-links"
        aria-label="Main navigation"
      >
        {
          nav.map(([label, url]) =>
            label === 'Creator Hub' ? (
              <div class="nav-dropdown">
                <div class="nav-dropdown-trigger">
                  
                  <a
                    class:list={{ active: active === label }}
                    href={url}
                  >
                    Creator Hub
                  </a>
                  <button
                    class="nav-dropdown-toggle"
                    type="button"
                    aria-label="Toggle Creator Hub menu"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    <span class="nav-chevron" aria-hidden="true">⌄</span>
                  </button>
                </div>

                <div class="nav-dropdown-menu">
                  <span class="nav-dropdown-heading">Creator Hub</span>

                  {
                    creatorHubLinks.map((item) => (
                      
                      <a
                        href={item.url}
                        class:list={{ 'nav-dropdown-featured': !!item.badge }}
                        aria-current={
                          item.url === Astro.url.pathname
                            ? 'page'
                            : undefined
                        }
                      >
                        <span class="nav-dropdown-icon" aria-hidden="true">{item.icon}</span>

                        <span class="nav-dropdown-text">
                          <span class="nav-dropdown-label">
                            {item.label}
                            {item.badge && <span class="nav-hot" aria-hidden="true">{item.badge}</span>}
                          </span>
                          <span class="nav-dropdown-desc">{item.desc}</span>
                        </span>
                      </a>
                    ))
                  }
                </div>
              </div>
            ) : (
              
              <a
                class:list={{ active: active === label }}
                href={url}
                aria-current={
                  active === label
                    ? 'page'
                    : undefined
                }
              >
                {label}
              </a>
            )
          )
        }
      </nav>

      <!-- Header search -->
      <form
        class="header-search"
        action="/search/"
        role="search"
      >
        <span
          aria-hidden="true"
          class="search-icon"
        >
          ⌕
        </span>

        <input
          name="q"
          placeholder="Search"
          aria-label="Search Create With Soumay"
          autocomplete="off"
        />
      </form>

      <!-- Mobile menu -->
      <button
        class="mobile-menu"
        type="button"
        aria-label="Open navigation"
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span aria-hidden="true">☰</span>
      </button>

    </div>

    <!-- Mobile navigation -->
    <div
      class="mobile-nav"
      id="mobile-navigation"
      hidden
    >
      <div class="container">

        <nav
          aria-label="Mobile navigation"
        >
          {
            nav.map(([label, url]) =>
              label === 'Creator Hub' ? (
                <div class="mobile-nav-group">
                  
                  <a
                    class:list={{ active: active === label }}
                    href={url}
                    aria-current={
                      active === label
                        ? 'page'
                        : undefined
                    }
                  >
                    Creator Hub
                  </a>

                  <div class="mobile-nav-subnav" aria-label="Creator Hub resources">
                    {
                      creatorHubLinks.slice(1).map((item) => (
                        
                        <a
                          href={item.url}
                          class:list={{ 'mobile-nav-featured': !!item.badge }}
                          aria-current={
                            item.url === Astro.url.pathname
                              ? 'page'
                              : undefined
                          }
                        >
                          <span class="nav-dropdown-icon" aria-hidden="true">{item.icon}</span>

                          <span class="nav-dropdown-text">
                            <span class="nav-dropdown-label">
                              {item.label}
                              {item.badge && <span class="nav-hot" aria-hidden="true">{item.badge}</span>}
                            </span>
                            <span class="nav-dropdown-desc">{item.desc}</span>
                          </span>
                        </a>
                      ))
                    }
                  </div>
                </div>
              ) : (
                
                <a
                  class:list={{ active: active === label }}
                  href={url}
                  aria-current={
                    active === label
                      ? 'page'
                      : undefined
                  }
                >
                  {label}
                </a>
              )
            )
          }

          <a href="/search/">
            Search everything
          </a>
        </nav>

      </div>
    </div>

  </header>

  <!-- Main -->
  <main id="main-content">
    <slot />
  </main>

  <!-- Screen-reader announcements -->
  <div
    id="site-status"
    class="sr-only"
    aria-live="polite"
    aria-atomic="true"
  ></div>

  <!-- Footer -->
  <footer class="footer">

    <div class="container footer-grid">

      <!-- Brand -->
      <div class="footer-brand">

        
        <a
          class="brand"
          href="/"
          aria-label="Create With Soumay home"
        >
          <span class="logo" aria-hidden="true">
            <img
              src="/images/createloom-logo.png"
              alt=""
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
            />
          </span>

          <span>Create With Soumay</span>
        </a>

        <p>
          AI prompts and creator resources for your next idea.
        </p>

      </div>

      <!-- Prompts -->
      <div>
        <h4>Prompts</h4>

        <a href="/prompts/">
          All Prompts
        </a>

        <a href="/prompts/#categories">
          Categories
        </a>

        <a href="/prompts/#latest">
          Latest
        </a>
      </div>

      <!-- Creator Hub -->
      <div>
        <h4>Creator Hub</h4>

        <a href="/creator-hub/">
          Reels & Growth
        </a>

        <a href="/creator-hub/#brand-deals">
          Brand Deals
        </a>

        <a href="/brands/">
          Work With Us
        </a>
      </div>

      <!-- Company -->
      <div>
        <h4>Company</h4>

        <a href="/about/">
          About
        </a>

        <a href="/contact/">
          Contact
        </a>

        <a href="/privacy/">
          Privacy
        </a>

        <a href="/terms/">
          Terms
        </a>
      </div>

    </div>

    <div class="container footer-bottom">

      <span>
        © {year} Create With Soumay. All rights reserved.
      </span>

      <span>
        Built for creators.
      </span>

    </div>

  </footer>

  <script is:inline>
    (() => {
      const menu =
        document.querySelector('.mobile-menu');

      const mobileNav =
        document.querySelector('.mobile-nav');

      const status =
        document.querySelector('#site-status');

      /*
       * Mobile navigation
       */
      const setMenu = (open) => {
        if (!menu || !mobileNav) return;

        menu.setAttribute(
          'aria-expanded',
          String(open)
        );

        menu.setAttribute(
          'aria-label',
          open
            ? 'Close navigation'
            : 'Open navigation'
        );

        mobileNav.hidden = !open;

        document.body.classList.toggle(
          'menu-open',
          open
        );
      };

      menu?.addEventListener(
        'click',
        () => {
          const open =
            menu.getAttribute(
              'aria-expanded'
            ) === 'true';

          setMenu(!open);
        }
      );

      mobileNav?.addEventListener(
        'click',
        (event) => {
          const link =
            event.target.closest('a');

          if (link) {
            setMenu(false);
          }
        }
      );

      document.addEventListener(
        'keydown',
        (event) => {
          if (
            event.key === 'Escape' &&
            menu?.getAttribute(
              'aria-expanded'
            ) === 'true'
          ) {
            setMenu(false);
            menu.focus();
          }
        }
      );

      /*
       * Desktop Creator Hub dropdown
       */
      const creatorDropdown = document.querySelector('.nav-dropdown');
      const creatorDropdownToggle = document.querySelector('.nav-dropdown-toggle');

      const setCreatorDropdown = (open) => {
        if (!creatorDropdown || !creatorDropdownToggle) return;
        creatorDropdown.classList.toggle('is-open', open);
        creatorDropdownToggle.setAttribute('aria-expanded', String(open));
      };

      creatorDropdownToggle?.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        const open = creatorDropdown?.classList.contains('is-open');
        setCreatorDropdown(!open);
      });

      document.addEventListener('click', (event) => {
        if (creatorDropdown && !creatorDropdown.contains(event.target)) {
          setCreatorDropdown(false);
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setCreatorDropdown(false);
      });

      /*
       * Announcements
       */
      const announce = (message) => {
        if (!status) return;

        status.textContent = '';

        requestAnimationFrame(() => {
          status.textContent = message;
        });
      };

      /*
       * Google Analytics events
       *
       * Keep event names stable so reports can be
       * configured without changing the UI.
       */
      const trackEvent = (name, params = {}) => {
        if (typeof window.gtag !== 'function') return;

        window.gtag('event', name, {
          page_path: window.location.pathname,
          ...params
        });
      };

      const getPromptId = (element) => {
        if (!element) return '';

        const source =
          element.closest('[data-prompt-id]') ||
          element.closest('[data-fav]');

        return (
          source?.dataset?.promptId ||
          source?.dataset?.fav ||
          ''
        );
      };

      /*
       * Favorites
       *
       * Keep this key compatible with the
       * prompt detail pages.
       */
      const favKey =
        'createloom-favorites';

      const readFavs = () => {
        try {
          const value =
            localStorage.getItem(favKey);

          const parsed =
            JSON.parse(value || '[]');

          return Array.isArray(parsed)
            ? parsed
            : [];
        } catch {
          return [];
        }
      };

      const writeFavs = (favorites) => {
        try {
          localStorage.setItem(
            favKey,
            JSON.stringify(favorites)
          );

          return true;
        } catch {
          return false;
        }
      };

      const syncFavs = () => {
        const favs = readFavs();

        document
          .querySelectorAll('.fav-btn')
          .forEach((button) => {

            const saved =
              favs.includes(
                button.dataset.fav
              );

            const icon =
              button.querySelector(
                '[aria-hidden="true"]'
              );

            if (icon) {
              icon.textContent =
                saved ? '♥' : '♡';
            } else {
              button.textContent =
                saved ? '♥' : '♡';
            }

            button.setAttribute(
              'aria-pressed',
              String(saved)
            );

            button.classList.toggle(
              'saved',
              saved
            );

            button.setAttribute(
              'title',
              saved
                ? 'Remove from favorites'
                : 'Save to favorites'
            );
          });
      };

      /*
       * Temporary button feedback
       */
      const flash = (
        element,
        text,
        delay = 1400
      ) => {
        if (!element) return;

        const original =
          element.dataset.originalText ||
          element.textContent;

        element.dataset.originalText =
          original;

        element.textContent = text;

        window.setTimeout(() => {
          element.textContent =
            original;

          delete element.dataset.originalText;
        }, delay);
      };

      /*
       * Clipboard fallback
       */
      const copyText = async (text) => {
        if (!text) return false;

        try {
          if (
            navigator.clipboard &&
            window.isSecureContext
          ) {
            await navigator.clipboard.writeText(
              text
            );

            return true;
          }
        } catch {}

        try {
          const textarea =
            document.createElement('textarea');

          textarea.value = text;

          textarea.setAttribute(
            'readonly',
            ''
          );

          textarea.style.position =
            'fixed';

          textarea.style.opacity = '0';

          document.body.appendChild(
            textarea
          );

          textarea.select();

          const success =
            document.execCommand('copy');

          textarea.remove();

          return success;
        } catch {
          return false;
        }
      };

      /*
       * Global actions
       */
      document.addEventListener(
        'click',
        async (event) => {

          /*
           * Copy prompt
           */
          const copy =
            event.target.closest(
              '.copy-btn'
            );

          if (copy) {
            const success =
              await copyText(
                copy.dataset.copy || ''
              );

            if (success) {
              flash(copy, '✓ Copied');
              trackEvent('prompt_copied', {
                prompt_id: getPromptId(copy),
                prompt_url: window.location.pathname
              });
              announce(
                'Prompt copied to clipboard.'
              );
            } else {
              flash(
                copy,
                'Copy failed'
              );

              announce(
                'Unable to copy the prompt.'
              );
            }

            return;
          }

          /*
           * Share
           */
          const share =
            event.target.closest(
              '.share-btn'
            );

          if (share) {

            const url =
              new URL(
                share.dataset.url ||
                  location.href,
                location.origin
              ).href;

            try {

              if (
                typeof navigator.share ===
                'function'
              ) {

                await navigator.share({
                  title:
                    document.title,
                  url
                });

                trackEvent('prompt_shared', {
                  prompt_id: getPromptId(share),
                  prompt_url: url
                });

                announce(
                  'Share dialog opened.'
                );

              } else {

                const success =
                  await copyText(url);

                if (success) {
                  flash(
                    share,
                    '✓ Link Copied'
                  );

                  trackEvent('prompt_shared', {
                    prompt_id: getPromptId(share),
                    prompt_url: url
                  });

                  announce(
                    'Page link copied to clipboard.'
                  );
                } else {
                  flash(
                    share,
                    'Copy failed'
                  );
                }
              }

            } catch {
              /*
               * Sharing can be cancelled
               * by the user. No action needed.
               */
            }

            return;
          }

          /*
           * Favorite
           */
          const fav =
            event.target.closest(
              '.fav-btn'
            );

          if (fav) {

            const id =
              fav.dataset.fav;

            if (!id) return;

            const favorites =
              readFavs();

            const index =
              favorites.indexOf(id);

            const saving =
              index === -1;

            if (saving) {
              favorites.push(id);
            } else {
              favorites.splice(
                index,
                1
              );
            }

            const saved =
              writeFavs(favorites);

            if (!saved) {
              announce(
                'Favorites could not be saved in this browser.'
              );

              return;
            }

            syncFavs();

            trackEvent('prompt_favorited', {
              prompt_id: id,
              action: saving ? 'save' : 'remove',
              prompt_url: window.location.pathname
            });

            window.dispatchEvent(
              new CustomEvent(
                'createloom:favorites-changed',
                {
                  detail: {
                    id,
                    saved: saving,
                    favorites: [...favorites]
                  }
                }
              )
            );

            announce(
              saving
                ? 'Prompt saved to favorites.'
                : 'Prompt removed from favorites.'
            );
          }
        }
      );

      /*
       * Initial favorite state
       */
      syncFavs();
    })();
  </script>

</body>
</html>

<style>
  /*
   * Accessibility
   */

  .skip-link {
    position: fixed;
    left: 16px;
    top: 10px;
    z-index: 9999;
    padding: 10px 14px;
    border-radius: 9px;
    background: #fff;
    color: #09090b;
    font-size: .85rem;
    font-weight: 800;
    text-decoration: none;
    transform: translateY(-150%);
    transition: transform .2s ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .brand .logo {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    flex: 0 0 40px;
    overflow: hidden;
    border-radius: 11px;
  }

  .brand .logo img {
    display: block;
    width: 40px;
    height: 40px;
    max-width: 100%;
    object-fit: cover;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /*
   * Search
   */

  .header-search {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .search-icon {
    color: var(--muted, #a1a1aa);
    font-size: 1.05rem;
    line-height: 1;
  }

  /*
   * Creator Hub navigation dropdown
   */

  .nav-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
  }

  .nav-dropdown-trigger > a {
    display: inline-flex;
    align-items: center;
  }

  .nav-dropdown-toggle {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 30px;
    margin-left: 1px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted, #a1a1aa);
    cursor: pointer;
    transition: color .16s ease;
  }

  .nav-dropdown-toggle:hover,
  .nav-dropdown-toggle:focus-visible {
    color: #fff;
  }

  .nav-chevron {
    display: inline-block;
    font-size: .78rem;
    line-height: 1;
    color: var(--muted, #a1a1aa);
    transform: translateY(-1px);
    transition: transform .18s ease;
  }

  .nav-dropdown.is-open .nav-chevron,
  .nav-dropdown:focus-within .nav-chevron {
    transform: translateY(-1px) rotate(180deg);
    color: #fff;
  }

