---
const { p } = Astro.props;

const bestFor =
  p.bestFor ||
  p.best_for ||
  `AI ${p.category.toLowerCase()} image creation`;

const description =
  p.description ||
  `A ready-to-use ${p.category.toLowerCase()} AI image prompt for creative image generation.`;

const tags = Array.isArray(p.tags) ? p.tags.slice(0, 3) : [];
const tools = Array.isArray(p.tools) ? p.tools : [];

const trendStatus = p.trendStatus || '';
const showTrending = p.trending === true;

const trendLabel =
  trendStatus === 'hot'
    ? '🔥 Hot'
    : trendStatus === 'rising'
      ? '📈 Rising'
      : trendStatus === 'seasonal'
        ? 'Seasonal'
        : trendStatus === 'evergreen'
          ? 'Evergreen'
          : 'Trending';

const trendClass =
  trendStatus === 'hot'
    ? 'trend-hot'
    : trendStatus === 'rising'
      ? 'trend-rising'
      : trendStatus === 'seasonal'
        ? 'trend-seasonal'
        : trendStatus === 'evergreen'
          ? 'trend-evergreen'
          : 'trend-current';
---

<article
  class="card prompt-card"
  data-title={p.title}
  data-category={p.category}
  data-type={p.type || 'Unisex'}
  data-tools={tools.join(' ')}
  data-trending={String(p.trending === true)}
  data-trend-status={trendStatus}
  data-tags={Array.isArray(p.tags) ? p.tags.join(' ') : ''}
  data-search-terms={Array.isArray(p.searchTerms) ? p.searchTerms.join(' ') : ''}
  data-prompt={p.prompt}
  data-description={description}
  data-prompt-id={p.id}
  data-created-at={p.createdAt || ''}
>
  <!-- Visual result preview -->
  <a
    class="prompt-card-image-link"
    href={`/prompt/${p.id}/`}
    aria-label={`View ${p.title} result preview`}
  >
    <div class="prompt-card-image-wrap">
      <img
        class="prompt-card-image"
        src={p.image || '/images/prompts/createloom.png'}
        alt={`Example result for ${p.title} AI image prompt`}
        width="1080"
        height="1920"
        loading="lazy"
        decoding="async"
      />
    </div>
  </a>

  <!-- Card metadata -->
  <div class="prompt-meta">
    <div class="meta-left">
      <a
        class="category-link"
        href={`/prompts/${p.category.toLowerCase()}/`}
        aria-label={`Browse ${p.category} AI prompts`}
      >
        {p.category}
      </a>

      {p.type && (
        <span class="type-badge" aria-label={`Prompt type: ${p.type}`}>
          {p.type}
        </span>
      )}
    </div>

    {showTrending && (
      <span class:list={['trend-badge', trendClass]}>
        {trendLabel}
      </span>
    )}
  </div>

  <!-- Favorite -->
  <button
    class="icon-btn fav-btn"
    data-fav={p.id}
    type="button"
    aria-label={`Save ${p.title} to favorites`}
    aria-pressed="false"
    title="Save to favorites"
  >
    <span aria-hidden="true">♡</span>
  </button>

  <!-- Main card content -->
  <a
    class="prompt-card-main"
    href={`/prompt/${p.id}/`}
    aria-label={`Open ${p.title}`}
  >
    <div class="title-row">
      <h3>{p.title}</h3>
      <span class="open-arrow" aria-hidden="true">↗</span>
    </div>

    <p class="prompt-preview">
      {description}
    </p>

    {tools.length > 0 && (
      <div class="tools-row" aria-label="Compatible AI tools">
        <span class="tools-label">Works with</span>
        <div class="tool-list">
          {tools.slice(0, 3).map((tool) => (
            <span class="tool-badge">{tool}</span>
          ))}
        </div>
      </div>
    )}

    {p.referenceImageRequired === true && (
      <div class="reference-indicator">
        <span aria-hidden="true">◉</span>
        Needs your photo
      </div>
    )}

    <div class="best-for">
      <span>Best for</span>
      <strong>{bestFor}</strong>
    </div>

    {tags.length > 0 && (
      <div class="tags" aria-label="Prompt tags">
        {tags.map((tag) => (
          <span class="tag">#{tag}</span>
        ))}
      </div>
    )}
  </a>

  <!-- Actions -->
  <div class="card-actions">
    <button
      class="small-btn copy-btn"
      data-copy={p.prompt}
      type="button"
      aria-label={`Copy ${p.title} prompt`}
    >
      <span aria-hidden="true">📋</span>
      Copy
    </button>

    <button
      class="small-btn share-btn"
      data-url={`/prompt/${p.id}/`}
      type="button"
      aria-label={`Share ${p.title}`}
    >
      <span aria-hidden="true">🔗</span>
      Share
    </button>

    <a
      class="small-btn open-btn"
      href={`/prompt/${p.id}/`}
      aria-label={`Open ${p.title}`}
    >
      Open
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>

<style>
  .prompt-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    height: 100%;
    padding: 20px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 18px;
    background:
      linear-gradient(
        145deg,
        rgba(255,255,255,.035),
        rgba(255,255,255,.018)
      );
    transition:
      transform .22s ease,
      border-color .22s ease,
      box-shadow .22s ease;
  }

  .prompt-card:hover {
    transform: translateY(-3px);
    border-color: rgba(139,92,246,.32);
    box-shadow: 0 14px 40px rgba(0,0,0,.18);
  }

  .prompt-card-image-link {
    display: block;
    margin: -20px -20px 18px;
    color: inherit;
    text-decoration: none;
  }

  .prompt-card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 12;
    overflow: hidden;
    background: #0d0c13;
    border-bottom: 1px solid rgba(255,255,255,.075);
  }

  .prompt-card-image-wrap::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(0,0,0,0) 68%, rgba(0,0,0,.2));
  }

  .prompt-card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform .35s ease;
  }

  .prompt-card:hover .prompt-card-image {
    transform: scale(1.025);
  }

  .prompt-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    padding-right: 42px;
  }

  .meta-left {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    min-width: 0;
  }

  .category-link {
    display: inline-flex;
    align-items: center;
    width: fit-content;
    color: #a78bfa;
    text-decoration: none;
    font-size: .69rem;
    font-weight: 850;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  .category-link:hover {
    color: #ddd6fe;
  }

  .category-link::after {
    content: "→";
    margin-left: 5px;
    opacity: 0;
    transform: translateX(-3px);
    transition:
      opacity .18s ease,
      transform .18s ease;
  }

  .category-link:hover::after {
    opacity: 1;
    transform: translateX(0);
  }

  .type-badge,
  .trend-badge,
  .tool-badge,
  .reference-indicator {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .type-badge {
    padding: 4px 7px;
    border: 1px solid rgba(255,255,255,.07);
    border-radius: 999px;
    background: rgba(255,255,255,.025);
    color: #aaaab3;
    font-size: .64rem;
    font-weight: 700;
  }

  .trend-badge {
    flex: 0 0 auto;
    padding: 4px 7px;
    border-radius: 999px;
    font-size: .64rem;
    font-weight: 800;
  }

  .trend-current {
    border: 1px solid rgba(139,92,246,.25);
    background: rgba(139,92,246,.08);
    color: #c4b5fd;
  }

  .trend-hot {
    border: 1px solid rgba(251,146,60,.24);
    background: rgba(251,146,60,.08);
    color: #fdba74;
  }

  .trend-rising {
    border: 1px solid rgba(139,92,246,.22);
    background: rgba(139,92,246,.07);
    color: #c4b5fd;
  }

  .trend-seasonal,
  .trend-evergreen {
    border: 1px solid rgba(255,255,255,.06);
    background: rgba(255,255,255,.025);
    color: #9999a3;
  }

  .icon-btn {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 2;
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 10px;
    background: rgba(13,12,19,.82);
    color: #8f8f98;
    cursor: pointer;
    font: inherit;
    transition:
      background .2s ease,
      border-color .2s ease,
      color .2s ease,
      transform .2s ease;
  }

  .icon-btn:hover {
    border-color: rgba(139,92,246,.38);
    background: rgba(139,92,246,.08);
    color: #c4b5fd;
    transform: scale(1.04);
  }

  .icon-btn[aria-pressed="true"] {
    border-color: rgba(139,92,246,.38);
    background: rgba(139,92,246,.11);
    color: #c4b5fd;
  }

  .prompt-card-main {
    display: block;
    flex: 1;
    min-width: 0;
    margin-top: 12px;
    color: inherit;
    text-decoration: none;
  }

  .title-row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .prompt-card h3 {
    flex: 1;
    margin: 0 0 9px;
    color: #fff;
    font-size: 1.08rem;
    line-height: 1.38;
    letter-spacing: -.012em;
  }

  .open-arrow {
    margin-top: 2px;
    color: #71717a;
    font-size: .9rem;
    opacity: 0;
    transform: translate(-3px, 3px);
    transition:
      opacity .2s ease,
      transform .2s ease,
      color .2s ease;
  }

  .prompt-card:hover .open-arrow {
    opacity: 1;
    color: #a78bfa;
    transform: translate(0, 0);
  }

  .prompt-preview {
    margin: 0;
    color: var(--muted, #a1a1aa);
    font-size: .87rem;
    line-height: 1.68;
  }

  .tools-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .tools-label {
    color: #85858f;
    font-size: .65rem;
    font-weight: 800;
    letter-spacing: .04em;
  }

  .tool-list {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }

  .tool-badge {
    padding: 4px 7px;
    border: 1px solid rgba(139,92,246,.14);
    border-radius: 999px;
    background: rgba(139,92,246,.045);
    color: #b9b0d9;
    font-size: .64rem;
    font-weight: 650;
  }

  .reference-indicator {
    gap: 5px;
    margin-top: 10px;
    color: #aaa1c5;
    font-size: .68rem;
    font-weight: 700;
  }

  .reference-indicator span {
    color: #a78bfa;
    font-size: .6rem;
  }

  .best-for {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 14px;
    padding: 11px 12px;
    border: 1px solid rgba(139,92,246,.11);
    border-radius: 10px;
    background: rgba(139,92,246,.045);
  }

  .best-for span {
    color: #85858f;
    font-size: .65rem;
    font-weight: 850;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .best-for strong {
    color: #d2d2d8;
    font-size: .77rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .tag {
    padding: 5px 8px;
    border: 1px solid rgba(255,255,255,.065);
    border-radius: 999px;
    background: rgba(255,255,255,.022);
    color: #9999a3;
    font-size: .68rem;
    line-height: 1;
  }

  .card-actions {
    display: grid;
    grid-template-columns: 1fr 1fr auto;
    gap: 7px;
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(255,255,255,.055);
  }

  .small-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 34px;
    padding: 7px 10px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 9px;
    background: rgba(255,255,255,.022);
    color: #bdbdc6;
    font: inherit;
    font-size: .72rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background .2s ease,
      border-color .2s ease,
      color .2s ease,
      transform .2s ease;
  }

  .small-btn:hover {
    border-color: rgba(139,92,246,.34);
    background: rgba(139,92,246,.075);
    color: #fff;
    transform: translateY(-1px);
  }

  .open-btn {
    border-color: rgba(139,92,246,.22);
    color: #c4b5fd;
  }

  .category-link:focus-visible,
  .prompt-card-main:focus-visible,
  .small-btn:focus-visible,
  .icon-btn:focus-visible {
    outline: 2px solid #a78bfa;
    outline-offset: 3px;
    border-radius: 8px;
  }

  @media (max-width: 650px) {
    .prompt-card {
      padding: 18px;
    }

    .prompt-card-image-link {
      margin: -18px -18px 18px;
    }

    .prompt-meta {
      padding-right: 42px;
    }

    .icon-btn {
      top: 18px;
      right: 18px;
    }

    .card-actions {
      grid-template-columns: 1fr 1fr;
    }

    .open-btn {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 380px) {
    .prompt-card {
      padding: 16px;
    }

    .prompt-card-image-link {
      margin: -16px -16px 16px;
    }

    .icon-btn {
      top: 16px;
      right: 16px;
    }

    .card-actions {
      grid-template-columns: 1fr;
    }

    .open-btn {
      grid-column: auto;
    }

    .small-btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .prompt-card,
    .icon-btn,
    .small-btn,
    .open-arrow,
    .category-link::after,
    .prompt-card-image {
      transition: none;
    }

    .prompt-card:hover {
      transform: none;
    }
  }
</style>
